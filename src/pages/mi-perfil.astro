---
import DashboardLayout from '../frontend/layouts/DashboardLayout.astro'
import {
  User,
  CreditCard,
  FileCheck,
  AlertTriangle,
  AlertCircle,
  CheckCircle2,
  XCircle,
  Truck,
  Gauge,
  Droplet,
  Fuel
} from 'lucide-astro'
import { verifySessionToken, SESSION_COOKIE_NAME, getChoferesParaSelector } from '../backend/index'
import { getChoferPerfil, getChoferEstadisticas, getAlertasChofer } from '../backend/services/choferPerfilService'

const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value
const currentUser = Astro.locals.user || verifySessionToken(sessionToken)

if (!currentUser) {
  return Astro.redirect('/login')
}

// Selector administrativo si es Admin u Operador
const isStaff = currentUser.rolId === 1 || currentUser.rolId === 2
const choferIdQuery = Astro.url.searchParams.get('choferId')
const choferIdOverride = choferIdQuery ? parseInt(choferIdQuery, 10) : undefined

const choferPerfil = await getChoferPerfil(currentUser.id, choferIdOverride)
const estadisticas = await getChoferEstadisticas(choferPerfil.id)
const alertas = await getAlertasChofer(choferPerfil.id)
const listaChoferesSelector = isStaff ? await getChoferesParaSelector() : []

function getInitials(name: string) {
  if (!name) return 'CH'
  return name
    .split(' ')
    .filter(n => n.length > 0)
    .map((n) => n[0])
    .join('')
    .substring(0, 2)
    .toUpperCase()
}
---

<DashboardLayout title="Mi Perfil · SCVehiculos" activeNav="mi-perfil">
  <div slot="header-title">
    <h2 class="text-xl font-bold tracking-tight text-navy">Mi Perfil</h2>
  </div>

  <div class="mx-auto max-w-5xl space-y-6">
    <!-- Barra de Supervisión Administrativa (si es Staff) -->
    {isStaff && (
      <div class="rounded-2xl border border-orange-200 bg-orange-50/60 p-3 sm:p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2 text-orangeGov font-bold">
          <span>Modo Supervisor / Prueba:</span>
          <span class="text-ink font-normal">Estás visualizando el perfil y licencia del chofer seleccionado.</span>
        </div>
        <div class="w-full sm:w-auto">
          <select
            id="select-chofer-perfil-override"
            class="w-full rounded-xl border border-orange-300 bg-white px-3 py-1.5 text-xs font-semibold text-navy focus:outline-none focus:ring-2 focus:ring-orangeGov/20"
          >
            {listaChoferesSelector.map((ch) => (
              <option value={ch.id} selected={ch.id === choferPerfil.id}>
                {ch.nombreCompleto} (DNI {ch.dni})
              </option>
            ))}
          </select>
        </div>
      </div>
    )}

    <!-- Alertas -->
    {alertas.length > 0 && (
      <div class="space-y-3">
        {alertas.map(alerta => (
          <div class={`flex items-center gap-3 rounded-2xl p-4 ${alerta.severidad === 'danger' ? 'bg-red-50 text-red-900 ring-1 ring-red-200' : alerta.severidad === 'warning' ? 'bg-amber-50 text-amber-900 ring-1 ring-amber-200' : 'bg-blue-50 text-blue-900 ring-1 ring-blue-200'}`}>
            {alerta.icono === 'AlertTriangle' ? <AlertTriangle class="h-5 w-5" /> : <AlertCircle class="h-5 w-5" />}
            <span class="font-medium text-sm">{alerta.mensaje}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Encabezado Perfil -->
    <div class="flex items-center gap-6 rounded-3xl border border-line bg-white p-6 shadow-sm">
      <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-orangeGov text-2xl font-bold text-white shadow-sm">
        {getInitials(choferPerfil.nombreCompleto)}
      </div>
      <div>
        <h3 class="text-2xl font-bold text-navy">{choferPerfil.nombreCompleto}</h3>
        <p class="text-sm font-medium text-muted mt-1">DNI: {choferPerfil.dni}</p>
        <div class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800">
          <CheckCircle2 class="h-3.5 w-3.5" />
          {choferPerfil.estado}
        </div>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <!-- Card: Licencia de Conducir -->
      <div class="rounded-3xl border border-line bg-white p-5 shadow-sm">
        <div class="mb-4 flex items-center gap-2">
          <CreditCard class="h-5 w-5 text-orangeGov" />
          <h3 class="text-sm font-bold text-navy">Licencia de Conducir</h3>
        </div>
        
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Número</p>
              <p class="mt-1 font-bold text-navy">{choferPerfil.numeroLicencia || '-'}</p>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Categoría</p>
              <p class="mt-1 font-bold text-navy">{choferPerfil.categoriaLicencia || '-'}</p>
            </div>
          </div>
          
          <div>
            <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Vencimiento</p>
            <div class="mt-1 flex items-center gap-3">
              <span class="font-bold text-navy">
                {choferPerfil.fechaVencimientoLicencia ? (() => {
                  const [y, m, d] = choferPerfil.fechaVencimientoLicencia.split('-');
                  return `${d}/${m}/${y}`;
                })() : '-'}
              </span>
              
              {choferPerfil.diasParaVencimiento !== null && (
                <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${
                  !choferPerfil.licenciaVigente 
                    ? 'bg-red-100 text-red-800' 
                    : choferPerfil.diasParaVencimiento <= 30
                    ? 'bg-amber-100 text-amber-800'
                    : 'bg-emerald-100 text-emerald-800'
                }`}>
                  {!choferPerfil.licenciaVigente 
                    ? 'Vencida' 
                    : choferPerfil.diasParaVencimiento <= 30
                    ? `Vence en ${choferPerfil.diasParaVencimiento} días`
                    : 'Vigente'}
                </span>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Card: Documentación -->
      <div class="rounded-3xl border border-line bg-white p-5 shadow-sm">
        <div class="mb-4 flex items-center gap-2">
          <FileCheck class="h-5 w-5 text-orangeGov" />
          <h3 class="text-sm font-bold text-navy">Documentación Adjunta</h3>
        </div>

        <div class="space-y-3">
          <div class="flex items-center justify-between rounded-xl bg-paper/50 p-3">
            <span class="text-xs font-semibold text-navy">DNI (Frente)</span>
            {choferPerfil.tieneFotoDniFrente ? <CheckCircle2 class="h-5 w-5 text-emerald-500" /> : <XCircle class="h-5 w-5 text-red-500" />}
          </div>
          <div class="flex items-center justify-between rounded-xl bg-paper/50 p-3">
            <span class="text-xs font-semibold text-navy">DNI (Dorso)</span>
            {choferPerfil.tieneFotoDniDorso ? <CheckCircle2 class="h-5 w-5 text-emerald-500" /> : <XCircle class="h-5 w-5 text-red-500" />}
          </div>
          <div class="flex items-center justify-between rounded-xl bg-paper/50 p-3">
            <span class="text-xs font-semibold text-navy">Licencia (Frente)</span>
            {choferPerfil.tieneFotoLicenciaFrente ? <CheckCircle2 class="h-5 w-5 text-emerald-500" /> : <XCircle class="h-5 w-5 text-red-500" />}
          </div>
          <div class="flex items-center justify-between rounded-xl bg-paper/50 p-3">
            <span class="text-xs font-semibold text-navy">Licencia (Dorso)</span>
            {choferPerfil.tieneFotoLicenciaDorso ? <CheckCircle2 class="h-5 w-5 text-emerald-500" /> : <XCircle class="h-5 w-5 text-red-500" />}
          </div>
        </div>
      </div>
    </div>

    <!-- Card: Estadísticas -->
    <div class="rounded-3xl border border-line bg-white p-5 shadow-sm">
      <div class="mb-4 flex items-center gap-2">
        <Gauge class="h-5 w-5 text-orangeGov" />
        <h3 class="text-sm font-bold text-navy">Estadísticas Personales</h3>
      </div>
      
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-2xl bg-paper/50 p-4">
          <Truck class="mb-2 h-6 w-6 text-muted" />
          <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Viajes</p>
          <p class="mt-1 text-2xl font-bold text-navy">{estadisticas.totalViajes}</p>
        </div>
        <div class="rounded-2xl bg-paper/50 p-4">
          <Gauge class="mb-2 h-6 w-6 text-muted" />
          <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Kilómetros</p>
          <p class="mt-1 text-2xl font-bold text-navy">{estadisticas.totalKmRecorridos.toLocaleString('es-AR')}</p>
        </div>
        <div class="rounded-2xl bg-paper/50 p-4">
          <Fuel class="mb-2 h-6 w-6 text-muted" />
          <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Cargas</p>
          <p class="mt-1 text-2xl font-bold text-navy">{estadisticas.totalCargasCombustible}</p>
        </div>
        <div class="rounded-2xl bg-paper/50 p-4">
          <Droplet class="mb-2 h-6 w-6 text-muted" />
          <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Litros</p>
          <p class="mt-1 text-2xl font-bold text-navy">{estadisticas.totalLitrosCargados.toLocaleString('es-AR')}</p>
        </div>
      </div>
    </div>

  </div>

  <script>
    const sel = document.getElementById('select-chofer-perfil-override') as HTMLSelectElement | null
    sel?.addEventListener('change', () => {
      const val = sel.value
      if (val) {
        window.location.href = `/mi-perfil?choferId=${val}`
      } else {
        window.location.href = `/mi-perfil`
      }
    })
  </script>
</DashboardLayout>
