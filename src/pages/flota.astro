---
import { Download, Plus } from 'lucide-astro'
import DashboardLayout from '../frontend/layouts/DashboardLayout.astro'
import VehicleKpiCards from '../frontend/components/flota/VehicleKpiCards.astro'
import VehicleFilters from '../frontend/components/flota/VehicleFilters.astro'
import VehicleCardGrid from '../frontend/components/flota/VehicleCardGrid.astro'
import VehicleTable from '../frontend/components/flota/VehicleTable.astro'
import VehicleDetailModal from '../frontend/components/flota/VehicleDetailModal.astro'
import VehicleFormModal from '../frontend/components/flota/VehicleFormModal.astro'
import { getVehiclesFullList, getVehicleTypes, getDependenciasList, getDashboardStats } from '../backend/index'

// Carga de datos en servidor a través de la capa de Backend
const [vehicles, types, dependencias, stats] = await Promise.all([
  getVehiclesFullList(),
  getVehicleTypes(),
  getDependenciasList(),
  getDashboardStats(),
])

// Cálculo de alertas RTO
const rtoAlertsCount = vehicles.filter((v) => v.vtvStatus === 'proxima' || v.vtvStatus === 'vencida').length

// Cálculo de métricas Formulario 08
const total08Count = vehicles.filter((v) => v.tiene08).length
const alerts08Count = vehicles.filter(
  (v) => v.tiene08 && (v.estado08Semaforo === 'proximo' || v.estado08Semaforo === 'vencido')
).length
---

<DashboardLayout activeNav="flota" title="Vehículos y Flota · Movilidades · Ministerio de Educación">
  <h1 slot="header-title" class="font-display text-xl font-bold text-navy sm:text-2xl">Vehículos y Flota Oficial</h1>

  <!-- Encabezado de sección -->
  <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-blue mb-1">
        <span>Ministerio de Educación</span>
        <span>·</span>
        <span>Parque Automotor</span>
      </div>
      <h2 class="font-display text-[26px] font-bold tracking-tight text-navy">Gestión de Unidades</h2>
      <p class="mt-0.5 text-xs text-muted">Control de patentes, titularidad, Formulario 08, RTO e historial operativo.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <a
        href="/api/reportes/flota"
        class="flex items-center gap-2 rounded-xl border border-line bg-white hover:bg-paper px-3.5 py-2.5 text-xs font-bold text-navy shadow-xs transition"
        title="Descargar planilla oficial en Excel (CSV UTF-8)"
      >
        <Download size={15} />
        <span>Exportar Excel</span>
      </a>
      <button
        id="btn-open-create-modal"
        class="flex items-center gap-2 rounded-lg bg-blue px-4 py-2.5 text-xs font-bold text-white shadow-sm shadow-blue/20 hover:opacity-90 transition cursor-pointer"
      >
        <Plus size={16} strokeWidth={2.5} />
        <span>Registrar nueva unidad</span>
      </button>
    </div>
  </div>

  <!-- Tarjetas KPI del Parque Automotor (Componente de Frontend) -->
  <VehicleKpiCards stats={stats} rtoAlertsCount={rtoAlertsCount} total08Count={total08Count} alerts08Count={alerts08Count} />

  <!-- Buscador, Filtros desplegables y Conmutador Cards/Tabla -->
  <VehicleFilters types={types} dependencias={dependencias} />

  <!-- Encabezado de Resultados -->
  <div class="flex items-center justify-between mb-4 px-1">
    <p class="text-xs text-muted">
      Mostrando <span id="visible-count" class="font-bold text-navy">{vehicles.length}</span> de {vehicles.length} unidades registradas
    </p>
  </div>

  <!-- VISTA 1: GRID DE TARJETAS (CARDS) DE VEHÍCULOS (DEFAULT) -->
  <VehicleCardGrid vehicles={vehicles} />

  <!-- VISTA 2: TABLA PRINCIPAL DE LA FLOTA (CONMUTABLE) -->
  <VehicleTable vehicles={vehicles} />

  <!-- Mensaje cuando no hay resultados en los filtros -->
  <div id="no-results" class="hidden card p-10 text-center my-6">
    <p class="font-display text-base font-bold text-navy">No se encontraron vehículos con los filtros aplicados</p>
    <p class="text-xs text-muted mt-1">Prueba modificando los criterios de búsqueda o limpiando los filtros.</p>
  </div>

  <!-- Modales integrados en el slot específico del body -->
  <Fragment slot="modals">
    <VehicleDetailModal />
    <VehicleFormModal types={types} dependencias={dependencias} />
  </Fragment>
</DashboardLayout>

<script>
  import '../frontend/scripts/flotaController'
</script>
