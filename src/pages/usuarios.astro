---
import { Plus, ShieldCheck } from 'lucide-astro'
import DashboardLayout from '../frontend/layouts/DashboardLayout.astro'
import UserKpiCards from '../frontend/components/usuarios/UserKpiCards.astro'
import UserTable from '../frontend/components/usuarios/UserTable.astro'
import UserFormModal from '../frontend/components/usuarios/UserFormModal.astro'
import {
  getUsuariosList,
  getUserStats,
  getRolesList,
  getDependenciasList,
  getChoferesParaVinculacion,
  verifySessionToken,
  SESSION_COOKIE_NAME,
} from '../backend/index'

// Control de acceso en servidor: solo Administrador (rol_id 1)
const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value
const currentUser = verifySessionToken(sessionToken)

if (!currentUser) {
  return Astro.redirect('/login')
}

if (currentUser.rolId !== 1) {
  return Astro.redirect('/')
}

// Carga de datos
const [usuarios, stats, roles, dependencias, choferes] = await Promise.all([
  getUsuariosList(),
  getUserStats(),
  getRolesList(),
  getDependenciasList(),
  getChoferesParaVinculacion(),
])
---

<DashboardLayout activeNav="usuarios" title="Gestión de Usuarios · Movilidades · Ministerio de Educación">
  <h1 slot="header-title" class="font-display text-xl font-bold text-navy sm:text-2xl">
    Usuarios y Roles
  </h1>

  <!-- Encabezado de sección -->
  <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-blue mb-1">
        <ShieldCheck size={14} />
        <span>Administración Central</span>
        <span>·</span>
        <span>Control de Accesos</span>
      </div>
      <h2 class="font-display text-[26px] font-bold tracking-tight text-navy">Cuentas de Usuarios</h2>
      <p class="mt-0.5 text-xs text-muted">Alta, asignación de roles y control de permisos para los operadores del sistema.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <button
        id="btn-open-create-user"
        class="flex items-center gap-2 rounded-lg bg-blue px-4 py-2.5 text-xs font-bold text-white shadow-sm shadow-blue/20 hover:opacity-90 transition cursor-pointer"
      >
        <Plus size={16} strokeWidth={2.5} />
        <span>Registrar nuevo usuario</span>
      </button>
    </div>
  </div>

  <!-- Tarjetas KPI -->
  <UserKpiCards stats={stats} />

  <!-- Tabla de Usuarios -->
  <UserTable usuarios={usuarios} />

  <!-- Modal para Crear Usuario -->
  <Fragment slot="modals">
    <UserFormModal roles={roles} dependencias={dependencias} choferes={choferes} />
  </Fragment>
</DashboardLayout>

<!-- Script interactivo -->
<script>
  import '../frontend/scripts/userController'
</script>
