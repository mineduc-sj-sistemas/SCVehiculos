---
import { AlertCircle, AlertTriangle, ArrowRight, Calendar, Camera, Check, CheckCircle2, ChevronRight, Clock, Compass, FileText, Fuel, Gauge, MapPin, Navigation, Phone, Play, Receipt, ShieldAlert, Sparkles, StopCircle, Truck, User, Users } from 'lucide-astro'
import DashboardLayout from '../frontend/layouts/DashboardLayout.astro'
import PlateBadge from '../frontend/components/ui/PlateBadge.astro'
import StatusBadge from '../frontend/components/ui/StatusBadge.astro'
import {
  getMiViajeActivo,
  getChoferesParaSelector,
  getAlertasChofer,
  verifySessionToken,
  SESSION_COOKIE_NAME,
} from '../backend/index'

// Identificación del usuario activo
const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value
const currentUser = Astro.locals.user || verifySessionToken(sessionToken) || {
  id: 1,
  nombre: 'María',
  apellido: 'Gutiérrez',
  rolNombre: 'Administrador',
  rolId: 1,
}

// Selector administrativo de chofer si es Admin (1) u Operador (2)
const isStaff = currentUser.rolId === 1 || currentUser.rolId === 2
const choferIdQuery = Astro.url.searchParams.get('choferId')
const choferIdOverride = choferIdQuery ? parseInt(choferIdQuery, 10) : undefined

const { success, chofer, viajeActivo, paradas = [], checkins = [], historial = [] } = await getMiViajeActivo(currentUser.id, choferIdOverride)
const listaChoferesSelector = isStaff ? await getChoferesParaSelector() : []
const alertasChofer = chofer ? await getAlertasChofer(chofer.id) : []

// Formateador de fechas
const formatHora = (dStr: string | null) => {
  if (!dStr) return '--:--'
  const d = new Date(dStr)
  return d.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })
}

const formatFechaCorta = (dStr: string | null) => {
  if (!dStr) return ''
  const d = new Date(dStr)
  return d.toLocaleDateString('es-AR', { day: '2-digit', month: 'short' })
}

const formatFechaLarga = (d: Date | null) => {
  if (!d) return '--'
  return d.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' })
}

// Validación de Coincidencia de Horario con Hora Actual
const ahora = new Date()
const fechaSalida = viajeActivo ? new Date(viajeActivo.fecha_salida_programada) : null
const fechaRegreso = viajeActivo ? new Date(viajeActivo.fecha_regreso_estimada) : null

const esHorarioValido = Boolean(
  fechaSalida &&
  fechaRegreso &&
  ahora >= fechaSalida &&
  ahora <= fechaRegreso
)

const esHorarioPrevio = Boolean(fechaSalida && ahora < fechaSalida)
const esHorarioVencido = Boolean(fechaRegreso && ahora > fechaRegreso)
---

<DashboardLayout activeNav="mi-viaje" title="Mi Viaje Oficial · Portal del Conductor · Ministerio de Educación">
  <div
    id="portal-mi-viaje"
    class="mx-auto max-w-3xl space-y-5 pb-12 animate-in fade-in"
    data-comision-id={viajeActivo?.id || ''}
    data-chofer-id={chofer?.id || ''}
    data-vehiculo-id={viajeActivo?.vehiculo_id || ''}
    data-odometro-salida={viajeActivo?.odometro_salida || viajeActivo?.vehiculo_odometro || '0'}
    data-fecha-salida={viajeActivo?.fecha_salida_programada || ''}
    data-fecha-regreso={viajeActivo?.fecha_regreso_estimada || ''}
    data-es-horario-valido={esHorarioValido ? 'true' : 'false'}
  >
    <!-- Encabezado de Identificación del Conductor -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-b border-line/70 pb-4">
      <div class="flex items-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orangeGov text-white shadow-md shadow-orange-500/20 font-bold text-lg">
          {chofer ? `${chofer.nombre.charAt(0)}${chofer.apellido.charAt(0)}` : 'CH'}
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg font-bold text-navy">
              {chofer ? `${chofer.nombre} ${chofer.apellido}` : currentUser.nombre}
            </h1>
            <span class="rounded-md bg-orange-100 px-2 py-0.5 text-[10px] font-bold text-orange-800 uppercase">
              Conductor Oficial
            </span>
          </div>
          <p class="text-xs text-muted flex items-center gap-2">
            <span>DNI: {chofer?.dni || 'S/D'}</span>
            <span>·</span>
            <span>Licencia: {chofer?.numero_licencia || 'S/D'} ({chofer?.categoria_licencia || 'Cat. B'})</span>
          </p>
        </div>
      </div>

      <!-- Badge de Estado GPS del Smartphone -->
      <div class="flex items-center gap-2">
        <span
          id="gps-status-badge"
          class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-[11px] font-bold text-gray-600 transition"
        >
          <span class="inline-block w-2 h-2 rounded-full bg-gray-400 mr-1.5"></span>
          GPS Inactivo
        </span>
      </div>
    </div>

    <!-- Barra de Supervisión Administrativa (si es Staff) -->
    {isStaff && (
      <div class="rounded-2xl border border-orange-200 bg-orange-50/60 p-3 sm:p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-orangeGov font-bold">
            <Compass size={16} />
            <span>Modo Supervisor / Auditoría:</span>
            <span class="text-ink font-normal">Estás visualizando la pantalla operativa del chofer.</span>
          </div>
          <label class="flex items-center gap-1.5 text-[11px] font-semibold text-orange-950 cursor-pointer pt-0.5">
            <input type="checkbox" id="check-simular-horario" class="rounded border-orange-300 text-orangeGov focus:ring-orangeGov/30" />
            <span>Simular coincidencia de horario para pruebas administrativas</span>
          </label>
        </div>
        <div class="w-full sm:w-auto">
          <select
            id="select-chofer-override"
            class="w-full rounded-xl border border-orange-300 bg-white px-3 py-1.5 text-xs font-semibold text-navy focus:outline-none focus:ring-2 focus:ring-orangeGov/20"
          >
            {listaChoferesSelector.map((ch) => (
              <option value={ch.id} selected={ch.id === chofer?.id}>
                {ch.nombreCompleto} (DNI {ch.dni})
              </option>
            ))}
          </select>
        </div>
      </div>
    )}

    {/* Alertas personales del Chofer */}
    {alertasChofer.length > 0 && (
      <div class="space-y-2">
        {alertasChofer.map((al) => (
          <div class={`rounded-2xl border p-3.5 flex items-center justify-between gap-3 text-xs ${
            al.severidad === 'danger'
              ? 'border-rose-200 bg-rose-50 text-rose-800'
              : al.severidad === 'warning'
              ? 'border-amber-200 bg-amber-50 text-amber-800'
              : 'border-blue-200 bg-blue-50 text-blue-800'
          }`}>
            <div class="flex items-center gap-2.5">
              <AlertTriangle size={18} class="shrink-0 text-amber-600" />
              <p class="font-bold">{al.mensaje}</p>
            </div>
            <a
              href="/mi-perfil"
              class="shrink-0 rounded-xl bg-white/90 px-3 py-1.5 text-[11px] font-bold shadow-2xs hover:bg-white transition"
            >
              Ver Mi Perfil
            </a>
          </div>
        ))}
      </div>
    )}

    {viajeActivo ? (
      <div class="space-y-4">
        {/* Banner de Validación de Horario Oficial */}
        <div
          id="banner-horario-viaje"
          class={`card rounded-2xl p-4 flex items-start gap-3 border transition-all ${
            esHorarioValido
              ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
              : esHorarioPrevio
              ? 'bg-amber-50 border-amber-200 text-amber-900'
              : 'bg-rose-50 border-rose-200 text-rose-900'
          }`}
        >
          <div class="mt-0.5 shrink-0" id="banner-horario-icon">
            {esHorarioValido ? (
              <CheckCircle2 size={18} class="text-emerald-600" />
            ) : esHorarioPrevio ? (
              <Clock size={18} class="text-amber-600" />
            ) : (
              <ShieldAlert size={18} class="text-rose-600" />
            )}
          </div>
          <div class="space-y-1 text-xs flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="font-bold uppercase tracking-wider text-[11px]" id="banner-horario-titulo">
                  {esHorarioValido
                    ? 'Horario de Viaje Coincidente'
                    : esHorarioPrevio
                    ? 'Comisión Programada (Aún no iniciada)'
                    : 'Fuera del Horario Oficial'}
                </span>
                <span
                  id="banner-horario-badge"
                  class={`rounded-full px-2 py-0.5 text-[10px] font-bold ${
                    esHorarioValido
                      ? 'bg-emerald-200 text-emerald-900'
                      : esHorarioPrevio
                      ? 'bg-amber-200 text-amber-900'
                      : 'bg-rose-200 text-rose-900'
                  }`}
                >
                  {esHorarioValido ? 'Interacción Habilitada' : 'Interacción Bloqueada'}
                </span>
              </div>
              <span class="font-mono text-[10px] opacity-80" id="reloj-tiempo-real">
                Hora actual: {ahora.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })} hs
              </span>
            </div>
            <p class="text-[12px] leading-relaxed" id="banner-horario-mensaje">
              {esHorarioValido
                ? 'El horario actual coincide con la franja oficial de la comisión. Puedes registrar arribos, combustible y despacho en tiempo real.'
                : esHorarioPrevio
                ? `Esta comisión está programada para iniciar el ${formatFechaLarga(fechaSalida)} a las ${formatHora(viajeActivo.fecha_salida_programada)} hs. Las acciones operativas se habilitarán automáticamente cuando llegue el horario del viaje.`
                : `El horario oficial para este viaje finalizó el ${formatFechaLarga(fechaRegreso)} a las ${formatHora(viajeActivo.fecha_regreso_estimada)} hs. Solo se permite interactuar cuando el horario del viaje coincida con el horario actual.`
              }
            </p>
          </div>
        </div>

        {/* Banner de Estado de la Comisión */}
        <div class="card overflow-hidden rounded-3xl border border-line bg-white shadow-sm">
          {/* Cabecera de Estado */}
          <div class={`p-4 sm:p-5 flex items-center justify-between ${viajeActivo.estado === 'en_curso' ? 'bg-amber-500 text-white' : 'bg-navy text-white'}`}>
            <div class="flex items-center gap-2.5">
              <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/20 backdrop-blur-xs">
                {viajeActivo.estado === 'en_curso' ? <Navigation size={18} class="animate-pulse" /> : <Clock size={18} />}
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider opacity-90">
                  {viajeActivo.estado === 'en_curso' ? 'Comisión En Ruta' : 'Comisión Programada'}
                </span>
                <p class="font-mono text-sm font-black">{viajeActivo.codigo_comision}</p>
              </div>
            </div>

            {/* Botón Hoja de Ruta Imprimible */}
            <a
              href={`/cronograma/imprimir/${viajeActivo.id}`}
              target="_blank"
              class="flex items-center gap-1.5 rounded-xl bg-white/20 hover:bg-white/30 px-3 py-1.5 text-[11px] font-bold text-white transition cursor-pointer"
            >
              <FileText size={14} />
              <span class="hidden sm:inline">Ver Hoja de Ruta</span>
            </a>
          </div>

          {/* Información del Móvil Asignado */}
          <div class="p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-line/60 pb-3">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-muted">Vehículo Asignado</span>
                <p class="text-sm font-bold text-navy">{viajeActivo.vehiculo_marca} {viajeActivo.vehiculo_modelo}</p>
              </div>
              <PlateBadge plate={viajeActivo.vehiculo_patente} size="md" />
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs sm:grid-cols-4">
              <div class="rounded-xl bg-paper p-2.5">
                <span class="text-[10px] font-bold text-muted uppercase">Combustible</span>
                <p class="font-bold text-navy capitalize mt-0.5">{viajeActivo.vehiculo_combustible?.replace('_', ' ')}</p>
              </div>
              <div class="rounded-xl bg-paper p-2.5">
                <span class="text-[10px] font-bold text-muted uppercase">Odómetro Actual</span>
                <p class="font-mono font-bold text-navy mt-0.5">{Number(viajeActivo.vehiculo_odometro).toLocaleString()} km</p>
              </div>
              <div class="rounded-xl bg-paper p-2.5">
                <span class="text-[10px] font-bold text-muted uppercase">Salida Prog.</span>
                <p class="font-bold text-navy mt-0.5">{formatFechaCorta(viajeActivo.fecha_salida_programada)} {formatHora(viajeActivo.fecha_salida_programada)} hs</p>
              </div>
              <div class="rounded-xl bg-paper p-2.5">
                <span class="text-[10px] font-bold text-muted uppercase">Regreso Estim.</span>
                <p class="font-bold text-navy mt-0.5">{formatFechaCorta(viajeActivo.fecha_regreso_estimada)} {formatHora(viajeActivo.fecha_regreso_estimada)} hs</p>
              </div>
            </div>

            {/* Detalles del Viaje y Pasajeros */}
            <div class="rounded-2xl border border-line bg-paper/50 p-3.5 space-y-2 text-xs">
              <div class="flex items-start gap-2">
                <User size={15} class="shrink-0 text-muted mt-0.5" />
                <div>
                  <span class="text-muted">Área Solicitante:</span>{' '}
                  <span class="font-bold text-navy">{viajeActivo.dependencia_nombre}</span>
                  {viajeActivo.solicitante_nombre && (
                    <span class="text-muted"> ({viajeActivo.solicitante_nombre})</span>
                  )}
                </div>
              </div>
              <div class="flex items-start gap-2">
                <Users size={15} class="shrink-0 text-muted mt-0.5" />
                <div>
                  <span class="text-muted">Pasajeros:</span>{' '}
                  <span class="font-bold text-navy">{viajeActivo.cantidad_pasajeros} persona(s)</span>
                  <span class="text-muted"> (Capacidad móvil: {viajeActivo.vehiculo_capacidad})</span>
                </div>
              </div>
              <div class="flex items-start gap-2">
                <FileText size={15} class="shrink-0 text-muted mt-0.5" />
                <div>
                  <span class="text-muted">Misión Oficial:</span>{' '}
                  <span class="font-medium text-navy">{viajeActivo.motivo}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* SECCIÓN: ITINERARIO Y CHECK-IN DE PARADAS CON GPS */}
        <div class="card rounded-3xl border border-line bg-white p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-line/60 pb-3">
            <div class="flex items-center gap-2">
              <MapPin class="text-orangeGov" size={18} />
              <h2 class="text-sm font-bold text-navy">Itinerario y Registro de Arribos</h2>
            </div>
            <span class="text-[11px] font-bold text-muted">
              {checkins.length} de {paradas.length} arribos registrados
            </span>
          </div>

          {/* Origen */}
          <div class="flex items-center gap-3 pl-2">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-navy font-bold text-xs">
              S
            </span>
            <div class="text-xs">
              <span class="text-[10px] font-bold uppercase tracking-wider text-muted">Punto de Salida</span>
              <p class="font-bold text-navy">{viajeActivo.origen || 'Ministerio de Educación - Centro Cívico'}</p>
            </div>
          </div>

          {/* Línea de tiempo de paradas / destinos */}
          <div class="space-y-3 relative pl-5 before:absolute before:left-5 before:top-2 before:bottom-2 before:w-0.5 before:bg-line">
            {paradas.map((parada) => (
              <div class="relative pl-6">
                {/* Círculo indicador */}
                <span class={`absolute left-0 top-1.5 flex h-4 w-4 -translate-x-1/2 items-center justify-center rounded-full border-2 bg-white ${parada.visitada ? 'border-emerald-500 text-emerald-500' : 'border-orangeGov text-orangeGov'}`}>
                  {parada.visitada ? <Check size={10} strokeWidth={3} /> : <span class="h-1.5 w-1.5 rounded-full bg-orangeGov"></span>}
                </span>

                <div class={`rounded-2xl border p-3.5 transition ${parada.visitada ? 'border-emerald-200 bg-emerald-50/50' : 'border-line bg-white hover:border-orange-300'}`}>
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="rounded bg-orange-100 px-1.5 py-0.5 text-[10px] font-bold text-orange-800">
                          Parada #{parada.index}
                        </span>
                        <h3 class="text-xs font-bold text-navy">{parada.nombre}</h3>
                      </div>

                      {parada.visitada && parada.checkin && (
                        <div class="mt-1 flex flex-wrap items-center gap-2 text-[11px] font-semibold text-emerald-800">
                          <span class="flex items-center gap-1">
                            <CheckCircle2 size={13} class="text-emerald-600" />
                            Arribo confirmado: {formatHora(parada.checkin.fechaHora)} hs
                          </span>
                          {parada.checkin.latitud && (
                            <span class="rounded bg-emerald-100/80 px-2 py-0.5 font-mono text-[10px] text-emerald-900">
                              GPS: {parada.checkin.latitud}, {parada.checkin.longitud}
                            </span>
                          )}
                        </div>
                      )}
                    </div>

                    {/* Botón de Check-in en Tiempo Real */}
                    {!parada.visitada && viajeActivo.estado === 'en_curso' && (
                      <button
                        type="button"
                        class={`btn-marcar-checkin flex items-center justify-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold transition shadow-xs shrink-0 ${
                          esHorarioValido
                            ? 'bg-orangeGov hover:bg-orange-700 text-white active:scale-95 cursor-pointer'
                            : 'bg-gray-200 text-gray-500 cursor-not-allowed opacity-60'
                        }`}
                        data-parada-index={parada.index}
                        data-destino-nombre={parada.nombre}
                        disabled={!esHorarioValido}
                        title={esHorarioValido ? 'Confirmar llegada con GPS' : 'Solo se permite interactuar cuando el horario del viaje coincida con el horario actual'}
                      >
                        {esHorarioValido ? <MapPin size={14} /> : <Clock size={14} />}
                        <span>{esHorarioValido ? 'Confirmar Llegada' : 'Confirmar Llegada (Bloqueado)'}</span>
                      </button>
                    )}

                    {!parada.visitada && viajeActivo.estado === 'programada' && (
                      <span class="text-[11px] font-semibold text-muted italic">
                        Pendiente de inicio
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* ACCIONES RÁPIDAS TÁCTILES DEL CHOFER */}
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {viajeActivo.estado === 'programada' ? (
            <button
              type="button"
              id="btn-abrir-modal-salida"
              disabled={!esHorarioValido}
              class={`col-span-full flex items-center justify-center gap-2 rounded-2xl py-4 px-6 text-sm font-bold transition ${
                esHorarioValido
                  ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg shadow-emerald-600/25 active:scale-[0.99] cursor-pointer'
                  : 'bg-gray-200 text-gray-500 cursor-not-allowed opacity-60'
              }`}
              title={esHorarioValido ? 'Iniciar Viaje Oficial' : 'Habilitado únicamente cuando el horario del viaje coincida con el horario actual'}
            >
              {esHorarioValido ? <Play size={18} fill="currentColor" /> : <Clock size={18} />}
              <span>{esHorarioValido ? 'Iniciar Viaje / Registrar Salida Oficial' : 'Iniciar Viaje (Fuera de horario)'}</span>
            </button>
          ) : (
            <>
              {/* Botón Carga de Combustible */}
              <button
                type="button"
                id="btn-abrir-modal-fuel"
                disabled={!esHorarioValido}
                class={`flex items-center justify-center gap-2 rounded-2xl border py-3.5 px-4 text-xs font-bold transition ${
                  esHorarioValido
                    ? 'border-line bg-white hover:bg-paper text-navy shadow-xs cursor-pointer'
                    : 'border-gray-200 bg-gray-100 text-gray-400 cursor-not-allowed opacity-60'
                }`}
                title={esHorarioValido ? 'Registrar Carga de Combustible' : 'Habilitado únicamente en el horario del viaje'}
              >
                <Fuel size={16} class={esHorarioValido ? 'text-orangeGov' : 'text-gray-400'} />
                <span>Registrar Carga de Combustible</span>
              </button>

              {/* Botón Finalizar Viaje */}
              <button
                type="button"
                id="btn-abrir-modal-llegada"
                disabled={!esHorarioValido}
                class={`flex items-center justify-center gap-2 rounded-2xl py-3.5 px-4 text-xs font-bold transition ${
                  esHorarioValido
                    ? 'bg-navy hover:bg-slate-900 text-white shadow-md active:scale-[0.99] cursor-pointer'
                    : 'bg-gray-200 text-gray-400 cursor-not-allowed opacity-60'
                }`}
                title={esHorarioValido ? 'Finalizar Viaje y Registrar Odómetro' : 'Habilitado únicamente en el horario del viaje'}
              >
                <StopCircle size={16} class={esHorarioValido ? 'text-orangeGov' : 'text-gray-400'} />
                <span>Finalizar Viaje / Registrar Regreso</span>
              </button>
            </>
          )}
        </div>
      </div>
    ) : (
      <div class="card rounded-3xl border border-line bg-white p-8 sm:p-12 text-center shadow-sm space-y-4">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-3xl bg-orange-100 text-orangeGov">
          <Truck size={32} />
        </div>
        <div class="max-w-md mx-auto">
          <h2 class="text-base font-bold text-navy sm:text-lg">No tienes comisiones oficiales activas</h2>
          <p class="mt-1 text-xs text-muted">
            Cuando la oficina de Despacho y Movilidades te asigne una nueva comisión, aparecerá aquí automáticamente con el móvil, itinerario y controles de check-in.
          </p>
        </div>
        <div class="pt-2">
          <a
            href="/viajes"
            class="inline-flex items-center gap-2 rounded-xl border border-line bg-paper px-4 py-2.5 text-xs font-bold text-navy hover:bg-white transition"
          >
            <span>Ver historial de viajes anteriores</span>
            <ChevronRight size={14} />
          </a>
        </div>
      </div>
    )}

    <!-- HISTORIAL RECIENTE DE COMISIONES DEL CHOFER -->
    {historial.length > 0 && (
      <div class="card rounded-3xl border border-line bg-white p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between border-b border-line/60 pb-3">
          <h3 class="text-xs font-bold text-navy uppercase tracking-wider">Tus últimos viajes finalizados</h3>
          <span class="text-[11px] text-muted">{historial.length} registros</span>
        </div>

        <div class="divide-y divide-line/60">
          {historial.map((h) => (
            <div class="py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-mono font-bold text-navy">{h.codigo_comision}</span>
                  <span class="rounded bg-gray-100 px-1.5 py-0.5 text-[10px] font-semibold text-gray-700">
                    {h.vehiculo_patente} ({h.vehiculo_modelo})
                  </span>
                </div>
                <p class="text-muted text-[11px] mt-0.5 truncate max-w-md">{h.destino}</p>
              </div>

              <div class="flex items-center gap-3 text-right">
                <span class="text-[11px] font-semibold text-muted">
                  {formatFechaCorta(h.fecha_salida_programada)}
                </span>
                <a
                  href={`/cronograma/imprimir/${h.id}`}
                  target="_blank"
                  class="rounded-lg border border-line bg-paper px-2.5 py-1 text-[11px] font-bold text-navy hover:bg-white transition"
                >
                  Hoja de Ruta
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- ========================================================================= -->
    <!-- MODAL 1: CONFIRMAR SALIDA (DESPACHO DEL CHOFER) -->
    <!-- ========================================================================= -->
    <div id="modal-salida-chofer" class="fixed inset-0 z-50 flex items-center justify-center bg-navy/60 backdrop-blur-xs p-3 sm:p-4 hidden">
      <div class="w-full max-w-sm rounded-3xl bg-white p-5 sm:p-6 shadow-2xl space-y-4 border border-line animate-in zoom-in-95 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-navy">Iniciar Salida de Comisión</h3>
          <button type="button" id="btn-close-modal-salida" class="text-muted hover:text-navy text-lg p-1 cursor-pointer">✕</button>
        </div>

        <p class="text-xs text-muted">
          Verifica el kilometraje en el tablero de la unidad antes de emprender viaje hacia el primer destino.
        </p>

        <!-- Scanner IA para Salida (Optimizado para móvil) -->
        <div class="rounded-2xl border border-dashed border-orangeGov/40 bg-orange-50/60 p-3 space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-orangeGov flex items-center gap-1.5">
              <Camera size={15} />
              Escanear Tablero con IA
            </span>
            <span class="text-[10px] font-semibold text-muted">Gemini Flash</span>
          </div>
          <label class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-orangeGov hover:bg-orange-700 text-white font-bold text-xs shadow-md shadow-orange-500/20 active:scale-98 transition cursor-pointer">
            <Camera size={16} />
            <span>Sacar Foto con la Cámara</span>
            <input type="file" accept="image/*" capture="environment" id="scan-odo-salida" class="hidden" />
          </label>
          <div id="status-odo-salida" class="hidden text-xs font-medium p-2.5 rounded-xl"></div>
        </div>

        <form id="form-confirmar-salida-chofer" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-navy mb-1">
              Odómetro en Tablero (Km) *
            </label>
            <div class="relative">
              <Gauge size={18} class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" />
              <input
                type="number"
                inputmode="numeric"
                pattern="[0-9]*"
                id="input-odo-salida-chofer"
                required
                min={viajeActivo?.vehiculo_odometro || 0}
                value={viajeActivo?.vehiculo_odometro || 0}
                class="w-full rounded-2xl border border-line bg-paper pl-11 pr-3.5 py-3 text-base sm:text-xs font-bold font-mono text-navy focus:border-orangeGov focus:outline-none"
              />
            </div>
            <p class="mt-1 text-[10px] text-muted">
              Último odómetro registrado: {viajeActivo?.vehiculo_odometro || 0} km
            </p>
          </div>

          <button
            type="submit"
            id="btn-submit-salida-chofer"
            class="w-full rounded-xl bg-emerald-600 hover:bg-emerald-700 py-3 text-xs font-bold text-white shadow-md transition cursor-pointer"
          >
            Confirmar Salida e Iniciar Viaje
          </button>
        </form>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL 2: CARGA RÁPIDA DE COMBUSTIBLE -->
    <!-- ========================================================================= -->
    <div id="modal-fuel-chofer" class="fixed inset-0 z-50 flex items-center justify-center bg-navy/60 backdrop-blur-xs p-4 hidden">
      <div class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl space-y-4 border border-line animate-in zoom-in-95">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-orangeGov">
            <Fuel size={18} />
            <h3 class="text-sm font-bold text-navy">Cargar Combustible</h3>
          </div>
          <button type="button" id="btn-close-modal-fuel" class="text-muted hover:text-navy text-lg cursor-pointer">✕</button>
        </div>

        <form id="form-fuel-chofer" class="space-y-3 text-xs">
          <div>
            <label class="block font-bold text-navy mb-1">Estación de Servicio</label>
            <input
              type="text"
              id="fuel-estacion"
              value="YPF ACA San Juan"
              required
              class="w-full rounded-xl border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy focus:border-orangeGov focus:outline-none"
            />
          </div>

          <div>
            <label class="block font-bold text-navy mb-1">Tipo de Combustible</label>
            <select
              id="fuel-tipo-combustible"
              class="w-full rounded-xl border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy focus:border-orangeGov focus:outline-none"
            >
              <option value="diesel_500">Diesel 500</option>
              <option value="diesel_grado_3">Infinia Diesel (Grado 3)</option>
              <option value="nafta_super">Nafta Súper</option>
              <option value="nafta_premium">Infinia Nafta (Premium)</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block font-bold text-navy mb-1">Litros *</label>
              <input
                type="number"
                step="0.01"
                id="fuel-litros"
                required
                placeholder="40.0"
                class="w-full rounded-xl border border-line bg-paper px-3 py-2 font-mono font-bold text-navy focus:border-orangeGov focus:outline-none"
              />
            </div>
            <div>
              <label class="block font-bold text-navy mb-1">Importe ($) *</label>
              <input
                type="number"
                step="0.01"
                id="fuel-importe"
                required
                placeholder="55000"
                class="w-full rounded-xl border border-line bg-paper px-3 py-2 font-mono font-bold text-navy focus:border-orangeGov focus:outline-none"
              />
            </div>
          </div>

          <!-- Scanners IA para Combustible (Ticket Edenred o Tablero) -->
          <div class="rounded-2xl border border-dashed border-orangeGov/40 bg-orange-50/60 p-3 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-orangeGov flex items-center gap-1.5">
                <Receipt size={14} />
                Escanear con IA (Autocompletar)
              </span>
              <span class="text-[10px] font-semibold text-muted">Gemini Flash</span>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <label class="flex flex-col items-center justify-center gap-1 p-2.5 rounded-xl bg-white border border-orange-200 text-xs font-bold text-orange-950 hover:bg-orange-100/50 cursor-pointer shadow-2xs active:scale-98 transition text-center">
                <span class="text-base">🧾</span>
                <span>Foto del Ticket</span>
                <span class="text-[9px] font-normal text-muted leading-tight">Edenred / Cupón</span>
                <input type="file" accept="image/*" capture="environment" id="scan-ticket-fuel" class="hidden" />
              </label>

              <label class="flex flex-col items-center justify-center gap-1 p-2.5 rounded-xl bg-white border border-orange-200 text-xs font-bold text-orange-950 hover:bg-orange-100/50 cursor-pointer shadow-2xs active:scale-98 transition text-center">
                <span class="text-base">📸</span>
                <span>Foto del Tablero</span>
                <span class="text-[9px] font-normal text-muted leading-tight">Solo odómetro (Km)</span>
                <input type="file" accept="image/*" capture="environment" id="scan-odo-fuel" class="hidden" />
              </label>
            </div>

            <div id="status-fuel-scanner" class="hidden text-xs font-medium p-2.5 rounded-xl"></div>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block font-bold text-navy mb-1">Odómetro Tablero</label>
              <input
                type="number"
                inputmode="numeric"
                pattern="[0-9]*"
                id="fuel-odometro"
                placeholder="Km actual"
                class="w-full rounded-2xl border border-line bg-paper px-3 py-2.5 text-base sm:text-xs font-mono font-bold text-navy focus:border-orangeGov focus:outline-none"
              />
            </div>
            <div>
              <label class="block font-bold text-navy mb-1">N° de Ticket</label>
              <input
                type="text"
                id="fuel-ticket"
                placeholder="TKT-00123"
                class="w-full rounded-2xl border border-line bg-paper px-3 py-2.5 text-base sm:text-xs font-mono text-navy focus:border-orangeGov focus:outline-none"
              />
            </div>
          </div>

          <button
            type="submit"
            id="btn-submit-fuel-chofer"
            class="w-full mt-2 rounded-2xl bg-orangeGov hover:bg-orange-700 py-3.5 text-xs font-bold text-white shadow-md active:scale-98 transition cursor-pointer"
          >
            Guardar Ticket de Combustible
          </button>
        </form>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL 3: FINALIZAR VIAJE (REGRESO AL CENTRO CÍVICO) -->
    <!-- ========================================================================= -->
    <div id="modal-llegada-chofer" class="fixed inset-0 z-50 flex items-center justify-center bg-navy/60 backdrop-blur-xs p-3 sm:p-4 hidden">
      <div class="w-full max-w-sm rounded-3xl bg-white p-5 sm:p-6 shadow-2xl space-y-4 border border-line animate-in zoom-in-95 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-navy">Finalizar Comisión Oficial</h3>
          <button type="button" id="btn-close-modal-llegada" class="text-muted hover:text-navy text-lg p-1 cursor-pointer">✕</button>
        </div>

        <p class="text-xs text-muted">
          Ingresa el odómetro final al llegar a destino. El vehículo y tu legajo quedarán liberados en el sistema.
        </p>

        <!-- Scanner IA para Llegada (Optimizado para móvil) -->
        <div class="rounded-2xl border border-dashed border-orangeGov/40 bg-orange-50/60 p-3 space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-orangeGov flex items-center gap-1.5">
              <Camera size={15} />
              Escanear Tablero con IA
            </span>
            <span class="text-[10px] font-semibold text-muted">Gemini Flash</span>
          </div>
          <label class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-orangeGov hover:bg-orange-700 text-white font-bold text-xs shadow-md shadow-orange-500/20 active:scale-98 transition cursor-pointer">
            <Camera size={16} />
            <span>Sacar Foto con la Cámara</span>
            <input type="file" accept="image/*" capture="environment" id="scan-odo-llegada" class="hidden" />
          </label>
          <div id="status-odo-llegada" class="hidden text-xs font-medium p-2.5 rounded-xl"></div>
        </div>

        <form id="form-confirmar-llegada-chofer" class="space-y-3">
          <div>
            <label class="block text-xs font-bold text-navy mb-1">
              Odómetro de Regreso (Km) *
            </label>
            <div class="relative">
              <Gauge size={18} class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" />
              <input
                type="number"
                inputmode="numeric"
                pattern="[0-9]*"
                id="input-odo-llegada-chofer"
                required
                min={viajeActivo?.odometro_salida || viajeActivo?.vehiculo_odometro || 0}
                placeholder="Ej: 66300"
                class="w-full rounded-2xl border border-line bg-paper pl-11 pr-3.5 py-3 text-base sm:text-xs font-bold font-mono text-navy focus:border-orangeGov focus:outline-none"
              />
            </div>
            <p class="mt-1 text-[10px] text-muted">
              Odómetro de salida: {viajeActivo?.odometro_salida || viajeActivo?.vehiculo_odometro || 0} km
            </p>
          </div>

          <div>
            <label class="block text-xs font-bold text-navy mb-1">
              Novedades / Observaciones de Cierre
            </label>
            <textarea
              id="input-obs-llegada-chofer"
              rows="2"
              placeholder="Sin novedades mecánicas, móvil limpio..."
              class="w-full rounded-xl border border-line bg-paper p-3 text-xs text-navy focus:border-orangeGov focus:outline-none resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="btn-submit-llegada-chofer"
            class="w-full rounded-xl bg-navy hover:bg-slate-900 py-3 text-xs font-bold text-white shadow-md transition cursor-pointer"
          >
            Confirmar Llegada y Liberar Móvil
          </button>
        </form>
      </div>
    </div>
  </div>

  <script src="../frontend/scripts/miViajeController.ts"></script>
</DashboardLayout>
