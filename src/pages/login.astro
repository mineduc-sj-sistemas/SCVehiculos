---
import { Bus, Eye, EyeOff, KeyRound, Lock, Mail, ShieldCheck } from 'lucide-astro'
import { verifySessionToken, SESSION_COOKIE_NAME } from '../backend/index'
import '../frontend/styles/global.css'

// Si ya tiene sesión válida, redirigir al panel principal
const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value
const existingSession = verifySessionToken(sessionToken)
if (existingSession) {
  return Astro.redirect('/')
}
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión · SCVehículos · Ministerio de Educación</title>
  </head>
  <body class="h-full flex flex-col justify-center items-center p-4 bg-[#f4f7fb] text-ink antialiased">
    <!-- Contenedor Principal Centrado -->
    <div class="w-full max-w-md">
      <!-- Tarjeta de Login -->
      <div class="card overflow-hidden shadow-xl border border-line bg-white rounded-3xl p-8 sm:p-10">
        <!-- Encabezado Institucional -->
        <div class="text-center mb-8">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-navy text-gold shadow-md mb-4 ring-8 ring-blue/10">
            <Bus size={34} strokeWidth={2.5} />
          </div>
          <span class="inline-block px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-[.15em] bg-sky text-blue mb-2">
            Gobierno de San Juan
          </span>
          <h1 class="font-display text-2xl font-bold tracking-tight text-navy">SCVehículos</h1>
          <p class="text-xs font-semibold text-muted mt-1">Control de Parque Automotor y Movilidades</p>
        </div>

        <!-- Alerta de Error -->
        <div
          id="login-error-alert"
          class="hidden mb-5 rounded-xl bg-rose-50 border border-rose-200/80 p-3.5 text-xs font-semibold text-rose-800 transition"
        ></div>

        <!-- Formulario -->
        <form id="login-form" class="space-y-4">
          <!-- Campo: Email -->
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
              Correo Institucional
            </label>
            <div class="relative">
              <Mail size={17} class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" />
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="usuario@sanjuan.edu.ar"
                class="w-full rounded-xl border border-line bg-paper pl-10 pr-3.5 py-2.5 text-xs font-semibold text-navy outline-none focus:border-blue focus:ring-2 focus:ring-blue/15 transition"
              />
            </div>
          </div>

          <!-- Campo: Contraseña -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-bold uppercase tracking-wider text-muted">
                Contraseña
              </label>
            </div>
            <div class="relative">
              <Lock size={17} class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" />
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                class="w-full rounded-xl border border-line bg-paper pl-10 pr-10 py-2.5 text-xs font-semibold text-navy outline-none focus:border-blue focus:ring-2 focus:ring-blue/15 transition"
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-navy transition p-1"
                aria-label="Mostrar contraseña"
              >
                <Eye size={17} id="icon-eye" />
                <EyeOff size={17} id="icon-eye-off" class="hidden" />
              </button>
            </div>
          </div>

          <!-- Botón de Ingreso -->
          <button
            type="submit"
            id="btn-login-submit"
            class="w-full mt-2 flex items-center justify-center gap-2 rounded-xl bg-blue py-3 px-4 text-xs font-bold text-white shadow-md shadow-blue/25 hover:opacity-95 active:scale-[0.99] transition cursor-pointer"
          >
            <span id="btn-login-text">Ingresar al Sistema</span>
          </button>
        </form>

        <!-- Divisor y Acceso Rápido Demo -->
        <div class="mt-6 pt-5 border-t border-line text-center">
          <p class="text-[11px] font-semibold text-muted mb-3">Atajo de Acceso Rápido para Desarrollo:</p>
          <button
            type="button"
            id="btn-quick-admin"
            class="w-full flex items-center justify-center gap-2 rounded-xl border border-line bg-paper hover:bg-sky/60 hover:border-blue/30 py-2.5 px-3 text-xs font-bold text-navy transition cursor-pointer"
          >
            <ShieldCheck size={16} class="text-blue" />
            <span>Rellenar con Administrador Demo</span>
          </button>
        </div>
      </div>

      <!-- Footer inferior -->
      <div class="text-center mt-6 text-[11px] font-semibold text-muted">
        <p>Ministerio de Educación · Provincia de San Juan</p>
        <p class="text-[10px] text-muted/80 mt-0.5">Dirección de Sistemas e Informática</p>
      </div>
    </div>

    <!-- Script de Cliente -->
    <script>
      const form = document.getElementById('login-form') as HTMLFormElement | null
      const emailInput = document.getElementById('email') as HTMLInputElement | null
      const passwordInput = document.getElementById('password') as HTMLInputElement | null
      const errorAlert = document.getElementById('login-error-alert')
      const btnSubmit = document.getElementById('btn-login-submit') as HTMLButtonElement | null
      const btnText = document.getElementById('btn-login-text')
      const btnQuickAdmin = document.getElementById('btn-quick-admin')
      const togglePassword = document.getElementById('toggle-password')
      const iconEye = document.getElementById('icon-eye')
      const iconEyeOff = document.getElementById('icon-eye-off')

      // Mostrar / Ocultar Contraseña
      togglePassword?.addEventListener('click', () => {
        if (!passwordInput) return
        const isPassword = passwordInput.type === 'password'
        passwordInput.type = isPassword ? 'text' : 'password'
        iconEye?.classList.toggle('hidden', isPassword)
        iconEyeOff?.classList.toggle('hidden', !isPassword)
      })

      // Rellenar con admin demo
      btnQuickAdmin?.addEventListener('click', () => {
        if (emailInput && passwordInput) {
          emailInput.value = 'maria.gutierrez@sanjuan.edu.ar'
          passwordInput.value = 'admin123'
          errorAlert?.classList.add('hidden')
        }
      })

      // Envío de Formulario
      form?.addEventListener('submit', async (e) => {
        e.preventDefault()

        const email = emailInput?.value.trim() || ''
        const password = passwordInput?.value.trim() || ''

        if (errorAlert) {
          errorAlert.classList.add('hidden')
          errorAlert.textContent = ''
        }

        if (!email || !password) {
          if (errorAlert) {
            errorAlert.textContent = 'Por favor completa todos los campos.'
            errorAlert.classList.remove('hidden')
          }
          return
        }

        try {
          if (btnSubmit && btnText) {
            btnSubmit.disabled = true
            btnText.textContent = 'Verificando credenciales...'
          }

          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          })

          const data = await res.json()

          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Credenciales inválidas.')
          }

          // Redirección exitosa al panel principal
          window.location.href = '/'
        } catch (err: any) {
          if (errorAlert) {
            errorAlert.textContent = err.message || 'Error al iniciar sesión.'
            errorAlert.classList.remove('hidden')
          }
        } finally {
          if (btnSubmit && btnText) {
            btnSubmit.disabled = false
            btnText.textContent = 'Ingresar al Sistema'
          }
        }
      })
    </script>
  </body>
</html>
