---
import { Eye, EyeOff, Lock, Mail } from 'lucide-astro'
import SanJuanLogo from '../frontend/components/ui/SanJuanLogo.astro'
import PwaManager from '../frontend/components/pwa/PwaManager.astro'
import { verifySessionToken, SESSION_COOKIE_NAME } from '../backend/index'
import '../frontend/styles/global.css'

// Si ya tiene sesión válida, redirigir al portal correspondiente
const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value
const existingSession = verifySessionToken(sessionToken)
if (existingSession) {
  if (existingSession.rolId === 4) {
    return Astro.redirect('/mi-viaje')
  }
  return Astro.redirect('/')
}
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Iniciar Sesión · SCVehículos · Ministerio de Educación</title>

    <!-- Metadatos y Manifiesto PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b2240" />
    <meta name="application-name" content="SCVehículos" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SCVehículos" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />
  </head>
  <body class="h-full flex flex-col justify-center items-center p-4 bg-[#f4f7fb] text-ink antialiased">
    <!-- Contenedor Principal Centrado -->
    <div class="w-full max-w-md">
      <!-- Tarjeta de Login -->
      <div class="card overflow-hidden shadow-xl border border-line bg-white rounded-3xl p-8 sm:p-10">
        <!-- Encabezado Institucional -->
        <div class="flex flex-col items-center text-center mb-7">
          <div class="mb-4">
            <SanJuanLogo variant="dark" size="lg" showMinistry={true} />
          </div>
          <div class="mt-2 border-t border-line/60 pt-3 w-full">
            <h1 class="font-display text-2xl font-bold tracking-tight text-navy">SCVehículos</h1>
            <p class="text-xs font-semibold text-muted mt-1">Control de Parque Automotor y Movilidades</p>
          </div>
        </div>

        <!-- Alerta de Error -->
        <div
          id="login-error-alert"
          class="hidden mb-5 rounded-xl bg-rose-50 border border-rose-200/80 p-3.5 text-xs font-semibold text-rose-800 transition"
        ></div>

        <!-- Formulario -->
        <form id="login-form" class="space-y-4">
          <!-- Campo: Email -->
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
              Correo Institucional
            </label>
            <div class="relative">
              <Mail size={17} class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" />
              <input
                id="email"
                name="email"
                type="text"
                inputmode="email"
                required
                autocomplete="username"
                placeholder="usuario@sanjuan.edu.ar"
                class="w-full rounded-xl border border-line bg-paper pl-10 pr-3.5 py-2.5 text-xs font-semibold text-navy outline-none focus:border-orangeGov focus:ring-2 focus:ring-orangeGov/15 transition"
              />
            </div>
          </div>

          <!-- Campo: Contraseña -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-bold uppercase tracking-wider text-muted">
                Contraseña
              </label>
            </div>
            <div class="relative">
              <Lock size={17} class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" />
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                class="w-full rounded-xl border border-line bg-paper pl-10 pr-10 py-2.5 text-xs font-semibold text-navy outline-none focus:border-orangeGov focus:ring-2 focus:ring-orangeGov/15 transition"
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-navy transition p-1"
                aria-label="Mostrar contraseña"
              >
                <Eye size={17} id="icon-eye" />
                <EyeOff size={17} id="icon-eye-off" class="hidden" />
              </button>
            </div>
          </div>

          <!-- Botón de Ingreso -->
          <button
            type="submit"
            id="btn-login-submit"
            class="w-full mt-2 flex items-center justify-center gap-2 rounded-xl bg-orangeGov hover:bg-orange-700 py-3 px-4 text-xs font-bold text-white shadow-md shadow-orange-500/25 active:scale-[0.99] transition cursor-pointer"
          >
            <span id="btn-login-text">Ingresar al Sistema</span>
          </button>
        </form>
      </div>

      <!-- Footer inferior -->
      <div class="text-center mt-6 text-[11px] font-semibold text-muted">
        <p>Ministerio de Educación · Provincia de San Juan</p>
        <p class="text-[10px] text-muted/80 mt-0.5">Dirección de Sistemas e Informática</p>
      </div>
    </div>

    <!-- Script de Cliente -->
    <script>
      const form = document.getElementById('login-form') as HTMLFormElement | null
      const emailInput = document.getElementById('email') as HTMLInputElement | null
      const passwordInput = document.getElementById('password') as HTMLInputElement | null
      const errorAlert = document.getElementById('login-error-alert')
      const btnSubmit = document.getElementById('btn-login-submit') as HTMLButtonElement | null
      const btnText = document.getElementById('btn-login-text')
      const togglePassword = document.getElementById('toggle-password')
      const iconEye = document.getElementById('icon-eye')
      const iconEyeOff = document.getElementById('icon-eye-off')

      // Mostrar / Ocultar Contraseña
      togglePassword?.addEventListener('click', () => {
        if (!passwordInput) return
        const isPassword = passwordInput.type === 'password'
        passwordInput.type = isPassword ? 'text' : 'password'
        iconEye?.classList.toggle('hidden', isPassword)
        iconEyeOff?.classList.toggle('hidden', !isPassword)
      })

      // Envío de Formulario
      form?.addEventListener('submit', async (e) => {
        e.preventDefault()

        const email = emailInput?.value.trim() || ''
        const password = passwordInput?.value.trim() || ''

        if (errorAlert) {
          errorAlert.classList.add('hidden')
          errorAlert.textContent = ''
        }

        if (!email || !password) {
          if (errorAlert) {
            errorAlert.textContent = 'Por favor completa todos los campos.'
            errorAlert.classList.remove('hidden')
          }
          return
        }

        try {
          if (btnSubmit && btnText) {
            btnSubmit.disabled = true
            btnText.textContent = 'Verificando credenciales...'
          }

          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          })

          const data = await res.json()

          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Credenciales inválidas.')
          }

          // Redirección adaptativa según rol
          if (data.user?.rolId === 4) {
            window.location.href = '/mi-viaje'
          } else {
            window.location.href = '/'
          }
        } catch (err: any) {
          if (errorAlert) {
            errorAlert.textContent = err.message || 'Error al iniciar sesión.'
            errorAlert.classList.remove('hidden')
          }
        } finally {
          if (btnSubmit && btnText) {
            btnSubmit.disabled = false
            btnText.textContent = 'Ingresar al Sistema'
          }
        }
      })
    </script>

    <!-- Gestor PWA -->
    <PwaManager />
  </body>
</html>
