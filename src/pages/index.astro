---
import { AlertTriangle, CalendarDays, Car, ChevronRight, Fuel, MoreHorizontal, Route, ShieldCheck, UsersRound, Wrench } from 'lucide-astro'
import DashboardLayout from '../frontend/layouts/DashboardLayout.astro'
import DashboardStatCards from '../frontend/components/dashboard/DashboardStatCards.astro'
import PlateBadge from '../frontend/components/ui/PlateBadge.astro'
import StatusBadge from '../frontend/components/ui/StatusBadge.astro'
import AuditorExecutiveView from '../frontend/components/auditoria/AuditorExecutiveView.astro'
import {
  getDashboardStats,
  getFleet,
  getActiveTravels,
  getDriverStats,
  getDashboardMaintenance,
  getFuelStats,
  getOperationalAlerts,
  getViajesList,
  getMaintenanceList,
  verifySessionToken,
  SESSION_COOKIE_NAME,
} from '../backend/index'

// Identificación del usuario activo
const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value
const currentUser = Astro.locals.user || verifySessionToken(sessionToken) || {
  id: 1,
  nombre: 'María',
  apellido: 'Gutiérrez',
  nombreCompleto: 'María Gutiérrez',
  email: 'maria.gutierrez@sanjuan.edu.ar',
  rolNombre: 'Administrador',
  rolId: 1,
}

const isAuditor = currentUser.rolId === 5 || Astro.url.searchParams.get('vista') === 'auditor'

// Consultas dinámicas a la base de datos MySQL (sc_vehiculos) a través de la capa Backend
const [stats, fleet, travels, driverStats, maintenance, fuelStats, alertsSummary, viajes, mantenimientos] = await Promise.all([
  getDashboardStats(),
  getFleet(),
  getActiveTravels(),
  getDriverStats(),
  getDashboardMaintenance(),
  getFuelStats(),
  getOperationalAlerts(),
  getViajesList(),
  getMaintenanceList(),
])
---

<DashboardLayout activeNav="panel" title={isAuditor ? "Panel de Auditoría · Fiscalización de Flota · Ministerio de Educación" : "Panel principal · Movilidades · Ministerio de Educación"}>
  <h1 slot="header-title" class="font-display text-xl font-bold text-navy sm:text-2xl">
    {isAuditor ? "Panel de Auditoría y Fiscalización" : "Panel principal"}
  </h1>

  {isAuditor ? (
    <AuditorExecutiveView
      currentUser={currentUser}
      stats={stats}
      fleet={fleet}
      viajes={viajes}
      mantenimientos={mantenimientos}
      alertsSummary={alertsSummary}
    />
  ) : (
    <>


  <!-- Encabezado de bienvenida -->
  <section class="dashboard-welcome mb-5">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold bg-orange-100 text-orange-800">
          Ministerio de Educación
        </span>
        <span class="text-xs font-semibold text-muted">· Gobierno de San Juan</span>
      </div>
      <h2 class="font-display text-[27px] font-bold tracking-tight text-navy">Buen día, {currentUser.nombre}</h2>
      <p class="mt-0.5 text-sm text-muted">Supervisión en tiempo real del parque automotor y comisiones oficiales.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <a
        href="/?vista=auditor"
        class="flex items-center gap-1.5 rounded-xl border border-line bg-white hover:bg-paper px-3.5 py-2.5 text-xs font-bold text-navy shadow-xs transition"
        title="Ver el panel en formato ejecutivo para Auditoría"
      >
        <ShieldCheck size={14} class="text-[#ea580c]" />
        <span>Vista Auditor</span>
      </a>
      <a
        href="/flota"
        class="flex items-center gap-2 rounded-xl border border-line bg-white px-4 py-2.5 text-xs font-bold text-navy hover:bg-paper transition"
      >
        <span>Ver parque automotor</span>
      </a>
      <a
        href="/cronograma"
        class="flex items-center gap-2 rounded-xl bg-orangeGov px-4 py-2.5 text-xs font-bold text-white shadow-md shadow-orange-500/20 hover:bg-orange-700 transition cursor-pointer"
      >
        <span class="text-base leading-none">+</span>
        <span>Nueva comisión</span>
      </a>
    </div>
  </div>
  </section>

  {alertsSummary.totalAlerts > 0 && (
    <div class="mb-5 rounded-xl bg-amber-50 border border-amber-200 p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500 text-white font-bold shadow-sm">
          <AlertTriangle size={20} />
        </div>
        <div>
          <h4 class="font-display text-sm font-bold text-amber-900">
            {alertsSummary.urgentesCount > 0 ? 'Atención: Vencimientos Críticos Detectados' : 'Avisos Operativos Próximos'}
          </h4>
          <p class="text-xs text-amber-800/80 mt-0.5">
            Hay <strong>{alertsSummary.totalAlerts}</strong> avisos ({alertsSummary.urgentesCount} urgentes, {alertsSummary.advertenciasCount} próximos) que requieren regularización de RTO, licencias o services mecánicos.
          </p>
        </div>
      </div>
      <a
        href="/flota"
        class="inline-flex items-center gap-1.5 rounded-xl bg-white border border-amber-300 px-3.5 py-2 text-xs font-bold text-amber-900 hover:bg-amber-100 transition shrink-0"
      >
        <span>Revisar Parque Automotor</span>
        <ChevronRight size={14} />
      </a>
    </div>
  )}

  <!-- Accesos Rápidos Institucionales · Estilo Oficial Ministerio de Educación (Referencia San Juan) -->
  <section class="mb-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
    <!-- Card 1: Naranja San Juan - Nueva Comisión -->
    <a
      href="/cronograma"
      class="group relative flex items-center gap-3.5 rounded-2xl bg-[#ff8400] p-4 text-white shadow-md shadow-orange-600/20 transition-all hover:bg-[#e87500] hover:shadow-lg hover:-translate-y-0.5"
    >
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/20 text-white backdrop-blur-xs transition group-hover:scale-105">
        <Route size={24} strokeWidth={2.2} />
      </div>
      <div>
        <h3 class="font-display text-[15px] font-bold leading-tight">Nueva Comisión</h3>
        <p class="mt-0.5 text-[11px] text-orange-100 font-medium">Asignar viaje oficial</p>
      </div>
    </a>

    <!-- Card 2: Carbón Ministerio - Parque Automotor -->
    <a
      href="/flota"
      class="group relative flex items-center gap-3.5 rounded-2xl bg-[#18394e] p-4 text-white shadow-md shadow-slate-900/15 transition-all hover:bg-[#112f41] hover:shadow-lg hover:-translate-y-0.5"
    >
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/15 text-white backdrop-blur-xs transition group-hover:scale-105">
        <Car size={24} strokeWidth={2.2} />
      </div>
      <div>
        <h3 class="font-display text-[15px] font-bold leading-tight">Parque Automotor</h3>
        <p class="mt-0.5 text-[11px] text-slate-300 font-medium">Fichas técnicas y RTO</p>
      </div>
    </a>

    <!-- Card 3: Naranja San Juan - Conductores -->
    <a
      href="/choferes"
      class="group relative flex items-center gap-3.5 rounded-2xl bg-[#e6382e] p-4 text-white shadow-md shadow-red-600/15 transition-all hover:bg-[#cf2e26] hover:shadow-lg hover:-translate-y-0.5"
    >
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/20 text-white backdrop-blur-xs transition group-hover:scale-105">
        <UsersRound size={24} strokeWidth={2.2} />
      </div>
      <div>
        <h3 class="font-display text-[15px] font-bold leading-tight">Conductores</h3>
        <p class="mt-0.5 text-[11px] text-orange-100 font-medium">Legajos y licencias</p>
      </div>
    </a>

    <!-- Card 4: Carbón Ministerio - Cronograma -->
    <a
      href="/cronograma"
      class="group relative flex items-center gap-3.5 rounded-2xl bg-[#20262c] p-4 text-white shadow-md shadow-slate-900/15 transition-all hover:bg-[#171c21] hover:shadow-lg hover:-translate-y-0.5"
    >
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/15 text-white backdrop-blur-xs transition group-hover:scale-105">
        <CalendarDays size={24} strokeWidth={2.2} />
      </div>
      <div>
        <h3 class="font-display text-[15px] font-bold leading-tight">Cronograma</h3>
        <p class="mt-0.5 text-[11px] text-slate-300 font-medium">Itinerarios y traslados</p>
      </div>
    </a>
  </section>

  <!-- Tarjetas KPI superiores (Componente de Frontend) -->
  <section class="mb-6">
    <DashboardStatCards stats={stats} />
  </section>

  <!-- Grilla: Estado de la Flota y Actividad en tiempo real -->
  <div class="mt-6 grid gap-6 xl:grid-cols-[1.55fr_1fr]">
    <!-- Estado de la flota -->
    <section class="card overflow-hidden">
      <div class="flex items-center justify-between border-b border-line px-5 py-4">
        <div>
          <h3 class="font-display text-[16px] font-bold text-navy">Estado de la flota</h3>
          <p class="mt-0.5 text-xs text-muted">Monitoreo de unidades y documentación ({fleet.length} registradas)</p>
        </div>
        <a href="/flota" class="flex items-center gap-1 text-xs font-bold text-blue hover:underline">
          Ver flota completa <ChevronRight size={14} />
        </a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[680px] text-left">
          <thead>
            <tr class="border-b border-line bg-paper text-[10px] font-bold uppercase tracking-[.08em] text-muted">
              <th class="px-5 py-3">Unidad</th>
              <th class="px-3 py-3">Patente</th>
              <th class="px-3 py-3">Odómetro</th>
              <th class="px-3 py-3">VTV / RTO</th>
              <th class="px-5 py-3 text-right">Estado</th>
            </tr>
          </thead>
          <tbody>
            {fleet.map((item) => (
              <tr class="border-b border-line last:border-0 hover:bg-paper/50 transition">
                <td class="px-5 py-3.5">
                  <p class="text-[13px] font-bold text-navy">{item.vehicle}</p>
                  <p class="text-[11px] text-muted">{item.type}</p>
                </td>
                <td class="px-3 py-3.5">
                  <PlateBadge plate={item.plate} />
                </td>
                <td class="px-3 py-3.5 text-xs font-semibold text-muted">{item.km}</td>
                <td class="px-3 py-3.5 text-xs font-semibold text-muted">{item.vtv}</td>
                <td class="px-5 py-3.5 text-right">
                  <StatusBadge status={item.status} tone={item.tone} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Actividad en tiempo real -->
    <section class="card">
      <div class="flex items-center justify-between border-b border-line px-5 py-4">
        <div>
          <h3 class="font-display text-[16px] font-bold text-navy">Actividad en tiempo real</h3>
          <p class="mt-0.5 text-xs text-muted">Últimas novedades operativas</p>
        </div>
        <button class="text-muted hover:text-navy cursor-pointer" aria-label="Más opciones">
          <MoreHorizontal size={19} />
        </button>
      </div>
      <div class="divide-y divide-[#e5ebf2] px-5">
        {travels.map((travel) => (
          <div class="flex gap-3 py-4">
            <div class:list={[travel.color]} class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-white">
              <Route size={15} />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <p class="text-[13px] font-bold text-navy truncate">Comisión a {travel.place}</p>
                <span class="whitespace-nowrap text-[10px] font-semibold text-muted">{travel.time}</span>
              </div>
              <p class="mt-1 truncate text-[11px] text-muted">{travel.driver} · {travel.vehicle}</p>
              <p class="mt-1 truncate text-[11px] font-semibold text-blue">{travel.area}</p>
            </div>
          </div>
        ))}
      </div>
      <a href="/flota" class="flex items-center justify-center gap-1 border-t border-line py-3 text-xs font-bold text-blue hover:bg-paper/40 transition">
        Ver detalles de la flota <ChevronRight size={14} />
      </a>
    </section>
  </div>

  <!-- Resúmenes inferiores: Choferes, Mantenimientos y Combustible -->
  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <!-- Choferes -->
    <section id="choferes" class="card p-5">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-display text-[16px] font-bold text-navy">Choferes</h3>
          <p class="mt-0.5 text-xs text-muted">Estado de documentación</p>
        </div>
        <div class="rounded-lg bg-sky p-2 text-blue">
          <UsersRound size={18} />
        </div>
      </div>
      <div class="mt-5 flex items-end justify-between">
        <div>
          <p class="font-display text-3xl font-bold text-navy">{String(driverStats.totalDrivers).padStart(2, '0')}</p>
          <p class="text-[11px] font-semibold text-muted">Conductores registrados</p>
        </div>
        <div class="text-right">
          <p class="font-display text-xl font-bold text-[#bf6e32]">{String(driverStats.expiringLicenses).padStart(2, '0')}</p>
          <p class="text-[11px] font-semibold text-muted">Carnets por vencer (30 d)</p>
        </div>
      </div>
      <div class="mt-5 h-2 overflow-hidden rounded-full bg-sky">
        <div style={`width: ${driverStats.validPercent}%`} class="h-full rounded-full bg-blue transition-all duration-500"></div>
      </div>
      <div class="mt-2 flex justify-between text-[10px] font-bold text-muted">
        <span>{driverStats.validPercent}% documentación al día</span>
        <span class="text-blue">Gestionar</span>
      </div>
    </section>

    <!-- Mantenimientos -->
    <section id="mantenimientos" class="card p-5">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-display text-[16px] font-bold text-navy">Mantenimientos</h3>
          <p class="mt-0.5 text-xs text-muted">Agenda de servicios</p>
        </div>
        <div class="rounded-lg bg-[#fff0e4] p-2 text-[#bf6e32]">
          <Wrench size={18} />
        </div>
      </div>
      <div class="mt-4 space-y-3">
        {maintenance.map((item) => (
          <div class="rounded-lg bg-paper p-3 border border-line/60">
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs font-bold text-navy truncate">{item.title}</p>
              <span class:list={[item.tagClass]} class="rounded px-2 py-1 text-[9px] font-bold shrink-0">{item.tag}</span>
            </div>
            <p class="mt-1 text-[11px] text-muted">{item.vehicle} · {item.date}</p>
          </div>
        ))}
      </div>
      <a href="/mantenimientos" class="mt-4 flex items-center gap-1 text-xs font-bold text-orangeGov hover:underline">
        Ver gestión de taller y servicios <ChevronRight size={14} />
      </a>
    </section>

    <!-- Combustible -->
    <section id="combustible" class="card p-5">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-display text-[16px] font-bold text-navy">Consumo de combustible</h3>
          <p class="mt-0.5 text-xs text-muted">Resumen de la flota · Promedio general</p>
        </div>
        <div class="rounded-lg bg-[#fff6df] p-2 text-[#b17b09]">
          <Fuel size={18} />
        </div>
      </div>
      <div class="mt-5 flex items-end gap-2">
        <p class="font-display text-3xl font-bold text-navy">{fuelStats.avgLitersPer100Km}</p>
        <p class="mb-1 text-xs font-bold text-muted">L / 100 km</p>
        <span class="mb-1 ml-auto rounded-full bg-[#e8f7ef] px-2 py-1 text-[10px] font-bold text-[#20864f]">
          ↓ {fuelStats.trendPercent}
        </span>
      </div>
      <div class="mt-4 flex h-14 items-end gap-1.5">
        {fuelStats.bars.map((height, index) => (
          <div
            class:list={{'bg-blue': index === 11, 'bg-sky': index !== 11}}
            style={`height:${height}%`}
            class="flex-1 rounded-t-sm transition-all hover:opacity-80"
          ></div>
        ))}
      </div>
      <div class="mt-2 flex justify-between text-[10px] font-semibold text-muted">
        <span>01 Sep</span>
        <span>18 Sep</span>
      </div>
      <a href="/combustible" class="mt-4 flex items-center gap-1 text-xs font-bold text-orangeGov hover:underline">
        Ver control de combustible y tickets <ChevronRight size={14} />
      </a>
    </section>
  </div>
    </>
  )}
</DashboardLayout>
