---
/**
 * FACHADA DE RETROCOMPATIBILIDAD
 * El layout principal ha sido trasladado a `src/frontend/layouts/DashboardLayout.astro`.
 */
import DashboardLayout from '../frontend/layouts/DashboardLayout.astro'

interface Props {
  title?: string
  activeNav?: 'panel' | 'flota' | 'choferes' | 'viajes' | 'mantenimientos' | 'combustible' | 'configuracion'
}

const props = Astro.props
---

<DashboardLayout {...props}>
  <slot name="header-title" slot="header-title" />
  <slot />
  <slot name="modals" slot="modals" />
</DashboardLayout>
