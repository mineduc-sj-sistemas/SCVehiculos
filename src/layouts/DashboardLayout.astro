---
import { Activity, Bell, Bus, CalendarDays, ChevronDown, ChevronRight, LayoutDashboard, Menu, Route, Search, Settings, Truck, UsersRound, Wrench, Fuel } from 'lucide-astro'
import '../styles/global.css'

interface Props {
  title?: string
  activeNav?: 'panel' | 'flota' | 'choferes' | 'viajes' | 'mantenimientos' | 'combustible' | 'configuracion'
}

const {
  title = 'Movilidades · Ministerio de Educación · Gobierno de San Juan',
  activeNav = 'panel',
} = Astro.props

const navItems = [
  { id: 'panel', label: 'Panel principal', href: '/', icon: LayoutDashboard },
  { id: 'flota', label: 'Vehículos / Flota', href: '/flota', icon: Truck },
  { id: 'choferes', label: 'Choferes', href: '/#choferes', icon: UsersRound },
  { id: 'viajes', label: 'Viajes / Hojas de ruta', href: '/#viajes', icon: Route },
  { id: 'mantenimientos', label: 'Mantenimientos', href: '/#mantenimientos', icon: Wrench },
  { id: 'combustible', label: 'Combustible', href: '/#combustible', icon: Fuel },
]

const todayFormatted = new Intl.DateTimeFormat('es-AR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date())
const capitalizedDate = todayFormatted.charAt(0).toUpperCase() + todayFormatted.slice(1)
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-paper text-ink antialiased">
    <div class="min-h-screen bg-paper">
      <div id="mobile-overlay" class="mobile-overlay fixed inset-0 z-30 bg-navy/30"></div>
      
      <!-- Sidebar de navegación -->
      <aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-40 flex w-[258px] flex-col bg-navy text-white">
        <div class="flex h-[94px] items-center gap-3 border-b border-white/10 px-6">
          <a href="/" class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gold text-navy shadow-sm">
              <Bus size={25} strokeWidth={2.5} />
            </div>
            <div>
              <p class="font-display text-[17px] font-bold tracking-tight">Movilidades</p>
              <p class="text-[11px] font-semibold uppercase tracking-[.16em] text-white/55">Ministerio de Educación</p>
            </div>
          </a>
        </div>
        
        <div class="px-4 pt-7">
          <p class="mb-3 px-3 text-[10px] font-bold uppercase tracking-[.2em] text-white/35">Gestión operativa</p>
          <nav class="space-y-1">
            {navItems.map((item) => {
              const isActive = activeNav === item.id
              return (
                <a
                  href={item.href}
                  class:list={[
                    'group flex items-center gap-3 rounded-lg px-3 py-3 text-[13px] font-semibold transition',
                    isActive ? 'bg-white/12 text-white font-bold' : 'text-white/65 hover:bg-white/10 hover:text-white'
                  ]}
                >
                  <item.icon size={18} strokeWidth={1.9} />
                  <span>{item.label}</span>
                  {isActive && <span class="ml-auto h-1.5 w-1.5 rounded-full bg-gold" />}
                </a>
              )
            })}
          </nav>
        </div>
        
        <div class="mt-auto px-4 pb-5">
          <div class="mb-3 h-px bg-white/10"></div>
          <a
            href="#configuracion"
            class:list={[
              'flex items-center gap-3 rounded-lg px-3 py-3 text-[13px] font-semibold transition',
              activeNav === 'configuracion' ? 'bg-white/12 text-white' : 'text-white/60 hover:bg-white/10 hover:text-white'
            ]}
          >
            <Settings size={18} />
            <span>Configuración</span>
          </a>
          
          <div class="mt-4 flex items-center gap-3 rounded-lg bg-white/8 p-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gold font-display text-sm font-bold text-navy">
              MG
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-xs font-bold">María Gutiérrez</p>
              <p class="truncate text-[11px] text-white/50">Administradora</p>
            </div>
            <ChevronDown size={15} class="text-white/45" />
          </div>
        </div>
      </aside>

      <!-- Contenido Principal -->
      <main class="ml-0 min-h-screen lg:ml-[258px]">
        <header class="flex h-[94px] items-center justify-between border-b border-line bg-white px-5 sm:px-8">
          <div class="flex items-center gap-4">
            <button id="menu-button" class="rounded-lg p-2 text-muted hover:bg-sky lg:hidden" aria-label="Abrir menú">
              <Menu size={21} />
            </button>
            <div>
              <p class="text-xs font-semibold text-muted">{capitalizedDate}</p>
              <slot name="header-title">
                <h1 class="font-display text-xl font-bold text-navy sm:text-2xl">Panel principal</h1>
              </slot>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <div class="relative hidden md:block">
              <Search size={17} class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
              <input
                aria-label="Buscar"
                placeholder="Buscar vehículo, patente..."
                class="h-10 w-[230px] rounded-lg border border-line bg-paper pl-10 pr-3 text-xs outline-none transition focus:border-blue focus:bg-white"
              />
            </div>
            <button class="relative rounded-lg p-2.5 text-muted hover:bg-sky" aria-label="Notificaciones">
              <Bell size={19} />
              <span class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-gold ring-2 ring-white"></span>
            </button>
            <button class="hidden rounded-lg border border-line px-3 py-2 text-xs font-bold text-blue sm:flex sm:items-center sm:gap-2 hover:bg-sky/50 transition">
              <CalendarDays size={15} /> Este mes <ChevronDown size={14} />
            </button>
          </div>
        </header>

        <div class="p-5 sm:p-8">
          <slot />

          <footer class="mt-8 flex flex-col justify-between gap-2 border-t border-line pt-5 text-[11px] font-semibold text-muted sm:flex-row">
            <span>Ministerio de Educación · Gobierno de San Juan</span>
            <span class="flex items-center gap-1.5">
              <Activity size={13} class="text-blue" /> Sistema operativo · Base de datos en línea
            </span>
          </footer>
        </div>
      </main>
    </div>

    <!-- Modales fuera del flujo principal -->
    <slot name="modals" />

    <script>
      const menuButton = document.querySelector('#menu-button')
      const sidebar = document.querySelector('#sidebar')
      const overlay = document.querySelector('#mobile-overlay')
      const closeMenu = () => {
        sidebar?.classList.remove('open')
        overlay?.classList.remove('open')
      }
      menuButton?.addEventListener('click', () => {
        sidebar?.classList.toggle('open')
        overlay?.classList.toggle('open')
      })
      overlay?.addEventListener('click', closeMenu)
      sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu))
    </script>
  </body>
</html>
