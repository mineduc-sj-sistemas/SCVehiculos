---
import { Filter, LayoutGrid, List, Search } from 'lucide-astro'
import type { VehicleType, Dependencia } from '../../backend/types'

interface Props {
  types: VehicleType[]
  dependencias: Dependencia[]
}

const { types, dependencias } = Astro.props
---

<div class="card p-4 mb-6">
  <div class="flex flex-col lg:flex-row items-center justify-between gap-3">
    <!-- Buscador reactivo por patente, marca, modelo o cédula -->
    <div class="relative w-full lg:w-80">
      <Search size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
      <input
        id="filter-search"
        type="text"
        placeholder="Buscar por patente, marca, titular, color o cédula..."
        class="h-9 w-full rounded-lg border border-line bg-paper pl-9 pr-3 text-xs outline-none focus:border-blue focus:bg-white transition"
      />
    </div>

    <!-- Filtros desplegables y Conmutador de Vistas -->
    <div class="flex flex-wrap items-center justify-between sm:justify-end gap-2 w-full lg:w-auto">
      <div class="flex items-center gap-1.5 text-xs text-muted">
        <Filter size={14} />
        <span class="font-bold text-[11px] uppercase">Filtros:</span>
      </div>

      <select id="filter-estado" class="h-9 rounded-lg border border-line bg-paper px-2.5 text-xs outline-none focus:border-blue focus:bg-white transition cursor-pointer">
        <option value="">Estado: Todos</option>
        <option value="disponible">Disponibles</option>
        <option value="en_comision">En comisión</option>
        <option value="en_taller">En taller</option>
        <option value="baja">Baja</option>
      </select>

      <select id="filter-08" class="h-9 rounded-lg border border-line bg-paper px-2.5 text-xs outline-none focus:border-blue focus:bg-white transition cursor-pointer">
        <option value="">08: Todos</option>
        <option value="con_08">Posee 08</option>
        <option value="alerta">08 Alerta / Vencido</option>
        <option value="inscripto">Inscripto</option>
      </select>

      <select id="filter-tipo" class="h-9 rounded-lg border border-line bg-paper px-2.5 text-xs outline-none focus:border-blue focus:bg-white transition cursor-pointer">
        <option value="">Tipo: Todos</option>
        {types.map((t) => (
          <option value={t.nombre}>{t.nombre}</option>
        ))}
      </select>

      <select id="filter-dependencia" class="h-9 rounded-lg border border-line bg-paper px-2.5 text-xs outline-none focus:border-blue focus:bg-white transition max-w-[170px] truncate cursor-pointer">
        <option value="">Área: Todas</option>
        {dependencias.map((d) => (
          <option value={d.nombre}>{d.sigla ? `${d.sigla} - ${d.nombre}` : d.nombre}</option>
        ))}
      </select>

      <button id="btn-clear-filters" class="h-9 rounded-lg border border-line bg-white px-3 text-xs font-semibold text-muted hover:text-navy hover:bg-paper transition cursor-pointer">
        Limpiar
      </button>

      <!-- Conmutador de vista: Tarjetas (Default) / Tabla -->
      <div class="flex items-center rounded-lg border border-line bg-paper p-0.5 text-xs font-semibold ml-1">
        <button
          type="button"
          id="view-toggle-cards"
          class="flex items-center gap-1.5 rounded-md px-2.5 py-1.5 font-bold transition bg-white text-navy shadow-xs cursor-pointer"
          title="Vista de Tarjetas / Cards"
        >
          <LayoutGrid size={14} />
          <span class="hidden sm:inline">Tarjetas</span>
        </button>
        <button
          type="button"
          id="view-toggle-table"
          class="flex items-center gap-1.5 rounded-md px-2.5 py-1.5 font-bold transition text-muted hover:text-navy cursor-pointer"
          title="Vista de Tabla / Lista"
        >
          <List size={14} />
          <span class="hidden sm:inline">Tabla</span>
        </button>
      </div>
    </div>
  </div>
</div>
