---
import { Camera, FileCheck2, FileText, Image as ImageIcon, Save, ShieldAlert, ShieldCheck, Truck, UserCheck, Wrench, X } from 'lucide-astro'

interface Props {
  types: Array<{ id: number; nombre: string }>
  dependencias: Array<{ id: number; nombre: string; sigla: string | null }>
}

const { types, dependencias } = Astro.props
---

<div id="vehicle-form-modal" class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-navy/60 p-4 backdrop-blur-sm transition-opacity" style="display: none;">
  <div class="relative w-full max-w-4xl rounded-2xl bg-white shadow-2xl border border-line flex flex-col max-h-[92vh] overflow-hidden animate-in fade-in zoom-in-95 duration-200">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-line bg-paper px-6 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue text-white font-bold shadow-xs">
          <Truck size={20} />
        </div>
        <div>
          <h2 id="form-modal-title" class="font-display text-base font-bold text-navy">Registrar Nueva Unidad</h2>
          <p class="text-xs text-muted">Carga integral de datos técnicos, titularidad, Formulario 08 y documentación oficial.</p>
        </div>
      </div>
      <button
        type="button"
        id="close-form-modal"
        onclick="window.closeVehicleFormModal && window.closeVehicleFormModal()"
        class="rounded-lg p-2 text-muted hover:bg-sky hover:text-navy transition cursor-pointer"
        aria-label="Cerrar modal"
      >
        <X size={20} />
      </button>
    </div>

    <!-- Form Container -->
    <form id="vehicle-form" class="p-6 overflow-y-auto flex-1 space-y-6 text-xs">
      <input type="hidden" id="vehicle-id" name="id" value="" />

      <!-- SECCIÓN 1: IDENTIFICACIÓN BÁSICA, CARROCERÍA Y FOTO -->
      <div>
        <p class="font-bold text-navy uppercase tracking-wider text-[11px] mb-3 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sky text-blue text-[10px] font-bold">1</span>
          Identificación, Carrocería y Fotografía
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="font-bold text-muted block mb-1">Patente / Dominio *</label>
            <input
              type="text"
              id="form-patente"
              name="patente"
              required
              placeholder="AB 123 CD"
              class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-mono font-bold uppercase tracking-wider focus:border-blue focus:bg-white outline-none"
            />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Tipo de Vehículo *</label>
            <select id="form-tipo" name="tipoId" required class="w-full h-9 rounded-lg border border-line bg-paper px-2 focus:border-blue focus:bg-white outline-none">
              {types.map((t) => (
                <option value={t.id}>{t.nombre}</option>
              ))}
            </select>
          </div>
          <div id="form-group-estado" class="hidden sm:col-span-2">
            <label class="font-bold text-muted block mb-1">Estado Operativo (Solo edición)</label>
            <select id="form-estado" name="estado" class="w-full h-9 rounded-lg border border-line bg-paper px-2 focus:border-blue focus:bg-white outline-none">
              <option value="disponible">Disponible</option>
              <option value="en_comision">En comisión</option>
              <option value="en_taller">En taller</option>
              <option value="baja">Baja</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mt-3">
          <div>
            <label class="font-bold text-muted block mb-1">Marca *</label>
            <input type="text" id="form-marca" name="marca" required placeholder="Ej: Toyota" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Modelo *</label>
            <input type="text" id="form-modelo" name="modelo" required placeholder="Ej: Hilux" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Versión / Acabado</label>
            <input type="text" id="form-version" name="version" placeholder="Ej: DX 2.4 TDI 4x4" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Año Fabricación</label>
            <input type="number" id="form-anio" name="anio" min="1990" max="2030" placeholder="2022" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3">
          <div>
            <label class="font-bold text-muted block mb-1">Color de la Unidad</label>
            <input type="text" id="form-color" name="color" placeholder="Ej: Blanco Polar, Gris Plata, Rojo..." class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
          <div class="sm:col-span-2">
            <label class="font-bold text-muted block mb-1">URL de Foto / Imagen del Vehículo</label>
            <div class="flex gap-2">
              <input type="url" id="form-foto" name="fotoUrl" placeholder="https://ejemplo.com/fotos/hilux-blanca.jpg" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
              <button type="button" id="btn-preview-photo" class="h-9 px-3 rounded-lg border border-line bg-paper text-muted hover:text-navy hover:bg-sky flex items-center gap-1 transition" title="Ver imagen">
                <ImageIcon size={15} />
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 2: SITUACIÓN REGISTRAL Y TITULARIDAD ("NOMBRE AL QUE ESTÁ") -->
      <div class="pt-4 border-t border-line">
        <p class="font-bold text-navy uppercase tracking-wider text-[11px] mb-3 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sky text-blue text-[10px] font-bold">2</span>
          Titularidad y Registro Seccional
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="sm:col-span-2">
            <label class="font-bold text-muted block mb-1">Titular Registral (¿A nombre de quién está?)</label>
            <input
              type="text"
              id="form-titular-nombre"
              name="titularNombre"
              placeholder="Ej: Ministerio de Educación · Gob. de San Juan"
              class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-semibold focus:border-blue focus:bg-white outline-none"
            />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">CUIT / CUIL / DNI del Titular</label>
            <input
              type="text"
              id="form-titular-cuit"
              name="titularCuitCuil"
              placeholder="30-99901234-7"
              class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-mono focus:border-blue focus:bg-white outline-none"
            />
          </div>
        </div>
        <div class="mt-3">
          <label class="font-bold text-muted block mb-1">Registro Seccional / Radicación DNRPA</label>
          <input
            type="text"
            id="form-registro-seccional"
            name="registroSeccional"
            placeholder="Ej: Registro Seccional San Juan N° 1"
            class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none"
          />
        </div>
      </div>

      <!-- SECCIÓN 3: FORMULARIO 08 Y TRANSFERENCIA -->
      <div class="pt-4 border-t border-line">
        <p class="font-bold text-navy uppercase tracking-wider text-[11px] mb-3 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sky text-blue text-[10px] font-bold">3</span>
          Gestión de Formulario 08 y Transferencia
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <div>
            <label class="font-bold text-muted block mb-1">¿Cuenta con Formulario 08?</label>
            <select id="form-tiene-08" name="tiene08" class="w-full h-9 rounded-lg border border-line bg-paper px-2 font-bold focus:border-blue focus:bg-white outline-none">
              <option value="0">No / Ya Inscripto</option>
              <option value="1">Sí, posee 08</option>
            </select>
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Estado del 08 / Transferencia</label>
            <select id="form-estado-08" name="estado08" class="w-full h-9 rounded-lg border border-line bg-paper px-2 focus:border-blue focus:bg-white outline-none">
              <option value="no_aplica">No aplica</option>
              <option value="firmado">08 Firmado (Certificado)</option>
              <option value="en_tramite">En trámite de inscripción</option>
              <option value="pendiente_firma">Pendiente de firma</option>
              <option value="inscripto">Inscripto definitivo</option>
            </select>
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">N° Control / Oblea 08</label>
            <input
              type="text"
              id="form-numero-control-08"
              name="numeroControl08"
              placeholder="08-SJ-88921-A"
              class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-mono focus:border-blue focus:bg-white outline-none"
            />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Vencimiento Firmas 08</label>
            <input
              type="date"
              id="form-vencimiento-08"
              name="fechaVencimiento08"
              class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none"
            />
          </div>
        </div>
        <p class="text-[10px] text-muted mt-2">
          * Las firmas certificadas en un Formulario 08 suelen tener una validez legal determinada. Registrar la fecha permite emitir alertas preventivas antes de que caduquen.
        </p>
      </div>

      <!-- SECCIÓN 4: DOCUMENTACIÓN OFICIAL (CÉDULA, RTO Y SEGURO) -->
      <div class="pt-4 border-t border-line">
        <p class="font-bold text-navy uppercase tracking-wider text-[11px] mb-3 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sky text-blue text-[10px] font-bold">4</span>
          Documentación Oficial (Cédula, RTO y Póliza)
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <div>
            <label class="font-bold text-muted block mb-1">Número de Cédula</label>
            <input type="text" id="form-cedula" name="numeroCedula" placeholder="CV-09412356" class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-mono focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Vencimiento Cédula</label>
            <input type="date" id="form-cedula-venc" name="fechaVencimientoCedula" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Número de Certificado RTO</label>
            <input type="text" id="form-rto" name="numeroRto" placeholder="RTO-SJ-2024-8841" class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-mono focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Vencimiento RTO / VTV *</label>
            <input type="date" id="form-vtv" name="fechaVencimientoVtv" required class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3">
          <div>
            <label class="font-bold text-muted block mb-1">Compañía de Seguro</label>
            <input type="text" id="form-seguro-cia" name="companiaSeguro" placeholder="Nación Seguros" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Número de Póliza</label>
            <input type="text" id="form-seguro-poliza" name="numeroPoliza" placeholder="POL-784512-SJ" class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-mono focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Vencimiento de Seguro</label>
            <input type="date" id="form-seguro-venc" name="fechaVencimientoSeguro" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
        </div>
      </div>

      <!-- SECCIÓN 5: ESPECIFICACIONES TÉCNICAS Y ASIGNACIÓN -->
      <div class="pt-4 border-t border-line">
        <p class="font-bold text-navy uppercase tracking-wider text-[11px] mb-3 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-sky text-blue text-[10px] font-bold">5</span>
          Especificaciones Técnicas y Asignación
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <div>
            <label class="font-bold text-muted block mb-1">Odómetro Actual (km) *</label>
            <input type="number" id="form-odometro" name="odometroActual" required min="0" placeholder="45890" class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-bold focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Combustible</label>
            <select id="form-combustible" name="tipoCombustible" class="w-full h-9 rounded-lg border border-line bg-paper px-2 focus:border-blue focus:bg-white outline-none">
              <option value="diesel_grado_3">Diésel Grado 3 (Premium)</option>
              <option value="diesel_500">Diésel 500</option>
              <option value="nafta_super">Nafta Súper</option>
              <option value="nafta_premium">Nafta Premium</option>
              <option value="gnc">GNC</option>
              <option value="hibrido">Híbrido</option>
              <option value="electrico">Eléctrico</option>
            </select>
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Tanque (Litros)</label>
            <input type="number" id="form-tanque" name="capacidadTanqueLitros" min="10" max="500" placeholder="80" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Capacidad Pasajeros</label>
            <input type="number" id="form-pasajeros" name="capacidadPasajeros" min="1" max="60" placeholder="5" class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3">
          <div>
            <label class="font-bold text-muted block mb-1">Número de Chasis (VIN)</label>
            <input type="text" id="form-chasis" name="numeroChasis" placeholder="8AJHA3CD5M1001234" class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-mono focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Número de Motor</label>
            <input type="text" id="form-motor" name="numeroMotor" placeholder="2GD4567890" class="w-full h-9 rounded-lg border border-line bg-paper px-3 font-mono focus:border-blue focus:bg-white outline-none" />
          </div>
          <div>
            <label class="font-bold text-muted block mb-1">Dependencia Asignada</label>
            <select id="form-dependencia" name="dependenciaId" class="w-full h-9 rounded-lg border border-line bg-paper px-2 focus:border-blue focus:bg-white outline-none">
              <option value="">Sin asignación específica</option>
              {dependencias.map((d) => (
                <option value={d.id}>{d.nombre}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="mt-3">
          <label class="font-bold text-muted block mb-1">Observaciones y Detalles de Afectación</label>
          <textarea id="form-observaciones" name="observaciones" rows="2" placeholder="Detalles de afectación, accesorios instalados o notas..." class="w-full rounded-lg border border-line bg-paper p-3 focus:border-blue focus:bg-white outline-none"></textarea>
        </div>
      </div>

      <!-- Alerta de errores -->
      <div id="form-error" class="hidden rounded-lg bg-red-50 border border-red-200 p-3 text-red-700 text-xs font-semibold"></div>

      <!-- Form Footer -->
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-line">
        <button
          type="button"
          id="btn-cancel-form"
          onclick="window.closeVehicleFormModal && window.closeVehicleFormModal()"
          class="rounded-lg border border-line bg-white px-4 py-2 text-xs font-bold text-navy hover:bg-paper transition cursor-pointer"
        >
          Cancelar
        </button>
        <button type="submit" id="btn-submit-form" class="flex items-center gap-2 rounded-lg bg-blue px-5 py-2 text-xs font-bold text-white shadow-sm shadow-blue/20 hover:opacity-90 transition cursor-pointer">
          <Save size={15} />
          <span id="btn-submit-text">Guardar Vehículo</span>
        </button>
      </div>

    </form>
  </div>
</div>

<script is:inline>
  window.openVehicleCreateModal = function () {
    var modal = document.getElementById('vehicle-form-modal');
    var form = document.getElementById('vehicle-form');
    var formTitle = document.getElementById('form-modal-title');
    var submitText = document.getElementById('btn-submit-text');
    var idInput = document.getElementById('vehicle-id');
    var errorBox = document.getElementById('form-error');
    var estadoGroup = document.getElementById('form-group-estado');
    var estadoSelect = document.getElementById('form-estado');

    if (errorBox) {
      errorBox.textContent = '';
      errorBox.classList.add('hidden');
    }
    if (form) form.reset();
    if (idInput) idInput.value = '';
    if (estadoGroup) estadoGroup.classList.add('hidden');
    if (estadoSelect) estadoSelect.value = 'disponible';
    if (formTitle) formTitle.textContent = 'Registrar Nueva Unidad';
    if (submitText) submitText.textContent = 'Guardar Vehículo';
    if (modal) {
      modal.style.display = 'flex';
      modal.classList.remove('hidden');
    }
  };

  window.closeVehicleFormModal = function () {
    var modal = document.getElementById('vehicle-form-modal');
    if (modal) {
      modal.style.display = 'none';
    }
  };

  window.openVehicleEditModal = async function (id) {
    if (!id) return;
    var modal = document.getElementById('vehicle-form-modal');
    var form = document.getElementById('vehicle-form');
    var formTitle = document.getElementById('form-modal-title');
    var submitText = document.getElementById('btn-submit-text');
    var errorBox = document.getElementById('form-error');
    var estadoGroup = document.getElementById('form-group-estado');

    if (errorBox) {
      errorBox.textContent = '';
      errorBox.classList.add('hidden');
    }
    if (form) form.reset();
    if (estadoGroup) estadoGroup.classList.remove('hidden');

    try {
      var res = await fetch('/api/vehiculos?id=' + id);
      if (!res.ok) throw new Error('No se pudo cargar los datos de la unidad');
      var data = await res.json();
      var v = data.vehicle;
      if (!v) return;

      if (formTitle) formTitle.textContent = 'Editar Vehículo: ' + v.marca + ' ' + v.modelo;
      if (submitText) submitText.textContent = 'Actualizar Cambios';

      var setVal = function (elemId, value) {
        var el = document.getElementById(elemId);
        if (el && value != null) el.value = String(value);
      };

      setVal('vehicle-id', v.id);
      setVal('form-patente', v.patente);
      setVal('form-tipo', v.tipoId);
      setVal('form-estado', v.estado);
      setVal('form-marca', v.marca);
      setVal('form-modelo', v.modelo);
      setVal('form-version', v.version || '');
      setVal('form-anio', v.anio || '');
      setVal('form-color', v.color || '');
      setVal('form-foto', v.fotoUrl || '');
      setVal('form-titular-nombre', v.titularNombre || '');
      setVal('form-titular-cuit', v.titularCuitCuil || '');
      setVal('form-registro-seccional', v.registroSeccional || '');
      setVal('form-tiene-08', v.tiene08 ? '1' : '0');
      setVal('form-estado-08', v.estado08 || 'no_aplica');
      setVal('form-numero-control-08', v.numeroControl08 || '');
      setVal('form-vencimiento-08', v.fechaVencimiento08 ? v.fechaVencimiento08.split('T')[0] : '');
      setVal('form-cedula', v.numeroCedula || '');
      setVal('form-cedula-venc', v.fechaVencimientoCedula ? v.fechaVencimientoCedula.split('T')[0] : '');
      setVal('form-rto', v.numeroRto || '');
      setVal('form-vtv', v.fechaVencimientoVtv ? v.fechaVencimientoVtv.split('T')[0] : '');
      setVal('form-seguro-cia', v.companiaSeguro || '');
      setVal('form-seguro-poliza', v.numeroPoliza || '');
      setVal('form-seguro-venc', v.fechaVencimientoSeguro ? v.fechaVencimientoSeguro.split('T')[0] : '');
      setVal('form-odometro', v.odometroActual);
      setVal('form-combustible', v.tipoCombustible);
      setVal('form-tanque', v.capacidadTanqueLitros || '');
      setVal('form-pasajeros', v.capacidadPasajeros || 5);
      setVal('form-chasis', v.numeroChasis || '');
      setVal('form-motor', v.numeroMotor || '');
      setVal('form-dependencia', v.dependenciaId || '');
      setVal('form-observaciones', v.observaciones || '');

      if (modal) {
        modal.style.display = 'flex';
        modal.classList.remove('hidden');
      }
    } catch (err) {
      alert('Error al abrir editor de vehículo: ' + (err.message || err));
    }
  };

  // Click en backdrop
  document.getElementById('vehicle-form-modal')?.addEventListener('click', function (e) {
    if (e.target === this) window.closeVehicleFormModal();
  });

  // Previsualizador de foto
  document.getElementById('btn-preview-photo')?.addEventListener('click', function () {
    var fotoInput = document.getElementById('form-foto');
    if (fotoInput && fotoInput.value) {
      window.open(fotoInput.value, '_blank');
    } else {
      alert('Ingresa primero una URL de imagen válida en el campo.');
    }
  });

  // Envío del formulario
  document.getElementById('vehicle-form')?.addEventListener('submit', async function (e) {
    e.preventDefault();
    var form = this;
    var errorBox = document.getElementById('form-error');
    var submitBtn = document.getElementById('btn-submit-form');
    if (errorBox) errorBox.classList.add('hidden');
    if (submitBtn) submitBtn.disabled = true;

    var formData = new FormData(form);
    var payload = {
      patente: formData.get('patente'),
      tipoId: Number(formData.get('tipoId')),
      estado: formData.get('estado') || 'disponible',
      marca: formData.get('marca'),
      modelo: formData.get('modelo'),
      version: formData.get('version') || null,
      anio: formData.get('anio') ? Number(formData.get('anio')) : null,
      color: formData.get('color') || null,
      fotoUrl: formData.get('fotoUrl') || null,

      // Situación registral y titularidad
      titularNombre: formData.get('titularNombre') || null,
      titularCuitCuil: formData.get('titularCuitCuil') || null,
      registroSeccional: formData.get('registroSeccional') || null,

      // Formulario 08
      tiene08: formData.get('tiene08') === '1',
      estado08: formData.get('estado08') || 'no_aplica',
      numeroControl08: formData.get('numeroControl08') || null,
      fechaVencimiento08: formData.get('fechaVencimiento08') || null,

      // Documentación
      numeroCedula: formData.get('numeroCedula') || null,
      fechaVencimientoCedula: formData.get('fechaVencimientoCedula') || null,
      numeroRto: formData.get('numeroRto') || null,
      fechaVencimientoVtv: formData.get('fechaVencimientoVtv'),
      companiaSeguro: formData.get('companiaSeguro') || null,
      numeroPoliza: formData.get('numeroPoliza') || null,
      fechaVencimientoSeguro: formData.get('fechaVencimientoSeguro') || null,

      // Mecánica y logística
      odometroActual: Number(formData.get('odometroActual') || 0),
      tipoCombustible: formData.get('tipoCombustible'),
      capacidadTanqueLitros: formData.get('capacidadTanqueLitros') ? Number(formData.get('capacidadTanqueLitros')) : null,
      capacidadPasajeros: formData.get('capacidadPasajeros') ? Number(formData.get('capacidadPasajeros')) : 5,
      numeroChasis: formData.get('numeroChasis') || null,
      numeroMotor: formData.get('numeroMotor') || null,
      dependenciaId: formData.get('dependenciaId') ? Number(formData.get('dependenciaId')) : null,
      observaciones: formData.get('observaciones') || null,
    };

    var id = formData.get('id');
    if (id) payload.id = Number(id);

    try {
      var res = await fetch('/api/vehiculos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      var data = await res.json();
      if (!res.ok || data.error) {
        throw new Error(data.error || 'Error al guardar el vehículo');
      }

      window.location.reload();
    } catch (err) {
      if (errorBox) {
        errorBox.textContent = err.message || 'Error al procesar la solicitud';
        errorBox.classList.remove('hidden');
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
