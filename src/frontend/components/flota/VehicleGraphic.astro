---
interface Props {
  tipoNombre?: string
  fotoUrl?: string | null
  color?: string | null
  marca?: string
  modelo?: string
  className?: string
}

const {
  tipoNombre = 'Camioneta',
  fotoUrl = null,
  color = null,
  marca = '',
  modelo = '',
  className = 'h-36 w-full',
} = Astro.props

const normalizedTipo = (tipoNombre || '').toLowerCase()

let defaultPhoto = '/vehiculos/camioneta.png'
if (normalizedTipo.includes('auto') || normalizedTipo.includes('sedan')) {
  defaultPhoto = '/vehiculos/auto.png'
} else if (normalizedTipo.includes('suv') || normalizedTipo.includes('utilitario') || normalizedTipo.includes('furgon')) {
  defaultPhoto = '/vehiculos/suv.png'
} else if (normalizedTipo.includes('combi') || normalizedTipo.includes('minibus') || normalizedTipo.includes('bus')) {
  defaultPhoto = '/vehiculos/combi.png'
} else if (normalizedTipo.includes('camion') && !normalizedTipo.includes('camioneta')) {
  defaultPhoto = '/vehiculos/camion.png'
} else {
  defaultPhoto = '/vehiculos/camioneta.png'
}

const activeImageUrl = fotoUrl || defaultPhoto
---

<div class={`relative flex items-center justify-center overflow-hidden rounded-xl bg-gradient-to-b from-[#f8fafc] to-[#eef2f6] p-4 select-none ${className}`}>
  <!-- Sombra de suelo suave y elegante para asentar el vehículo -->
  <div class="pointer-events-none absolute bottom-2.5 h-3 w-4/5 max-w-[85%] rounded-[100%] bg-slate-900/15 blur-[4px] transition-transform duration-300 group-hover:scale-95 group-hover:opacity-75"></div>

  <img
    src={activeImageUrl}
    alt={`${marca} ${modelo} - ${tipoNombre}`}
    class="relative z-10 h-full w-full object-contain drop-shadow-sm transition-transform duration-300 group-hover:scale-105"
    loading="lazy"
    onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
  />

  <div class="w-full h-full flex items-center justify-center hidden">
    {normalizedTipo.includes('utilitario') || normalizedTipo.includes('furgon') ? (
