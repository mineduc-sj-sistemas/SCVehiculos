---
import {
  AlertTriangle,
  Calendar,
  Clock,
  MapPin,
  Pencil,
  Save,
  Send,
  Users,
  X,
} from 'lucide-astro'
import type { DatosAuxiliaresDespacho } from '../../types/cronograma.types'

interface Props {
  datosAuxiliares: DatosAuxiliaresDespacho
}

const { datosAuxiliares } = Astro.props

const DEPARTAMENTOS_SAN_JUAN = [
  'Capital',
  'Rawson',
  'Rivadavia',
  'Chimbas',
  'Santa Lucía',
  'Pocito',
  'Albardón',
  'Angaco',
  'Caucete',
  '9 de Julio',
  'San Martín',
  '25 de Mayo',
  'Sarmiento',
  'Ullum',
  'Zonda',
  'Calingasta',
  'Iglesia',
  'Jáchal',
  'Valle Fértil',
  'Fuera de la Provincia',
]
---

<div
  id="modal-dispatch"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-dispatch-title"
>
  <div class="relative w-full max-w-2xl rounded-2xl bg-white shadow-2xl overflow-hidden flex flex-col max-h-[90vh] animate-in fade-in zoom-in-95">
    <!-- Cabecera del Modal -->
    <div class="flex items-center justify-between border-b border-gray-100 bg-navy px-6 py-4 text-white">
      <div class="flex items-center gap-2.5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gold text-navy shadow-sm">
          <Send size={18} strokeWidth={2.5} id="dispatch-header-icon-send" />
          <Pencil size={18} strokeWidth={2.5} id="dispatch-header-icon-edit" class="hidden" />
        </div>
        <div>
          <h3 id="modal-dispatch-title" class="font-display text-base font-bold">
            Despachar Nueva Comisión Oficial
          </h3>
          <p id="modal-dispatch-subtitle" class="text-[11px] text-white/60">Asignación de móvil, conductor y hoja de ruta ministerial</p>
        </div>
      </div>
      <button
        id="btn-close-dispatch-modal"
        type="button"
        class="flex h-8 w-8 items-center justify-center rounded-lg text-white/70 hover:bg-white/10 hover:text-white transition cursor-pointer"
        aria-label="Cerrar modal"
      >
        <X size={18} />
      </button>
    </div>

    <!-- Formulario de Despacho -->
    <form id="form-dispatch" class="overflow-y-auto p-6 space-y-4">
      <input type="hidden" id="dispatch-comision-id" name="comisionId" value="" />
      <div id="dispatch-error-msg" class="hidden rounded-xl bg-red-50 border border-red-200 p-3 text-xs text-red-700 flex items-center gap-2">
        <AlertTriangle size={16} class="shrink-0" />
        <span id="dispatch-error-text">Ocurrió un error al guardar.</span>
      </div>

      <!-- Fila 1: Móvil y Chofer -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Móvil / Vehículo -->
        <div>
          <label for="dispatch-vehiculo" class="block text-xs font-bold text-navy mb-1">
            Vehículo / Móvil Oficial *
          </label>
          <select
            id="dispatch-vehiculo"
            name="vehiculoId"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs font-semibold text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          >
            <option value="">-- Seleccionar Movilidad --</option>
            {datosAuxiliares.vehiculos.map((v) => (
              <option
                value={v.id}
                disabled={v.estado === 'en_taller'}
                data-patente={v.patente}
              >
                {v.patente} - {v.marca} {v.modelo} ({v.capacidadPasajeros} pas.){v.estado === 'en_taller' ? ' [EN TALLER]' : ''}
              </option>
            ))}
          </select>
        </div>

        <!-- Chofer Oficial -->
        <div>
          <label for="dispatch-chofer" class="block text-xs font-bold text-navy mb-1">
            Chofer Oficial *
          </label>
          <select
            id="dispatch-chofer"
            name="choferId"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs font-semibold text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          >
            <option value="">-- Seleccionar Chofer --</option>
            {datosAuxiliares.choferes.map((c) => (
              <option
                value={c.id}
                disabled={c.estado === 'licencia' || c.licenciaVencida}
              >
                {c.apellido}, {c.nombre} (Cat. {c.categoriaLicencia || 'N/A'}){c.licenciaVencida ? ' [CARNET VENCIDO]' : c.estado === 'licencia' ? ' [LICENCIA]' : ''}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Fila 2: Dependencia y Solicitante -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Dependencia Solicitante -->
        <div>
          <label for="dispatch-dependencia" class="block text-xs font-bold text-navy mb-1">
            Dependencia Solicitante *
          </label>
          <select
            id="dispatch-dependencia"
            name="dependenciaId"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs font-semibold text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          >
            <option value="">-- Seleccionar Área / Dirección --</option>
            {datosAuxiliares.dependencias.map((d) => (
              <option value={d.id}>{d.nombre}</option>
            ))}
          </select>
        </div>

        <!-- Responsable / Solicitante -->
        <div>
          <label for="dispatch-solicitante" class="block text-xs font-bold text-navy mb-1">
            Funcionario o Solicitante Responsable
          </label>
          <input
            type="text"
            id="dispatch-solicitante"
            name="solicitanteNombre"
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          />
        </div>
      </div>

      <!-- Fila 3: Origen y Destino Departamental -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Origen -->
        <div>
          <label for="dispatch-origen" class="block text-xs font-bold text-navy mb-1">
            Lugar de Salida (Origen) *
          </label>
          <input
            type="text"
            id="dispatch-origen"
            name="origen"
            value="Ministerio de Educación - Centro Cívico"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          />
        </div>

        <!-- Departamento de San Juan -->
        <div>
          <label for="dispatch-depto" class="block text-xs font-bold text-navy mb-1">
            Departamento de San Juan (Destino) *
          </label>
          <select
            id="dispatch-depto"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs font-semibold text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          >
            <option value="">-- Seleccionar Departamento --</option>
            {DEPARTAMENTOS_SAN_JUAN.map((depto) => (
              <option value={depto}>{depto}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Destino Específico / Establecimiento -->
      <div>
        <label for="dispatch-destino" class="block text-xs font-bold text-navy mb-1">
          Destino Detallado / Escuela / Localidad *
        </label>
        <div class="relative">
          <MapPin size={15} class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
          <input
            type="text"
            id="dispatch-destino"
            name="destino"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 py-2 pl-9 pr-3 text-xs text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          />
        </div>
      </div>

      <!-- Fila 4: Fechas y Horas Programadas -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Salida Programada -->
        <div>
          <label for="dispatch-salida" class="block text-xs font-bold text-navy mb-1">
            Fecha y Hora de Salida *
          </label>
          <input
            type="datetime-local"
            id="dispatch-salida"
            name="fechaSalidaProgramada"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          />
        </div>

        <!-- Regreso Estimado -->
        <div>
          <label for="dispatch-regreso" class="block text-xs font-bold text-navy mb-1">
            Fecha y Hora de Regreso Estimada *
          </label>
          <input
            type="datetime-local"
            id="dispatch-regreso"
            name="fechaRegresoEstimada"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          />
        </div>
      </div>

      <!-- Fila 5: Pasajeros y Motivo -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <!-- Cantidad de Pasajeros -->
        <div>
          <label for="dispatch-pasajeros" class="block text-xs font-bold text-navy mb-1">
            Pasajeros Previstos *
          </label>
          <div class="relative">
            <Users size={15} class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
            <input
              type="number"
              id="dispatch-pasajeros"
              name="cantidadPasajeros"
              value="1"
              min="1"
              max="30"
              required
              class="w-full rounded-lg border border-gray-200 bg-gray-50/40 py-2 pl-9 pr-3 text-xs text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
            />
          </div>
        </div>

        <!-- Motivo / Objeto de la Comisión -->
        <div class="sm:col-span-2">
          <label for="dispatch-motivo" class="block text-xs font-bold text-navy mb-1">
            Motivo / Misión Oficial *
          </label>
          <input
            type="text"
            id="dispatch-motivo"
            name="motivo"
            required
            class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
          />
        </div>
      </div>

      <!-- Observaciones -->
      <div>
        <label for="dispatch-observaciones" class="block text-xs font-bold text-navy mb-1">
          Observaciones Adicionales
        </label>
        <textarea
          id="dispatch-observaciones"
          name="observaciones"
          rows="2"
          class="w-full rounded-lg border border-gray-200 bg-gray-50/40 px-3 py-2 text-xs text-navy focus:border-blue focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue transition"
        ></textarea>
      </div>

      <!-- Botones de Acción -->
      <div class="flex items-center justify-end gap-3 pt-3 border-t border-gray-100">
        <button
          type="button"
          id="btn-cancel-dispatch"
          class="rounded-xl border border-gray-200 px-4 py-2 text-xs font-bold text-gray-600 hover:bg-gray-100 transition cursor-pointer"
        >
          Cancelar
        </button>

        <button
          type="submit"
          id="btn-submit-dispatch"
          class="flex items-center gap-2 rounded-xl bg-blue px-5 py-2 text-xs font-bold text-white shadow-sm shadow-blue/20 hover:opacity-95 transition cursor-pointer disabled:opacity-50"
        >
          <Send size={14} id="btn-submit-icon-send" />
          <Save size={14} id="btn-submit-icon-save" class="hidden" />
          <span id="btn-submit-dispatch-text">Generar Despacho</span>
        </button>
      </div>
    </form>
  </div>
</div>
