---
import {
  AlertCircle,
  Calendar,
  CalendarDays,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  Clock,
  Plus,
  Truck,
} from 'lucide-astro'
import type { CronogramaStats } from '../../types/cronograma.types'

interface Props {
  stats: CronogramaStats
  rangoLabel: string
  fechaInicio: string
}

const { stats, rangoLabel, fechaInicio } = Astro.props
---

<div class="mb-6 space-y-6">
  <!-- Barra de Título y Navegación de Semanas -->
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-blue mb-1">
        <span>Ministerio de Educación</span>
        <span>·</span>
        <span>Planificación de Movilidades y Hojas de Ruta</span>
      </div>
      <h2 class="font-display text-2xl sm:text-[28px] font-bold tracking-tight text-navy">
        Cronograma Semanal de Despacho
      </h2>
      <p class="mt-0.5 text-xs text-muted">
        Asignación de movilidades oficiales, seguimiento de comisiones interdepartamentales y control de viajes.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- Navegador de Semana -->
      <div
        id="cronograma-nav-group"
        data-fecha-inicio={fechaInicio}
        class="flex items-center rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800/90 p-1 shadow-sm transition-all"
      >
        <button
          type="button"
          id="btn-semana-prev"
          class="flex h-9 w-9 items-center justify-center rounded-lg text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700 hover:text-navy dark:hover:text-white transition cursor-pointer active:scale-95"
          title="Semana anterior (7 días antes)"
          aria-label="Semana anterior"
        >
          <ChevronLeft size={18} strokeWidth={2.5} />
        </button>

        <button
          type="button"
          id="btn-semana-hoy"
          class="px-3.5 py-1.5 text-xs font-bold text-navy dark:text-slate-200 hover:bg-blue/10 dark:hover:bg-blue/20 hover:text-blue dark:hover:text-orange-400 rounded-lg transition cursor-pointer flex items-center gap-1.5 active:scale-95"
          title="Ir a la semana actual"
        >
          <Calendar size={14} class="text-blue" />
          <span id="label-btn-hoy">Esta semana</span>
        </button>

        <button
          type="button"
          id="btn-semana-next"
          class="flex h-9 w-9 items-center justify-center rounded-lg text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700 hover:text-navy dark:hover:text-white transition cursor-pointer active:scale-95"
          title="Semana siguiente (7 días después)"
          aria-label="Semana siguiente"
        >
          <ChevronRight size={18} strokeWidth={2.5} />
        </button>

        <div class="h-5 w-px bg-gray-200 dark:bg-slate-700 mx-1.5"></div>

        <!-- Botón Selector de Fecha con Flatpickr -->
        <div class="relative flex items-center">
          <button
            type="button"
            id="btn-open-datepicker"
            class="flex items-center gap-1.5 rounded-lg bg-blue/5 dark:bg-orangeGov/15 hover:bg-blue/10 dark:hover:bg-orangeGov/25 px-3 py-1.5 text-xs font-bold text-blue dark:text-orange-400 hover:text-blue transition cursor-pointer border border-blue/20 dark:border-orangeGov/40 active:scale-95"
            title="Seleccionar una fecha en el calendario"
          >
            <CalendarDays size={15} class="text-blue shrink-0" />
            <span id="label-ir-a-fecha">Ir a fecha</span>
          </button>
          <input
            type="text"
            id="input-fecha-picker"
            value={fechaInicio}
            class="absolute inset-0 opacity-0 pointer-events-none"
            aria-hidden="true"
            tabindex="-1"
          />
        </div>
      </div>

      <!-- Botón Nueva Comisión -->
      <button
        id="btn-abrir-nueva-comision"
        class="flex items-center gap-2 rounded-xl bg-blue px-4 py-2.5 text-xs font-bold text-white shadow-sm shadow-blue/20 hover:opacity-95 transition cursor-pointer active:scale-98"
      >
        <Plus size={16} strokeWidth={2.5} />
        <span>Despachar Comisión</span>
      </button>
    </div>
  </div>

  <!-- Indicador del Rango Activo -->
  <div class="flex items-center justify-between rounded-xl bg-navy/5 dark:bg-slate-800/50 border border-navy/10 dark:border-slate-700/60 px-4 py-2.5 text-xs">
    <div class="flex items-center gap-2 text-navy dark:text-slate-200 font-medium">
      <CalendarDays size={16} class="text-blue" />
      <span>Semana activa:</span>
      <span class="font-bold text-navy dark:text-white text-sm" id="label-semana-activa">{rangoLabel}</span>
    </div>
    <span class="hidden sm:inline-block text-[11px] text-muted dark:text-slate-400">
      Planilla digital sincronizada con base de datos ministerial
    </span>
  </div>

  <!-- Tarjetas KPI Rápidas de la Semana -->
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
    <!-- Comisiones Totales -->
    <div class="rounded-xl border border-gray-200 dark:border-slate-800 border-l-4 border-l-orangeGov bg-white dark:bg-[#15191f] p-4 shadow-sm transition-all hover:shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-muted dark:text-slate-300">Comisiones Semana</span>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-orange-50 dark:bg-orange-950/40 text-orangeGov dark:text-orange-400">
          <Calendar size={16} />
        </div>
      </div>
      <p class="mt-2 text-2xl font-bold tracking-tight text-navy dark:text-white" id="kpi-total-semana">
        {stats.totalComisionesSemana}
      </p>
      <p class="mt-0.5 text-[11px] text-muted dark:text-slate-400">Total asignadas en la semana</p>
    </div>

    <!-- En Curso Hoy -->
    <div class="rounded-xl border border-amber-200 dark:border-amber-500/30 border-l-4 border-l-amber-500 bg-amber-50/50 dark:bg-amber-950/20 p-4 shadow-sm transition-all hover:shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-amber-800 dark:text-amber-300">En Ruta Hoy</span>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 border dark:border-amber-700/40">
          <AlertCircle size={16} />
        </div>
      </div>
      <p class="mt-2 text-2xl font-bold tracking-tight text-amber-900 dark:text-amber-300" id="kpi-en-curso">
        {stats.enCursoHoy}
      </p>
      <p class="mt-0.5 text-[11px] text-amber-700 dark:text-amber-200/80">Vehículos transitando ahora</p>
    </div>

    <!-- Programadas -->
    <div class="rounded-xl border border-orange-200 dark:border-orange-500/30 border-l-4 border-l-orange-500 bg-orange-50/40 dark:bg-orange-950/20 p-4 shadow-sm transition-all hover:shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-orange-800 dark:text-orange-300">Programadas</span>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-orange-100 dark:bg-orange-900/40 text-orangeGov dark:text-orange-400 border dark:border-orange-700/40">
          <Clock size={16} />
        </div>
      </div>
      <p class="mt-2 text-2xl font-bold tracking-tight text-orange-950 dark:text-orange-300" id="kpi-programadas">
        {stats.programadasSemana}
      </p>
      <p class="mt-0.5 text-[11px] text-orange-700 dark:text-orange-200/80">Listas para salir</p>
    </div>

    <!-- Flota Operativa -->
    <div class="rounded-xl border border-emerald-200 dark:border-emerald-500/30 border-l-4 border-l-emerald-500 bg-emerald-50/40 dark:bg-emerald-950/20 p-4 shadow-sm transition-all hover:shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">Móviles Asignados</span>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 border dark:border-emerald-700/40">
          <Truck size={16} />
        </div>
      </div>
      <p class="mt-2 text-2xl font-bold tracking-tight text-emerald-950 dark:text-emerald-300" id="kpi-moviles">
        {stats.vehiculosAsignadosSemana} <span class="text-xs font-normal text-muted dark:text-slate-400">/ {stats.vehiculosOperativos} disp.</span>
      </p>
      <p class="mt-0.5 text-[11px] text-emerald-700 dark:text-emerald-200/80">Móviles con servicios asignados</p>
    </div>
  </div>
</div>
