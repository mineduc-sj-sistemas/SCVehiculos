---
import { Filter, Search } from 'lucide-astro'

interface Props {
  categorias: string[]
}

const { categorias = ['B1', 'B2', 'C1', 'D1'] } = Astro.props
---

<div class="card p-4 mb-6">
  <div class="flex flex-col md:flex-row items-center justify-between gap-3">
    <!-- Buscador de Choferes -->
    <div class="relative w-full md:w-80">
      <Search size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
      <input
        id="filter-search"
        type="text"
        placeholder="Buscar por nombre, apellido, DNI o carnet..."
        class="h-9 w-full rounded-lg border border-line bg-paper pl-9 pr-3 text-xs outline-none focus:border-blue focus:bg-white transition"
      />
    </div>

    <!-- Filtros desplegables -->
    <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
      <div class="flex items-center gap-1.5 text-xs text-muted">
        <Filter size={14} />
        <span class="font-bold text-[11px] uppercase">Filtros:</span>
      </div>

      <!-- Filtro de Estado -->
      <select id="filter-estado" class="h-9 rounded-lg border border-line bg-paper px-2.5 text-xs outline-none focus:border-blue focus:bg-white transition cursor-pointer">
        <option value="">Estado: Todos</option>
        <option value="disponible">Disponibles</option>
        <option value="en_comision">En comisión</option>
        <option value="licencia">De licencia</option>
      </select>

      <!-- Filtro de Categoría de Carnet -->
      <select id="filter-categoria" class="h-9 rounded-lg border border-line bg-paper px-2.5 text-xs outline-none focus:border-blue focus:bg-white transition cursor-pointer">
        <option value="">Categoría: Todas</option>
        {categorias.map((cat) => (
          <option value={cat}>{cat}</option>
        ))}
      </select>

      <!-- Botón Limpiar -->
      <button id="btn-clear-filters" class="h-9 rounded-lg border border-line bg-white px-3 text-xs font-semibold text-muted hover:text-navy hover:bg-paper transition cursor-pointer">
        Limpiar
      </button>
    </div>
  </div>
</div>
