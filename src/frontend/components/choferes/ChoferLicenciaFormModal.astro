---
import { Calendar, Save, X } from 'lucide-astro'
---

<div id="chofer-licencia-modal" class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-navy/60 p-4 backdrop-blur-sm transition-opacity" style="display: none;">
  <div class="relative w-full max-w-lg rounded-2xl bg-white shadow-2xl border border-line flex flex-col max-h-[90vh] overflow-hidden animate-in fade-in zoom-in-95 duration-200">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-line bg-paper px-6 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500 text-white font-bold shadow-xs">
          <Calendar size={20} />
        </div>
        <div>
          <h2 class="font-display text-base font-bold text-navy">Registrar Licencia / Ausencia</h2>
          <p id="licencia-modal-chofer-nombre" class="text-xs text-blue font-semibold">Chofer: Seleccionado</p>
        </div>
      </div>
      <button id="close-chofer-licencia-modal" class="rounded-lg p-2 text-muted hover:bg-sky hover:text-navy transition cursor-pointer" aria-label="Cerrar modal">
        <X size={20} />
      </button>
    </div>

    <!-- Form Container -->
    <form id="chofer-licencia-form" autocomplete="off" class="p-6 overflow-y-auto overflow-x-hidden flex-1 space-y-4 text-xs">
      <input type="hidden" id="licencia-chofer-id" name="choferId" value="" />

      <!-- Tipo de Licencia -->
      <div>
        <label class="font-bold text-muted block mb-1">Tipo de Ausencia / Licencia *</label>
        <select
          id="licencia-tipo"
          name="tipo"
          required
          class="w-full h-9 rounded-lg border border-line bg-paper px-2.5 focus:border-blue focus:bg-white outline-none cursor-pointer font-semibold text-navy"
        >
          <option value="franco_compensatorio">Franco Compensatorio (por viajes en fin de semana)</option>
          <option value="vacaciones">Licencia Anual Ordinaria (Vacaciones)</option>
          <option value="enfermedad">Licencia por Enfermedad / Médica</option>
          <option value="particular">Asunto Particular (Trámites / Personales)</option>
          <option value="capacitacion">Capacitación Oficial / Seguridad Vial</option>
          <option value="otra">Otro Motivo</option>
        </select>
      </div>

      <!-- Fechas Inicio y Fin -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="font-bold text-muted block mb-1">Fecha de Inicio *</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-muted">
              <Calendar size={15} />
            </div>
            <input
              type="text"
              id="licencia-fecha-inicio"
              name="fechaInicio"
              readonly
              autocomplete="off"
              data-lpignore="true"
              data-form-type="other"
              required
              class="w-full h-9 rounded-lg border border-line bg-paper pl-8 pr-3 text-xs font-semibold text-navy focus:border-blue focus:bg-white outline-none cursor-pointer"
            />
          </div>
        </div>
        <div>
          <label class="font-bold text-muted block mb-1">Fecha de Fin *</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-muted">
              <Calendar size={15} />
            </div>
            <input
              type="text"
              id="licencia-fecha-fin"
              name="fechaFin"
              readonly
              autocomplete="off"
              data-lpignore="true"
              data-form-type="other"
              required
              class="w-full h-9 rounded-lg border border-line bg-paper pl-8 pr-3 text-xs font-semibold text-navy focus:border-blue focus:bg-white outline-none cursor-pointer"
            />
          </div>
        </div>
      </div>

      <!-- Motivo / Justificación -->
      <div>
        <label class="font-bold text-muted block mb-1">Motivo / Justificación</label>
        <input
          type="text"
          id="licencia-motivo"
          name="motivo"
          class="w-full h-9 rounded-lg border border-line bg-paper px-3 focus:border-blue focus:bg-white outline-none"
        />
      </div>

      <!-- Observaciones / Autorización -->
      <div>
        <label class="font-bold text-muted block mb-1">Observaciones / Constancia</label>
        <textarea
          id="licencia-observaciones"
          name="observaciones"
          rows="2"
          class="w-full rounded-lg border border-line bg-paper p-2.5 focus:border-blue focus:bg-white outline-none"
        ></textarea>
      </div>

      <!-- Mensaje de error/estado -->
      <div id="chofer-licencia-alert" class="hidden rounded-lg p-3 text-xs font-semibold"></div>

      <!-- Footer Buttons -->
      <div class="flex items-center justify-end gap-3 pt-3 border-t border-line">
        <button
          type="button"
          id="btn-cancel-licencia-form"
          class="rounded-lg border border-line bg-white px-4 py-2 text-xs font-bold text-muted hover:text-navy hover:bg-paper transition cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="btn-submit-licencia"
          class="flex items-center gap-2 rounded-lg bg-blue px-5 py-2 text-xs font-bold text-white shadow-sm shadow-blue/20 hover:opacity-90 transition cursor-pointer"
        >
          <Save size={15} />
          <span>Registrar Ausencia</span>
        </button>
      </div>
    </form>

  </div>
</div>
