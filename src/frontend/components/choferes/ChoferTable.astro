---
import { Calendar, Edit3, Eye, FileBadge, Phone, Route, User } from 'lucide-astro'
import StatusBadge from '../ui/StatusBadge.astro'
import type { ChoferFull } from '../../../backend/types'

interface Props {
  choferes: ChoferFull[]
}

const { choferes } = Astro.props
---

<section class="card overflow-hidden shadow-sm">
  <div class="flex items-center justify-between border-b border-line px-6 py-4">
    <div>
      <h3 class="font-display text-base font-bold text-navy">Conductores Oficiales</h3>
      <p class="text-xs text-muted">
        Mostrando <span id="visible-count" class="font-bold text-navy">{choferes.length}</span> de {choferes.length} choferes registrados
      </p>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[950px] text-left text-xs">
      <thead>
        <tr class="border-b border-line bg-paper text-[10px] font-bold uppercase tracking-wider text-muted">
          <th class="px-5 py-3.5">Conductor</th>
          <th class="px-3 py-3.5">DNI / CUIL</th>
          <th class="px-3 py-3.5">Licencia / Cat.</th>
          <th class="px-3 py-3.5">Vigencia Carnet</th>
          <th class="px-3 py-3.5">Estado</th>
          <th class="px-3 py-3.5">Contacto</th>
          <th class="px-3 py-3.5">Actividad</th>
          <th class="px-5 py-3.5 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody id="choferes-table-body" class="divide-y divide-line">
        {choferes.map((c) => (
          <tr
            class="chofer-row hover:bg-paper/60 transition group"
            data-id={c.id}
            data-nombre={c.nombre.toLowerCase()}
            data-apellido={c.apellido.toLowerCase()}
            data-dni={c.dni.toLowerCase()}
            data-licencia={c.numeroLicencia.toLowerCase()}
            data-categoria={c.categoriaLicencia}
            data-estado={c.estado}
            data-direccion={(c.direccion || '').toLowerCase()}
          >
            <!-- Conductor (Foto / Avatar + Nombre) -->
            <td class="px-5 py-3.5 whitespace-nowrap">
              <div class="flex items-center gap-3">
                {c.fotoUrl ? (
                  <img
                    src={c.fotoUrl}
                    alt={c.nombreCompleto}
                    class="h-10 w-10 shrink-0 rounded-xl object-cover border border-line shadow-2xs"
                  />
                ) : (
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky font-display text-xs font-bold text-blue shadow-2xs group-hover:bg-blue group-hover:text-white transition">
                    {c.iniciales}
                  </div>
                )}
                <div>
                  <p class="font-bold text-navy text-[13px]">{c.apellido}, {c.nombre}</p>
                  <div class="flex items-center gap-1.5 mt-0.5">
                    <span class="text-[10px] text-muted">{c.direccion || 'San Juan'}</span>
                    {c.usuarioId ? (
                      <span class="inline-flex items-center gap-0.5 text-[9px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-1 py-0.2 rounded" title="Cuenta de usuario vinculada">
                        ✓ Con usuario
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-0.5 text-[9px] font-semibold text-slate-500 bg-slate-100 border border-slate-200 px-1 py-0.2 rounded" title="Sin cuenta de usuario">
                        Sin usuario
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </td>

            <!-- DNI / CUIL -->
            <td class="px-3 py-3.5 whitespace-nowrap">
              <p class="font-mono text-xs font-semibold text-navy">{c.dni}</p>
              <p class="text-[10px] text-muted font-mono">{c.cuil || 'S/D'}</p>
            </td>

            <!-- Licencia y Categoría -->
            <td class="px-3 py-3.5 whitespace-nowrap">
              <div class="flex items-center gap-1.5">
                <span class="rounded bg-sky/80 px-1.5 py-0.5 font-mono text-[11px] font-bold text-blue">
                  Cat. {c.categoriaLicencia}
                </span>
                <span class="font-mono text-xs font-semibold text-navy">
                  {c.numeroLicencia}
                </span>
              </div>
            </td>

            <!-- Vigencia Carnet con Semáforo -->
            <td class="px-3 py-3.5 whitespace-nowrap">
              <div class="flex items-center gap-1.5">
                {c.licenciaStatus === 'vigente' && <span class="h-2 w-2 rounded-full bg-emerald-600" title="Vigente" />}
                {c.licenciaStatus === 'proxima' && <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse" title="Próxima a vencer (≤ 30 días)" />}
                {c.licenciaStatus === 'vencida' && <span class="h-2 w-2 rounded-full bg-rose-600" title="Vencida" />}
                <span class="font-semibold text-navy text-xs">{c.licenciaFormatted}</span>
              </div>
              <p class="text-[10px] text-muted">
                {c.licenciaStatus === 'vigente' && `${c.licenciaDaysRemaining} días restantes`}
                {c.licenciaStatus === 'proxima' && `¡Vence en ${c.licenciaDaysRemaining} días!`}
                {c.licenciaStatus === 'vencida' && 'Carnet vencido'}
              </p>
            </td>

            <!-- Estado Operativo -->
            <td class="px-3 py-3.5 whitespace-nowrap">
              <StatusBadge status={c.estado} tone={c.tone} label={c.estadoLabel} />
            </td>

            <!-- Contacto -->
            <td class="px-3 py-3.5 whitespace-nowrap">
              <p class="text-xs font-semibold text-navy flex items-center gap-1">
                <Phone size={12} class="text-muted" /> {c.telefono}
              </p>
              <p class="text-[10px] text-muted truncate max-w-[140px]">{c.email}</p>
            </td>

            <!-- Actividad -->
            <td class="px-3 py-3.5 whitespace-nowrap">
              <p class="text-xs font-semibold text-navy flex items-center gap-1">
                <Route size={12} class="text-blue" /> {c.totalViajes} viajes
              </p>
              <p class="text-[10px] text-muted font-mono">{Number(c.totalKmRecorridos || 0).toLocaleString('es-AR')} km</p>
            </td>

            <!-- Acciones -->
            <td class="px-5 py-3.5 text-right whitespace-nowrap">
              <div class="flex items-center justify-end gap-1.5">
                <!-- Botón Ficha 360 -->
                <button
                  class="btn-view-detail flex items-center gap-1 rounded-lg border border-line bg-white px-2.5 py-1.5 text-xs font-bold text-navy hover:border-blue hover:text-blue hover:bg-sky/30 transition cursor-pointer"
                  data-id={c.id}
                  title="Ver ficha integral del chofer"
                >
                  <Eye size={13} />
                  <span>Ficha</span>
                </button>

                <!-- Botón Registrar Licencia -->
                <button
                  class="btn-add-licencia flex items-center gap-1 rounded-lg border border-line bg-white px-2 py-1.5 text-xs font-semibold text-amber-700 hover:border-amber-400 hover:bg-amber-50 transition cursor-pointer"
                  data-id={c.id}
                  data-nombre={`${c.apellido}, ${c.nombre}`}
                  title="Registrar licencia o ausencia laboral"
                >
                  <Calendar size={13} />
                </button>

                <!-- Botón Editar -->
                <button
                  class="btn-edit-chofer flex items-center gap-1 rounded-lg border border-line bg-white px-2 py-1.5 text-xs font-semibold text-muted hover:border-blue hover:text-blue hover:bg-paper transition cursor-pointer"
                  data-id={c.id}
                  title="Editar datos del chofer"
                >
                  <Edit3 size={13} />
                </button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <!-- Estado vacío si ningún filtro coincide -->
    <div id="no-results" class="hidden py-12 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-paper text-muted">
        <User size={24} />
      </div>
      <p class="mt-3 text-sm font-bold text-navy">No se encontraron choferes</p>
      <p class="text-xs text-muted">Intenta ajustando el término de búsqueda o los filtros seleccionados.</p>
    </div>
  </div>
</section>
