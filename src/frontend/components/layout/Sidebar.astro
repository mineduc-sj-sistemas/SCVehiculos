---
import { CalendarDays, Fuel, LayoutDashboard, LogOut, Navigation, Route, Settings, ShieldCheck, Truck, UsersRound, Wrench } from 'lucide-astro'
import { verifySessionToken, SESSION_COOKIE_NAME } from '../../../backend/index'

interface Props {
  activeNav?: 'panel' | 'flota' | 'choferes' | 'cronograma' | 'viajes' | 'mantenimientos' | 'combustible' | 'usuarios' | 'configuracion' | 'mi-viaje' | 'viajes-choferes' | 'mi-perfil'
}

const { activeNav = 'panel' } = Astro.props

const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value
const currentUser = verifySessionToken(sessionToken) || {
  id: 1,
  nombre: 'Aníbal',
  apellido: 'Administrador',
  nombreCompleto: 'Aníbal Administrador',
  rolNombre: 'Administrador',
  rolId: 1
}

const initials = `${currentUser.nombre.charAt(0)}${currentUser.apellido.charAt(0)}`.toUpperCase()

const isAuditor = currentUser.rolId === 5
const isChofer = currentUser.rolId === 4

let navItems = []

if (isAuditor) {
  navItems = [
    { id: 'panel', label: 'Panel de Auditoría', href: '/', icon: LayoutDashboard },
  ]
} else if (isChofer) {
  navItems = [
    { id: 'mi-viaje', label: 'Mi Viaje Oficial', href: '/mi-viaje', icon: Navigation },
    { id: 'viajes-choferes', label: 'Mi Calendario de Viajes', href: '/viajes-choferes', icon: CalendarDays },
    { id: 'combustible', label: 'Mis Cargas de Combustible', href: '/combustible', icon: Fuel },
    { id: 'mi-perfil', label: 'Mi Perfil / Licencia', href: '/mi-perfil', icon: UsersRound },
  ]
} else {
  navItems = [
    { id: 'panel', label: 'Panel principal', href: '/', icon: LayoutDashboard },
    { id: 'mi-viaje', label: 'Portal Chofer (Móvil)', href: '/mi-viaje', icon: Navigation },
    { id: 'viajes-choferes', label: 'Calendario de Choferes', href: '/viajes-choferes', icon: CalendarDays },
    { id: 'flota', label: 'Vehículos / Flota', href: '/flota', icon: Truck },
    { id: 'choferes', label: 'Choferes', href: '/choferes', icon: UsersRound },
    { id: 'cronograma', label: 'Cronograma', href: '/cronograma', icon: CalendarDays },
    { id: 'viajes', label: 'Viajes / Hojas de ruta', href: '/viajes', icon: Route },
    { id: 'mantenimientos', label: 'Mantenimientos', href: '/mantenimientos', icon: Wrench },
    { id: 'combustible', label: 'Combustible', href: '/combustible', icon: Fuel },
  ]

  if (currentUser.rolId === 1) {
    navItems.push({ id: 'usuarios', label: 'Usuarios / Accesos', href: '/usuarios', icon: ShieldCheck })
  }
}
---

<aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-40 flex w-[248px] flex-col border-r">
  <!-- Identificación institucional con Emblema San Juan -->
  <div class="sidebar-brand flex h-[76px] items-center border-b border-line px-4">
    <a href="/" class="sidebar-brand-link hover:opacity-95 transition" title="Ir al panel de inicio">
      <div class="sidebar-brand-expanded" aria-label="San Juan Gobierno, Ministerio de Educación, Gestión de Movilidades">
        <img class="sidebar-full-logo sidebar-full-logo-light" src="/branding/logo%20san%20juan.png" alt="San Juan Gobierno" />
        <img class="sidebar-full-logo sidebar-full-logo-dark" src="/branding/logo%20san%20juan%20blanco.png" alt="San Juan Gobierno" />
        <span class="sidebar-ministry-copy">
          <span>Ministerio de Educación</span>
          <span>Gestión de Movilidades</span>
        </span>
      </div>
      <span class="sidebar-brand-compact" role="img" aria-label="Gobierno de San Juan">
        <img
          class="sidebar-logo sidebar-logo-light"
          src="/branding/logo%20san%20juan%202.png"
          alt=""
        />
        <img
          class="sidebar-logo sidebar-logo-dark"
          src="/branding/logo%20san%20juan%203.png"
          alt=""
        />
      </span>
    </a>
  </div>
  
  <!-- Enlaces de navegación -->
  <div class="flex-1 overflow-y-auto px-3 pt-3.5">
    <nav class="space-y-1">
      {navItems.map((item) => {
        const isActive = activeNav === item.id
        return (
          <a
            href={item.href}
            class:list={[
              'group flex items-center gap-3 rounded-lg border-l-[3px] px-3 py-2.5 text-[13px] font-semibold transition',
              isActive
                ? 'sidebar-active border-[#ea580c] bg-orange-100/70 text-[#bd4b0b] font-bold'
                : 'border-transparent text-[#5e6873] hover:bg-black/[.035] hover:text-[#202127]'
            ]}
            title={item.label}
          >
            <item.icon size={18} strokeWidth={1.9} class={isActive ? 'text-[#ea580c]' : 'text-[#737d87] group-hover:text-[#ea580c] transition-colors'} />
            <span class="sidebar-copy">{item.label}</span>
          </a>
        )
      })}
    </nav>
  </div>
  
  <!-- Configuración y usuario -->
  <div class="mt-auto border-t border-line px-3 pb-4 pt-3">
    <!-- Botón Instalar App PWA -->
    <div class="pwa-install-trigger hidden mb-2 px-1">
      <button
        type="button"
        onclick="window.installPwa && window.installPwa()"
        class="w-full flex items-center justify-between gap-2 rounded-xl bg-orangeGov/10 hover:bg-orangeGov/20 border border-orangeGov/30 px-3 py-2 text-xs font-bold text-orangeGov transition cursor-pointer"
        title="Instalar SCVehículos en tu dispositivo"
      >
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 shrink-0 text-orangeGov" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span class="sidebar-copy">Instalar App</span>
        </span>
        <span class="sidebar-copy rounded bg-orangeGov text-white px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider">PWA</span>
      </button>
    </div>

    <div class="sidebar-account-row flex items-center justify-between px-2 py-1">
      <span class="sidebar-copy text-[10px] font-bold uppercase tracking-[.15em] text-muted">Cuenta activa</span>
      <a
        href="/api/auth/logout"
        class="flex items-center gap-1 text-[11px] font-semibold text-muted hover:text-orangeGov transition"
        title="Cerrar sesión segura"
      >
        <LogOut size={13} />
        <span class="sidebar-copy">Salir</span>
      </a>
    </div>

    <div class="sidebar-user-card mt-2 flex items-center gap-3 rounded-xl border border-line bg-white/80 p-2.5">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-orangeGov font-display text-sm font-bold text-white">
        {initials}
      </div>
      <div class="sidebar-copy min-w-0 flex-1">
        <p class="truncate text-xs font-bold text-navy">{currentUser.nombreCompleto}</p>
        <p class="truncate text-[11px] text-muted">{currentUser.rolNombre}</p>
      </div>
    </div>
  </div>
</aside>
