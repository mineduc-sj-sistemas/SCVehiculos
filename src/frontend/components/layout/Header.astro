---
import { Bell, CalendarDays, ChevronDown, Menu, Search } from 'lucide-astro'

const todayFormatted = new Intl.DateTimeFormat('es-AR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date())
const capitalizedDate = todayFormatted.charAt(0).toUpperCase() + todayFormatted.slice(1)
---

<header class="flex h-[94px] items-center justify-between border-b border-line bg-white px-5 sm:px-8">
  <div class="flex items-center gap-4">
    <button id="menu-button" class="rounded-lg p-2 text-muted hover:bg-sky lg:hidden" aria-label="Abrir menú">
      <Menu size={21} />
    </button>
    <div>
      <p class="text-xs font-semibold text-muted">{capitalizedDate}</p>
      <slot name="header-title">
        <h1 class="font-display text-xl font-bold text-navy sm:text-2xl">Panel principal</h1>
      </slot>
    </div>
  </div>
  
  <div class="flex items-center gap-3">
    <div class="relative hidden md:block">
      <Search size={17} class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
      <input
        aria-label="Buscar"
        placeholder="Buscar vehículo, patente..."
        class="h-10 w-[230px] rounded-lg border border-line bg-paper pl-10 pr-3 text-xs outline-none transition focus:border-blue focus:bg-white"
      />
    </div>
    <button class="relative rounded-lg p-2.5 text-muted hover:bg-sky cursor-pointer" aria-label="Notificaciones">
      <Bell size={19} />
      <span class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-gold ring-2 ring-white"></span>
    </button>
    <button class="hidden rounded-lg border border-line px-3 py-2 text-xs font-bold text-blue sm:flex sm:items-center sm:gap-2 hover:bg-sky/50 transition cursor-pointer">
      <CalendarDays size={15} /> Este mes <ChevronDown size={14} />
    </button>
  </div>
</header>
