---
import { AlertTriangle, Bell, CalendarDays, CheckCircle2, ChevronDown, Menu, Search } from 'lucide-astro'
import { getOperationalAlerts } from '../../../backend/index'

const todayFormatted = new Intl.DateTimeFormat('es-AR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date())
const capitalizedDate = todayFormatted.charAt(0).toUpperCase() + todayFormatted.slice(1)

const alertsSummary = await getOperationalAlerts()
---

<header class="flex h-[94px] items-center justify-between border-b border-line bg-white px-5 sm:px-8">
  <div class="flex items-center gap-4">
    <button id="menu-button" class="rounded-lg p-2 text-muted hover:bg-orange-50 hover:text-orangeGov lg:hidden" aria-label="Abrir menú">
      <Menu size={21} />
    </button>
    <div>
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-bold uppercase tracking-wider text-orangeGov">Gobierno de San Juan</span>
        <span class="text-line text-xs">·</span>
        <p class="text-xs font-semibold text-muted">{capitalizedDate}</p>
      </div>
      <slot name="header-title">
        <h1 class="font-display text-xl font-bold text-navy sm:text-2xl">Panel principal</h1>
      </slot>
    </div>
  </div>
  
  <div class="flex items-center gap-3">
    <div class="relative hidden md:block">
      <Search size={17} class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
      <input
        aria-label="Buscar"
        placeholder="Buscar vehículo, patente..."
        class="h-10 w-[240px] rounded-xl border border-line bg-paper pl-10 pr-3.5 text-xs font-semibold text-navy outline-none transition focus:border-orangeGov focus:bg-white focus:ring-2 focus:ring-orangeGov/15"
      />
    </div>

    <!-- Menú Desplegable de Alertas y Vencimientos -->
    <div class="relative" id="dropdown-alertas-container">
      <button
        id="btn-toggle-alertas"
        type="button"
        class="relative rounded-xl border border-line bg-white p-2.5 text-muted hover:bg-orange-50 hover:text-orangeGov hover:border-orangeGov/30 transition cursor-pointer"
        aria-label="Notificaciones"
        title="Centro de alertas y vencimientos operativos"
      >
        <Bell size={19} />
        {alertsSummary.totalAlerts > 0 && (
          <span class="absolute -top-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-rose-600 text-[10px] font-bold text-white shadow-xs">
            {alertsSummary.totalAlerts > 9 ? '9+' : alertsSummary.totalAlerts}
          </span>
        )}
      </button>

      <!-- Panel Desplegable -->
      <div
        id="panel-alertas"
        class="hidden absolute right-0 mt-2 w-80 sm:w-96 rounded-2xl bg-white shadow-2xl border border-line z-50 overflow-hidden animate-in fade-in zoom-in-95"
      >
        <div class="flex items-center justify-between border-b border-line bg-paper px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="font-display text-xs font-bold text-navy">Alertas Operativas</span>
            <span class="rounded-full bg-orange-100 text-orange-800 text-[10px] font-bold px-2 py-0.5">
              {alertsSummary.totalAlerts} pendientes
            </span>
          </div>
          <span class="text-[10px] text-muted font-semibold">Dirección de Movilidades</span>
        </div>

        <div class="max-h-80 overflow-y-auto divide-y divide-line/60">
          {alertsSummary.alerts.length === 0 ? (
            <div class="p-6 text-center text-xs text-muted">
              <CheckCircle2 size={24} class="mx-auto text-emerald-500 mb-1.5" />
              Todo al día. No hay vencimientos próximos ni alertas críticas.
            </div>
          ) : (
            alertsSummary.alerts.slice(0, 8).map((al) => (
              <a
                href={al.enlace}
                class="block p-3.5 hover:bg-paper/70 transition text-left group"
              >
                <div class="flex items-start gap-2.5">
                  <span class={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg ${
                    al.severidad === 'urgente' ? 'bg-rose-100 text-rose-600' : 'bg-amber-100 text-amber-700'
                  }`}>
                    <AlertTriangle size={13} />
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="text-xs font-bold text-navy truncate group-hover:text-orangeGov transition">
                      {al.titulo}
                    </p>
                    <p class="text-[11px] text-muted line-clamp-2 mt-0.5">{al.descripcion}</p>
                  </div>
                </div>
              </a>
            ))
          )}
        </div>
      </div>
    </div>

    <button class="hidden rounded-xl border border-line px-3.5 py-2 text-xs font-bold text-navy sm:flex sm:items-center sm:gap-2 hover:bg-paper hover:border-orangeGov/40 transition cursor-pointer">
      <CalendarDays size={15} class="text-orangeGov" /> Este mes <ChevronDown size={14} class="text-muted" />
    </button>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('btn-toggle-alertas');
    var panel = document.getElementById('panel-alertas');
    if (btn && panel) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        panel.classList.toggle('hidden');
      });
      document.addEventListener('click', function (e) {
        if (!panel.contains(e.target) && e.target !== btn) {
          panel.classList.add('hidden');
        }
      });
    }
  });
</script>
