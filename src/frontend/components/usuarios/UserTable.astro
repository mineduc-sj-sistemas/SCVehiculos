---
import { Building2, Mail, Phone, ShieldCheck, User } from 'lucide-astro'
import type { Usuario } from '../../../backend/index'

interface Props {
  usuarios: Usuario[]
}

const { usuarios } = Astro.props

const rolBadgeClass = (rolId: number) => {
  switch (rolId) {
    case 1:
      return 'bg-purple-100 text-purple-800 border-purple-200'
    case 2:
      return 'bg-blue-100 text-blue-800 border-blue-200'
    case 3:
      return 'bg-amber-100 text-amber-800 border-amber-200'
    case 4:
      return 'bg-emerald-100 text-emerald-800 border-emerald-200'
    default:
      return 'bg-slate-100 text-slate-700 border-slate-200'
  }
}
---

<div class="card overflow-hidden">
  <div class="flex flex-col gap-3 border-b border-line px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3 class="font-display text-[16px] font-bold text-navy">Usuarios Registrados</h3>
      <p class="mt-0.5 text-xs text-muted">Listado del personal autorizado para acceder y operar el sistema.</p>
    </div>
    <div class="text-xs font-semibold text-muted">
      Mostrando <span class="font-bold text-navy">{usuarios.length}</span> cuentas
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] text-left">
      <thead>
        <tr class="border-b border-line bg-paper text-[10px] font-bold uppercase tracking-[.08em] text-muted">
          <th class="px-5 py-3">Usuario / Nombre</th>
          <th class="px-4 py-3">Rol Asignado</th>
          <th class="px-4 py-3">Dependencia</th>
          <th class="px-4 py-3">DNI / Contacto</th>
          <th class="px-4 py-3">Último Acceso</th>
          <th class="px-5 py-3 text-right">Estado</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {usuarios.map((u) => {
          const initials = `${u.nombre.charAt(0)}${u.apellido.charAt(0)}`.toUpperCase()
          return (
            <tr class="hover:bg-slate-50/60 transition" data-user-row={u.id}>
              <!-- Nombre y Email -->
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-navy font-display text-xs font-bold text-white shadow-xs">
                    {initials}
                  </div>
                  <div class="min-w-0">
                    <p class="font-display text-[13px] font-bold text-navy truncate">
                      {u.nombre} {u.apellido}
                    </p>
                    <div class="flex items-center gap-1.5 text-[11px] text-muted truncate mt-0.5">
                      <Mail size={12} class="text-muted/70" />
                      <span>{u.email}</span>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Rol -->
              <td class="px-4 py-3.5">
                <span class:list={[
                  'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold border',
                  rolBadgeClass(u.rolId)
                ]}>
                  {u.rolId === 1 && <ShieldCheck size={12} />}
                  {u.rolNombre}
                </span>
                {u.choferNombre && (
                  <div class="mt-1">
                    <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded">
                      🚗 {u.choferNombre}
                    </span>
                    {u.choferLicencia && (
                      <p class="text-[10px] text-muted font-mono mt-0.5">{u.choferLicencia}</p>
                    )}
                  </div>
                )}
              </td>

              <!-- Dependencia -->
              <td class="px-4 py-3.5">
                <div class="flex items-center gap-1.5 text-xs text-slate-700">
                  <Building2 size={13} class="text-muted shrink-0" />
                  <span class="truncate max-w-[180px]">{u.dependenciaNombre || 'Ministerio Central'}</span>
                </div>
              </td>

              <!-- DNI / Teléfono -->
              <td class="px-4 py-3.5 text-xs text-muted">
                <p class="font-mono text-navy font-semibold">{u.dni ? `DNI ${u.dni}` : 'Sin DNI'}</p>
                {u.telefono && (
                  <p class="text-[11px] text-muted flex items-center gap-1 mt-0.5">
                    <Phone size={11} /> {u.telefono}
                  </p>
                )}
              </td>

              <!-- Último Acceso -->
              <td class="px-4 py-3.5 text-xs text-muted font-medium">
                {u.ultimoAcceso || 'Sin accesos'}
              </td>

              <!-- Estado -->
              <td class="px-5 py-3.5 text-right">
                <span class:list={[
                  'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold',
                  u.activo ? 'bg-[#e8f7ef] text-[#20864f]' : 'bg-slate-100 text-slate-500'
                ]}>
                  <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                  {u.activo ? 'Activo' : 'Inactivo'}
                </span>
              </td>
            </tr>
          )
        })}
      </tbody>
    </table>
  </div>
</div>
