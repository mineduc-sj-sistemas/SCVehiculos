---
import { KeyRound, Mail, Shield, User, X } from 'lucide-astro'
import type { Rol, Dependencia, ChoferParaVinculacion } from '../../../backend/index'

interface Props {
  roles: Rol[]
  dependencias: Dependencia[]
  choferes?: ChoferParaVinculacion[]
}

const { roles, dependencias, choferes = [] } = Astro.props
---

<div
  id="modal-create-user"
  class="fixed inset-0 z-50 flex items-center justify-center bg-navy/60 p-4 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-user-title"
>
  <div class="relative w-full max-w-xl rounded-2xl bg-white shadow-2xl border border-line overflow-hidden max-h-[90vh] flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-line px-6 py-4 bg-paper">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue text-white shadow-xs">
          <User size={20} strokeWidth={2.2} />
        </div>
        <div>
          <h2 id="modal-user-title" class="font-display text-lg font-bold text-navy">
            Registrar Nuevo Usuario
          </h2>
          <p class="text-xs text-muted">Crea una cuenta oficial para acceder al sistema SCVehículos.</p>
        </div>
      </div>
      <button
        id="btn-close-user-modal"
        class="rounded-lg p-2 text-muted hover:bg-line/60 hover:text-navy transition cursor-pointer"
        aria-label="Cerrar modal"
      >
        <X size={20} />
      </button>
    </div>

    <!-- Body / Form -->
    <form id="form-create-user" class="overflow-y-auto p-6 space-y-4 flex-1">
      <!-- Error Alert Box -->
      <div id="user-form-error" class="hidden rounded-xl bg-rose-50 border border-rose-200 p-3.5 text-xs font-semibold text-rose-800"></div>

      <!-- Rol y Dependencia (Primero para definir tipo de cuenta) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pb-2 border-b border-line">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-rol">
            Rol en el Sistema <span class="text-rose-500">*</span>
          </label>
          <select
            id="user-rol"
            name="rolId"
            required
            class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
          >
            {roles.map((r) => (
              <option value={r.id}>
                {r.nombre}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-dependencia">
            Dependencia / Área
          </label>
          <select
            id="user-dependencia"
            name="dependenciaId"
            class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
          >
            <option value="">Ministerio Central (Sin dependencia específica)</option>
            {dependencias.map((d) => (
              <option value={d.id}>{d.nombre}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Contenedor condicional: Chofer a vincular (visible solo cuando rol = Chofer / ID 4) -->
      <div id="container-chofer-selector" class="hidden rounded-xl border border-sky-200 bg-sky-50/70 p-4 space-y-2.5 transition-all">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-md bg-blue text-white text-xs">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
            </span>
            <label class="text-xs font-bold text-navy" for="user-chofer-id">
              Vincular a Chofer Oficial <span class="text-rose-500">*</span>
            </label>
          </div>
          <span class="text-[10px] font-bold text-blue bg-white border border-sky-200 px-2 py-0.5 rounded-full uppercase tracking-wider">
            1 cuenta por chofer
          </span>
        </div>
        
        <p class="text-[11px] text-muted">
          Selecciona un conductor del padrón para asociarle credenciales de acceso. Los datos personales se completarán automáticamente.
        </p>

        <select
          id="user-chofer-id"
          name="choferId"
          class="w-full rounded-lg border border-sky-300 bg-white px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition shadow-2xs"
        >
          <option value="">-- Seleccionar chofer a vincular --</option>
          {choferes.map((c) => (
            <option
              value={c.id}
              disabled={c.tieneUsuario}
              data-nombre={c.nombre}
              data-apellido={c.apellido}
              data-dni={c.dni}
              data-email={c.email || ''}
              data-telefono={c.telefono || ''}
              data-licencia={c.numeroLicencia}
              data-categoria={c.categoriaLicencia}
            >
              {c.apellido}, {c.nombre} · DNI: {c.dni} (Cat. {c.categoriaLicencia} - Lic. {c.numeroLicencia}) {c.tieneUsuario ? '— [Ya tiene usuario vinculado]' : ''}
            </option>
          ))}
        </select>

        {choferes.filter((c) => !c.tieneUsuario).length === 0 && (
          <div class="rounded-lg bg-amber-50 border border-amber-200 p-2.5 text-[11px] text-amber-800 font-medium">
            ⚠️ Todos los choferes registrados ya cuentan con credenciales de acceso vinculadas. Si deseas agregar otro chofer, regístralo primero en el módulo Choferes.
          </div>
        )}
      </div>

      <!-- Nombre y Apellido -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-nombre">
            Nombre <span class="text-rose-500">*</span>
          </label>
          <input
            id="user-nombre"
            name="nombre"
            type="text"
            required
            placeholder="Ej. Juan"
            class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-apellido">
            Apellido <span class="text-rose-500">*</span>
          </label>
          <input
            id="user-apellido"
            name="apellido"
            type="text"
            required
            placeholder="Ej. Pérez"
            class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
          />
        </div>
      </div>

      <!-- Correo Electrónico Institucional -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-email">
          Correo Institucional / Acceso <span class="text-rose-500">*</span>
        </label>
        <div class="relative">
          <Mail size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
          <input
            id="user-email"
            name="email"
            type="email"
            required
            placeholder="usuario@sanjuan.edu.ar"
            class="w-full rounded-lg border border-line bg-paper pl-9 pr-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
          />
        </div>
        <p class="text-[11px] text-muted mt-1">Se utilizará para iniciar sesión en la plataforma.</p>
      </div>

      <!-- DNI y Teléfono -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-dni">
            DNI
          </label>
          <input
            id="user-dni"
            name="dni"
            type="text"
            placeholder="Sin puntos"
            class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-telefono">
            Teléfono
          </label>
          <input
            id="user-telefono"
            name="telefono"
            type="text"
            placeholder="Ej. 264-5012345"
            class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
          />
        </div>
      </div>


      <!-- Contraseña inicial y confirmación -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-line">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-password">
            Contraseña Inicial <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <KeyRound size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
            <input
              id="user-password"
              name="password"
              type="password"
              required
              minlength="6"
              placeholder="Mínimo 6 caracteres"
              class="w-full rounded-lg border border-line bg-paper pl-9 pr-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
            />
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1" for="user-password-confirm">
            Confirmar Contraseña <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <KeyRound size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
            <input
              id="user-password-confirm"
              name="password_confirm"
              type="password"
              required
              minlength="6"
              placeholder="Repetir contraseña"
              class="w-full rounded-lg border border-line bg-paper pl-9 pr-3 py-2 text-xs font-semibold text-navy outline-none focus:border-blue transition"
            />
          </div>
        </div>
      </div>

      <!-- Footer Actions -->
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-line">
        <button
          type="button"
          id="btn-cancel-user-modal"
          class="rounded-lg border border-line bg-white px-4 py-2 text-xs font-bold text-muted hover:bg-paper hover:text-navy transition cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="btn-submit-user"
          class="flex items-center gap-2 rounded-lg bg-blue px-5 py-2 text-xs font-bold text-white shadow-sm shadow-blue/20 hover:opacity-90 transition cursor-pointer"
        >
          <span>Guardar Usuario</span>
        </button>
      </div>
    </form>
  </div>
</div>
