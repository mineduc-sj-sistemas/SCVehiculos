---
// ToastNotification.astro - Componente global de notificaciones toast flotantes
---

<div
  id="toast-container"
  class="fixed bottom-5 right-5 z-[9999] flex flex-col gap-2.5 pointer-events-none max-w-sm w-full px-4 sm:px-0"
  aria-live="polite"
  aria-atomic="true"
>
</div>

<template id="toast-template">
  <div
    class="toast-item pointer-events-auto flex items-start gap-3 rounded-xl border p-4 shadow-lg transition-all duration-300 transform translate-y-2 opacity-0"
    role="alert"
  >
    <div class="toast-icon shrink-0 mt-0.5"></div>
    <div class="flex-1 text-xs">
      <p class="toast-title font-bold text-navy text-[13px]"></p>
      <p class="toast-message mt-0.5 text-muted leading-relaxed"></p>
    </div>
    <button
      type="button"
      class="toast-close shrink-0 -mr-1 -mt-1 rounded-lg p-1.5 text-muted hover:bg-black/5 hover:text-navy transition cursor-pointer"
      aria-label="Cerrar notificación"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</template>

<script>
  type ToastType = 'success' | 'error' | 'warning' | 'info'

  interface ToastConfig {
    title?: string
    message: string
    type?: ToastType
    duration?: number
  }

  declare global {
    interface Window {
      showToast: (config: string | ToastConfig, type?: ToastType, duration?: number) => void
    }
  }

  function createToast(config: string | ToastConfig, defaultType: ToastType = 'info', defaultDuration = 4000) {
    const container = document.getElementById('toast-container')
    const template = document.getElementById('toast-template') as HTMLTemplateElement | null
    if (!container || !template) return

    let title = ''
    let message = ''
    let type: ToastType = defaultType
    let duration = defaultDuration

    if (typeof config === 'string') {
      message = config
    } else {
      title = config.title || ''
      message = config.message
      type = config.type || defaultType
      duration = config.duration ?? defaultDuration
    }

    if (!title) {
      switch (type) {
        case 'success': title = 'Éxito'; break
        case 'error': title = 'Error'; break
        case 'warning': title = 'Atención'; break
        case 'info': title = 'Información'; break
      }
    }

    const clone = template.content.cloneNode(true) as DocumentFragment
    const toastEl = clone.querySelector('.toast-item') as HTMLElement
    const titleEl = clone.querySelector('.toast-title') as HTMLElement
    const messageEl = clone.querySelector('.toast-message') as HTMLElement
    const iconEl = clone.querySelector('.toast-icon') as HTMLElement
    const closeBtn = clone.querySelector('.toast-close') as HTMLButtonElement

    titleEl.textContent = title
    messageEl.textContent = message

    // Configuración según tipo
    const styles: Record<ToastType, { bg: string; border: string; iconSvg: string; iconColor: string }> = {
      success: {
        bg: 'bg-white',
        border: 'border-emerald-200',
        iconColor: 'text-emerald-600',
        iconSvg: '<svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
      },
      error: {
        bg: 'bg-white',
        border: 'border-rose-200',
        iconColor: 'text-rose-600',
        iconSvg: '<svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
      },
      warning: {
        bg: 'bg-white',
        border: 'border-amber-200',
        iconColor: 'text-amber-600',
        iconSvg: '<svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>',
      },
      info: {
        bg: 'bg-white',
        border: 'border-sky-200',
        iconColor: 'text-blue',
        iconSvg: '<svg class="w-5 h-5 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
      },
    }

    const s = styles[type] || styles.info
    toastEl.classList.add(s.bg, s.border)
    iconEl.innerHTML = s.iconSvg

    container.appendChild(toastEl)

    // Trigger entrada animada
    requestAnimationFrame(() => {
      toastEl.classList.remove('translate-y-2', 'opacity-0')
      toastEl.classList.add('translate-y-0', 'opacity-100')
    })

    let dismissed = false
    const dismiss = () => {
      if (dismissed) return
      dismissed = true
      toastEl.classList.remove('translate-y-0', 'opacity-100')
      toastEl.classList.add('translate-y-2', 'opacity-0')
      setTimeout(() => {
        toastEl.remove()
      }, 300)
    }

    closeBtn.addEventListener('click', dismiss)

    if (duration > 0) {
      setTimeout(dismiss, duration)
    }
  }

  // Exponer a window
  window.showToast = (config: string | ToastConfig, type?: ToastType, duration?: number) => {
    createToast(config, type, duration)
  }

  // Listener para eventos desacoplados
  window.addEventListener('app:toast', ((e: CustomEvent<ToastConfig>) => {
    if (e.detail) {
      createToast(e.detail)
    }
  }) as EventListener)
</script>
