---
import { AlertCircle, Calendar, Camera, CheckCircle2, Fuel, Receipt, Sparkles, Truck, User, X } from 'lucide-astro'
import type { VehicleListItem } from '../../../backend/services/vehicleService'
import type { ChoferFull } from '../../../backend/types/chofer.types'

interface Props {
  vehiculos: VehicleListItem[]
  choferes: ChoferFull[]
  isChofer?: boolean
  currentChoferId?: number
}

const { vehiculos, choferes, isChofer = false, currentChoferId } = Astro.props

const nowIso = new Date().toISOString()
const todayLocal = `${nowIso.split('T')[0]}T${nowIso.split('T')[1].slice(0, 5)}`
---

<div
  id="modal-crear-combustible"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-navy/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
>
  <div class="relative w-full max-w-xl rounded-3xl bg-white shadow-2xl overflow-hidden flex flex-col max-h-[92vh] animate-in fade-in zoom-in-95">
    <!-- Cabecera -->
    <div class="flex items-center justify-between border-b border-gray-100 bg-charcoalGov px-5 py-3.5 sm:px-6 sm:py-4 text-white">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-orangeGov text-white shadow-sm shrink-0">
          <Fuel size={20} strokeWidth={2.5} />
        </div>
        <div>
          <h3 class="font-display text-base font-bold">
            {isChofer ? 'Registrar Mi Carga de Combustible' : 'Registrar Carga de Combustible'}
          </h3>
          <p class="text-[11px] text-white/70">
            {isChofer ? 'Comprobante Edenred, litros y odómetro' : 'Control de ticket, litros y odómetro'}
          </p>
        </div>
      </div>
      <button
        id="btn-close-combustible-modal"
        type="button"
        class="flex h-8 w-8 items-center justify-center rounded-xl text-white/70 hover:bg-white/10 hover:text-white transition cursor-pointer"
        aria-label="Cerrar modal"
      >
        <X size={18} />
      </button>
    </div>

    <!-- Formulario -->
    <form id="form-crear-combustible" class="overflow-y-auto p-4 sm:p-6 space-y-4 text-xs">
      <div id="combustible-error-msg" class="hidden rounded-xl bg-rose-50 border border-rose-200 p-3 text-rose-700 font-semibold flex items-center gap-2">
        <AlertCircle size={16} class="shrink-0" />
        <span id="combustible-error-text">Ocurrió un error</span>
      </div>

      <!-- PASO 1: Escáner IA (Ticket Edenred o Odómetro de Tablero) al inicio -->
      <div class="rounded-2xl border-2 border-dashed border-orangeGov/40 bg-gradient-to-br from-orange-50/80 via-white to-amber-50/50 p-3.5 sm:p-4 space-y-2.5 shadow-xs">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-orangeGov text-white text-[10px] font-bold">1</span>
            <span class="font-bold text-xs text-navy">Autocompletar con Foto (Recomendado)</span>
          </div>
          <span class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2 py-0.5 text-[10px] font-bold text-orangeGov">
            <Sparkles size={11} />
            Gemini IA
          </span>
        </div>
        <p class="text-[11px] text-muted leading-tight">
          Sacá foto al ticket de Edenred o al tablero. La IA completará litros, importe, estación, odómetro y seleccionará el vehículo automáticamente.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
          <!-- Botón Principal: Ticket Edenred -->
          <label class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-orangeGov hover:bg-orange-700 text-white font-bold text-xs shadow-md shadow-orange-500/20 active:scale-98 transition cursor-pointer select-none">
            <Receipt size={16} class="shrink-0" />
            <span>🧾 Foto Ticket Edenred</span>
            <input type="file" accept="image/*" capture="environment" id="scan-modal-fuel-ticket" class="hidden" />
          </label>

          <!-- Botón Secundario: Odómetro Tablero -->
          <label class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-white border border-gray-200 hover:bg-gray-50 text-navy font-bold text-xs shadow-2xs active:scale-98 transition cursor-pointer select-none">
            <Camera size={16} class="shrink-0 text-muted" />
            <span>📸 Foto Odómetro Tablero</span>
            <input type="file" accept="image/*" capture="environment" id="scan-modal-fuel-odometro" class="hidden" />
          </label>
        </div>

        <div id="status-modal-fuel-scanner" class="hidden text-xs font-medium p-2.5 rounded-xl transition-all"></div>
      </div>

      <!-- PASO 2: Separador visual de datos -->
      <div class="flex items-center gap-2 pt-1 text-muted">
        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-slate-200 text-slate-700 text-[10px] font-bold">2</span>
        <span class="text-[10px] font-bold uppercase tracking-wider text-muted">Datos de la Carga</span>
        <div class="flex-1 h-px bg-slate-100"></div>
      </div>

      <!-- Selección de Vehículo (y Conductor solo para Administrador/Gestor) -->
      <div class={`grid gap-3 ${isChofer ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2'}`}>
        <div>
          <label for="fuel-vehiculo" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Vehículo Oficial <span class="text-rose-500">*</span>
          </label>
          <select
            id="fuel-vehiculo"
            name="vehiculoId"
            required
            class="w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-xs font-bold text-navy outline-none focus:border-orangeGov focus:bg-white transition"
          >
            <option value="">Seleccione vehículo...</option>
            {vehiculos.map((v) => (
              <option value={v.id} data-odometro={v.odometro}>
                {v.patente} · {v.marca} {v.modelo}
              </option>
            ))}
          </select>
        </div>

        {/* Si es Chofer, su ID se envía de forma transparente sin mostrar el selector ni permitir elegir a otro */}
        {isChofer ? (
          <input
            type="hidden"
            id="fuel-chofer-hidden"
            name="choferId"
            value={currentChoferId || ''}
          />
        ) : (
          <div>
            <label for="fuel-chofer" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
              Conductor Responsable
            </label>
            <select
              id="fuel-chofer"
              name="choferId"
              class="w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-xs font-bold text-navy outline-none focus:border-orangeGov focus:bg-white transition"
            >
              <option value="">Seleccione conductor (opcional)...</option>
              {choferes.map((c) => (
                <option value={c.id}>
                  {c.apellido}, {c.nombre} (DNI: {c.dni})
                </option>
              ))}
            </select>
          </div>
        )}
      </div>

      <!-- Fecha, Estación y Combustible -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label for="fuel-fecha" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Fecha y Hora <span class="text-rose-500">*</span>
          </label>
          <input
            id="fuel-fecha"
            name="fechaCarga"
            type="datetime-local"
            required
            value={todayLocal}
            class="w-full rounded-xl border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-orangeGov focus:bg-white transition"
          />
        </div>

        <div>
          <label for="fuel-estacion" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Estación de Servicio
          </label>
          <input
            id="fuel-estacion"
            name="estacionServicio"
            type="text"
            placeholder="Ej: YPF ACA San Juan / Shell"
            class="w-full rounded-xl border border-line bg-paper px-3 py-2 text-xs font-semibold text-navy outline-none focus:border-orangeGov focus:bg-white transition"
          />
        </div>

        <div>
          <label for="fuel-tipo" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Combustible <span class="text-rose-500">*</span>
          </label>
          <select
            id="fuel-tipo"
            name="tipoCombustible"
            required
            class="w-full rounded-xl border border-line bg-paper px-3 py-2 text-xs font-bold text-navy outline-none focus:border-orangeGov focus:bg-white transition"
          >
            <option value="diesel_500">Diesel Común (500)</option>
            <option value="diesel_grado_3">Diesel Premium (Grado 3)</option>
            <option value="nafta_super">Nafta Súper</option>
            <option value="nafta_premium">Nafta Premium</option>
            <option value="gnc">GNC</option>
          </select>
        </div>
      </div>

      <!-- Litros, Precio y Total Calculado -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-gray-50/80 p-3.5 rounded-2xl border border-gray-200">
        <div>
          <label for="fuel-litros" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Litros Cargados <span class="text-rose-500">*</span>
          </label>
          <input
            id="fuel-litros"
            name="litros"
            type="number"
            step="0.01"
            min="0.1"
            inputmode="decimal"
            required
            placeholder="0.00"
            class="w-full rounded-xl border border-line bg-white px-3 py-2 text-xs font-mono font-bold text-navy outline-none focus:border-orangeGov transition"
          />
        </div>

        <div>
          <label for="fuel-precio" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Precio por Litro ($) <span class="text-rose-500">*</span>
          </label>
          <input
            id="fuel-precio"
            name="precioPorLitro"
            type="number"
            step="0.01"
            min="1"
            inputmode="decimal"
            required
            placeholder="0.00"
            class="w-full rounded-xl border border-line bg-white px-3 py-2 text-xs font-mono font-bold text-navy outline-none focus:border-orangeGov transition"
          />
        </div>

        <div>
          <label for="fuel-importe" class="block text-[11px] font-bold text-emerald-800 uppercase tracking-wider mb-1">
            Importe Total ($)
          </label>
          <input
            id="fuel-importe"
            name="importeTotal"
            type="number"
            step="0.01"
            inputmode="decimal"
            placeholder="0.00"
            class="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 text-xs font-mono font-bold text-emerald-700 outline-none focus:border-emerald-500 transition"
          />
        </div>
      </div>

      <!-- Odómetro, Ticket y Medio de Pago -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label for="fuel-odometro" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Odómetro Carga (Km) <span class="text-rose-500">*</span>
          </label>
          <input
            id="fuel-odometro"
            name="odometroCarga"
            type="number"
            min="0"
            inputmode="numeric"
            required
            placeholder="0"
            class="w-full rounded-xl border border-line bg-paper px-3 py-2 text-xs font-mono font-bold text-navy outline-none focus:border-orangeGov focus:bg-white transition"
          />
        </div>

        <div>
          <label for="fuel-ticket" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Nº Ticket / Factura
          </label>
          <input
            id="fuel-ticket"
            name="numeroTicket"
            type="text"
            placeholder="T-0001-00000000"
            class="w-full rounded-xl border border-line bg-paper px-3 py-2 text-xs font-mono text-navy outline-none focus:border-orangeGov focus:bg-white transition"
          />
        </div>

        <div>
          <label for="fuel-metodo" class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
            Método de Pago
          </label>
          <select
            id="fuel-metodo"
            name="metodoPago"
            class="w-full rounded-xl border border-line bg-paper px-3 py-2 text-xs font-bold text-navy outline-none focus:border-orangeGov focus:bg-white transition"
          >
            <option value="tarjeta_flota">Tarjeta Flota YPF en Ruta</option>
            <option value="orden_oficial">Orden de Carga Oficial</option>
            <option value="efectivo_fondo_fijo">Fondo Fijo / Caja Chica</option>
          </select>
        </div>
      </div>

      <!-- Checkbox Tanque Lleno -->
      <div class="rounded-xl border border-gray-200 bg-gray-50/60 p-3 flex items-center gap-2.5">
        <input
          id="fuel-tanque-lleno"
          name="tanqueLleno"
          type="checkbox"
          value="1"
          checked
          class="h-4 w-4 rounded border-gray-300 text-orangeGov focus:ring-orangeGov/30 cursor-pointer"
        />
        <label for="fuel-tanque-lleno" class="text-xs text-gray-700 cursor-pointer">
          <strong>Carga a tanque completo</strong> (Permite calcular el rendimiento exacto de Km/Litro con respecto a la carga previa)
        </label>
      </div>

      <!-- Botones de Acción -->
      <div class="flex items-center justify-end gap-2 pt-3 border-t border-gray-100">
        <button
          type="button"
          id="btn-cancel-combustible-modal"
          class="rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-xs font-bold text-gray-700 hover:bg-gray-100 transition cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="btn-submit-combustible"
          class="rounded-xl bg-orangeGov hover:bg-orange-700 px-5 py-2.5 text-xs font-bold text-white shadow-md shadow-orange-500/20 active:scale-98 transition cursor-pointer"
        >
          Registrar Carga
        </button>
      </div>
    </form>
  </div>
</div>
