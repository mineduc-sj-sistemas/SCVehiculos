---
import {
  AlertTriangle,
  Calendar,
  CalendarDays,
  CheckCircle2,
  Clock,
  Download,
  ExternalLink,
  FileText,
  MapPin,
  Printer,
  Route,
  Search,
  ShieldCheck,
  Truck,
  Wrench,
  X,
} from 'lucide-astro'
import PlateBadge from '../ui/PlateBadge.astro'
import StatusBadge from '../ui/StatusBadge.astro'
import VehicleDetailModal from '../flota/VehicleDetailModal.astro'
import CronogramaDetailModal from '../cronograma/CronogramaDetailModal.astro'
import type { FleetVehicle } from '../../backend/types/vehicle.types'
import type { ViajeItem } from '../../backend/services/viajesService'
import type { MantenimientoItem } from '../../backend/services/maintenanceService'

interface Props {
  currentUser: {
    id: number
    nombre: string
    apellido: string
    nombreCompleto: string
    email: string
    rolId: number
    rolNombre: string
  }
  stats: any
  fleet: FleetVehicle[]
  viajes: ViajeItem[]
  mantenimientos: MantenimientoItem[]
  alertsSummary: any
}

const {
  currentUser,
  stats,
  fleet = [],
  viajes = [],
  mantenimientos = [],
} = Astro.props

// Métricas ejecutivas calculadas
const totalVehiculos = fleet.length || stats?.totalVehicles || 0

// Disponibles: vehículos sin asignación activa hoy (estado = disponible)
const disponibles = fleet.filter((v) => v.estado === 'disponible').length
const enComision = fleet.filter((v) => v.estado === 'en_comision').length
const enTaller = fleet.filter((v) => v.estado === 'en_taller').length

const viajesEnCurso = viajes.filter((v) => v.estado === 'en_curso').length
const viajesProgramados = viajes.filter((v) => v.estado === 'programada').length

const mantEnCurso = mantenimientos.filter((m) => m.estado === 'en_curso').length
const mantProgramados = mantenimientos.filter((m) => m.estado === 'programado').length

// Fecha actual en español
const fechaHoy = new Date().toLocaleDateString('es-AR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const fechaHoyCapitalizada = fechaHoy.charAt(0).toUpperCase() + fechaHoy.slice(1)
---

<div class="space-y-6">

  <!-- ========================================================================= -->
  <!-- ENCABEZADO — solo saludo + fecha + exportar                               -->
  <!-- ========================================================================= -->
  <div class="rounded-2xl border border-line bg-white p-5 sm:p-6 shadow-xs relative overflow-hidden">
    <div class="absolute -right-8 -top-8 h-40 w-40 rounded-full bg-orangeGov/5 pointer-events-none blur-2xl"></div>

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 relative z-10">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#ea580c]/10 text-[#ea580c] border border-[#ea580c]/20">
            <ShieldCheck size={13} strokeWidth={2.5} />
            <span>Auditoría y Fiscalización Oficial</span>
          </span>
          <span class="text-xs font-semibold text-muted">· Ministerio de Educación · Gobierno de San Juan</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-gray-100 text-gray-700">
            {fechaHoyCapitalizada}
          </span>
        </div>

        <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-navy">
          Buen día, {currentUser.nombre}
        </h1>
      </div>

      <!-- Exportar Informe -->
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <div class="relative inline-block text-left" id="export-dropdown-container">
          <button
            type="button"
            id="btn-export-dropdown"
            class="flex items-center gap-2 rounded-xl bg-navy hover:bg-slate-800 text-white px-4 py-2.5 text-xs font-bold shadow-md shadow-navy/15 transition cursor-pointer"
          >
            <Download size={15} />
            <span>Exportar Informe Oficial</span>
            <span class="text-[10px] bg-white/20 px-1.5 py-0.5 rounded ml-1">Excel</span>
          </button>

          <div
            id="export-dropdown-menu"
            class="hidden absolute right-0 mt-2 w-56 rounded-2xl bg-white border border-line shadow-xl py-2 z-30"
          >
            <div class="px-3 py-1.5 border-b border-gray-100">
              <p class="text-[10px] font-bold uppercase tracking-wider text-muted">Planillas Consolidadas</p>
            </div>
            <a href="/api/reportes/flota" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-navy hover:bg-paper transition">
              <Truck size={14} class="text-[#ea580c]" />
              <span>Inventario de Flota (.csv)</span>
            </a>
            <a href="/api/reportes/viajes" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-navy hover:bg-paper transition">
              <Route size={14} class="text-blue" />
              <span>Registro de Viajes / Hojas (.csv)</span>
            </a>
            <a href="/api/reportes/mantenimientos" class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-navy hover:bg-paper transition">
              <Wrench size={14} class="text-amber-600" />
              <span>Historial Mecánico (.csv)</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TARJETAS KPI CLICKEABLES — renombradas y con filtro de período            -->
  <!-- ========================================================================= -->

  <!-- Selector de período (semana / mes) -->
  <div class="flex items-center justify-between">
    <p class="text-xs font-bold uppercase tracking-wider text-muted">Resumen del período</p>
    <div class="flex items-center gap-1 p-1 rounded-xl bg-paper border border-line">
      <button
        type="button"
        data-period="week"
        id="btn-period-week"
        class="period-btn px-3.5 py-1.5 rounded-lg text-xs font-bold text-muted hover:text-navy transition cursor-pointer"
      >
        Esta semana
      </button>
      <button
        type="button"
        data-period="month"
        id="btn-period-month"
        class="period-btn px-3.5 py-1.5 rounded-lg text-xs font-bold bg-white text-navy shadow-xs border border-line/50 transition cursor-pointer"
      >
        Este mes
      </button>
    </div>
  </div>

  <!-- Grid de cards KPI -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">

    <!-- KPI 1: Vehículos / Flota -->
    <button
      type="button"
      data-kpi="vehiculos"
      class="kpi-card text-left rounded-2xl border-2 border-navy/20 bg-white p-4 sm:p-5 shadow-xs transition hover:shadow-md hover:border-navy/40 cursor-pointer focus:outline-none kpi-active"
    >
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-muted">Vehículos / Flota</span>
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-navy">
          <Truck size={18} />
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="font-display text-2xl sm:text-3xl font-bold text-navy">{totalVehiculos}</span>
        <span class="text-xs font-semibold text-emerald-600">
          {totalVehiculos > 0 ? Math.round(((disponibles + enComision) / totalVehiculos) * 100) : 0}% operativos
        </span>
      </div>
      <p class="mt-1 text-[11px] text-muted truncate">
        {disponibles} libres · {enComision} en viaje · {enTaller} en taller
      </p>
      <div class="kpi-indicator mt-3 text-[10px] font-bold text-navy opacity-0 transition-opacity duration-200">
        ▼ seleccionado
      </div>
    </button>

    <!-- KPI 2: Disponibles hoy (desde cronograma) -->
    <button
      type="button"
      data-kpi="disponibles"
      class="kpi-card text-left rounded-2xl border-2 border-emerald-100 bg-emerald-50/40 p-4 sm:p-5 shadow-xs transition hover:shadow-md hover:border-emerald-300 cursor-pointer focus:outline-none"
    >
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Disponibles hoy</span>
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500 text-white shadow-xs">
          <CheckCircle2 size={18} />
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="font-display text-2xl sm:text-3xl font-bold text-emerald-950">{disponibles}</span>
        <span class="text-xs font-semibold text-emerald-700">sin asignación</span>
      </div>
      <p class="mt-1 text-[11px] text-emerald-800/80 truncate">
        Vehículos libres en el día de hoy
      </p>
      <div class="kpi-indicator mt-3 text-[10px] font-bold text-emerald-700 opacity-0 transition-opacity duration-200">
        ▼ seleccionado
      </div>
    </button>

    <!-- KPI 3: Viajes y Hojas de Ruta -->
    <button
      type="button"
      data-kpi="viajes"
      class="kpi-card text-left rounded-2xl border-2 border-blue-100 bg-blue-50/40 p-4 sm:p-5 shadow-xs transition hover:shadow-md hover:border-blue-300 cursor-pointer focus:outline-none"
    >
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-blue">Viajes y Hojas de Ruta</span>
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#ea580c] text-white shadow-xs">
          <Route size={18} />
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="font-display text-2xl sm:text-3xl font-bold text-navy" id="kpi-viajes-count">{viajesEnCurso}</span>
        <span class="text-xs font-semibold text-[#ea580c]">en ruta</span>
      </div>
      <p class="mt-1 text-[11px] text-muted truncate" id="kpi-viajes-sub">
        {viajesProgramados} salidas programadas
      </p>
      <div class="kpi-indicator mt-3 text-[10px] font-bold text-[#ea580c] opacity-0 transition-opacity duration-200">
        ▼ seleccionado
      </div>
    </button>

    <!-- KPI 4: Mantenimientos / Taller -->
    <button
      type="button"
      data-kpi="mantenimientos"
      class="kpi-card text-left rounded-2xl border-2 border-amber-100 bg-amber-50/40 p-4 sm:p-5 shadow-xs transition hover:shadow-md hover:border-amber-300 cursor-pointer focus:outline-none"
    >
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-900">Mantenimientos / Taller</span>
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-500 text-white shadow-xs">
          <Wrench size={18} />
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="font-display text-2xl sm:text-3xl font-bold text-amber-950" id="kpi-mant-count">{enTaller}</span>
        <span class="text-xs font-semibold text-amber-800">en taller</span>
      </div>
      <p class="mt-1 text-[11px] text-amber-800/80 truncate" id="kpi-mant-sub">
        {mantProgramados} services programados
      </p>
      <div class="kpi-indicator mt-3 text-[10px] font-bold text-amber-700 opacity-0 transition-opacity duration-200">
        ▼ seleccionado
      </div>
    </button>
  </div>

  <!-- Buscador universal -->
  <div class="rounded-2xl border border-line bg-white p-3 sm:p-4 shadow-xs flex items-center gap-3">
    <div class="relative flex-1">
      <Search size={15} class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" />
      <input
        type="text"
        id="auditor-search-input"
        placeholder="Buscar por patente, chofer, destino o modelo..."
        class="w-full rounded-xl border border-line bg-paper/60 pl-9 pr-8 py-2 text-xs font-medium text-navy placeholder:text-muted focus:bg-white focus:border-navy focus:outline-none focus:ring-1 focus:ring-navy transition"
      />
      <button
        type="button"
        id="auditor-search-clear"
        class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-muted hover:text-navy transition cursor-pointer"
      >
        <X size={14} />
      </button>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- SECCIÓN 1: VEHÍCULOS / FLOTA                                              -->
  <!-- ========================================================================= -->
  <section id="section-vehiculos" class="auditor-section space-y-3">
    <div class="flex items-center gap-2">
      <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-navy">
        <Truck size={16} />
      </div>
      <h2 class="font-display text-base font-bold text-navy">Vehículos / Flota</h2>
      <span class="rounded-full bg-paper px-2.5 py-0.5 text-[11px] font-bold text-muted border border-line">
        {fleet.length} unidades
      </span>
    </div>

    <div class="rounded-2xl border border-line bg-white shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-line bg-paper/60 text-muted uppercase text-[10px] font-bold tracking-wider">
              <th class="py-3 px-4">Vehículo / Modelo</th>
              <th class="py-3 px-4">Patente</th>
              <th class="py-3 px-4">Odómetro</th>
              <th class="py-3 px-4">Vencimiento RTO/VTV</th>
              <th class="py-3 px-4">Seguro</th>
              <th class="py-3 px-4">Estado Operativo</th>
              <th class="py-3 px-4 text-right">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line" id="auditor-vehiculos-tbody">
            {fleet.map((v) => {
              const rtoVencida = v.fechaVencimientoVtv && new Date(v.fechaVencimientoVtv) < new Date()
              const rtoProxima = v.fechaVencimientoVtv && !rtoVencida &&
                (new Date(v.fechaVencimientoVtv).getTime() - new Date().getTime()) / (1000 * 3600 * 24) < 30

              return (
                <tr
                  class="hover:bg-paper/40 transition auditor-row-vehiculo"
                  data-search={`${v.marca} ${v.modelo} ${v.patente} ${v.tipoNombre || ''} ${v.estado}`}
                >
                  <td class="py-3 px-4">
                    <div class="flex items-center gap-2.5">
                      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-700">
                        <Truck size={16} />
                      </div>
                      <div class="min-w-0">
                        <p class="font-bold text-navy truncate">{v.marca} {v.modelo}</p>
                        <p class="text-[11px] text-muted truncate">{v.tipoNombre || 'Vehículo'} · {v.anio || 'S/D'}</p>
                      </div>
                    </div>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap"><PlateBadge plate={v.patente} /></td>
                  <td class="py-3 px-4 whitespace-nowrap font-mono font-medium text-navy">
                    {v.odometroActual ? `${v.odometroActual.toLocaleString('es-AR')} km` : '0 km'}
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap">
                    {v.fechaVencimientoVtv ? (
                      <span class:list={[
                        'inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[11px] font-semibold',
                        rtoVencida ? 'bg-red-50 text-red-700 border border-red-200' :
                        rtoProxima ? 'bg-amber-50 text-amber-700 border border-amber-200' :
                        'bg-gray-50 text-gray-700 border border-gray-200'
                      ]}>
                        <Calendar size={11} />
                        <span>{new Date(v.fechaVencimientoVtv).toLocaleDateString('es-AR')}</span>
                      </span>
                    ) : (
                      <span class="text-muted text-[11px]">Sin registro</span>
                    )}
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap text-muted text-[11px]">
                    {v.companiaSeguro
                      ? <span class="truncate block max-w-[140px]" title={v.companiaSeguro}>{v.companiaSeguro}</span>
                      : <span>Al día</span>
                    }
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap">
                    <StatusBadge status={v.estado as any} />
                  </td>
                  <td class="py-3 px-4 text-right whitespace-nowrap">
                    <button
                      type="button"
                      class="btn-inspeccionar-vehiculo rounded-lg border border-line bg-white hover:bg-paper px-2.5 py-1.5 text-xs font-bold text-navy shadow-xs transition cursor-pointer"
                      data-id={v.id}
                    >
                      Ficha Técnica
                    </button>
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECCIÓN 2: DISPONIBLES HOY                                                 -->
  <!-- ========================================================================= -->
  <section id="section-disponibles" class="auditor-section hidden space-y-3">
    <div class="flex items-center gap-2">
      <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700">
        <CheckCircle2 size={16} />
      </div>
      <h2 class="font-display text-base font-bold text-navy">Vehículos Disponibles Hoy</h2>
      <span class="rounded-full bg-paper px-2.5 py-0.5 text-[11px] font-bold text-muted border border-line">
        {disponibles} sin asignación
      </span>
    </div>

    <div class="rounded-2xl border border-line bg-white shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-line bg-paper/60 text-muted uppercase text-[10px] font-bold tracking-wider">
              <th class="py-3 px-4">Vehículo / Modelo</th>
              <th class="py-3 px-4">Patente</th>
              <th class="py-3 px-4">Odómetro</th>
              <th class="py-3 px-4">Dependencia</th>
              <th class="py-3 px-4">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {fleet.filter(v => v.estado === 'disponible').length === 0 ? (
              <tr>
                <td colspan="5" class="py-8 text-center text-muted">
                  Todos los vehículos tienen asignaciones activas hoy.
                </td>
              </tr>
            ) : (
              fleet.filter(v => v.estado === 'disponible').map((v) => (
                <tr class="hover:bg-paper/40 transition">
                  <td class="py-3 px-4">
                    <div class="flex items-center gap-2.5">
                      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700">
                        <Truck size={16} />
                      </div>
                      <div class="min-w-0">
                        <p class="font-bold text-navy truncate">{v.marca} {v.modelo}</p>
                        <p class="text-[11px] text-muted truncate">{v.tipoNombre || 'Vehículo'} · {v.anio || 'S/D'}</p>
                      </div>
                    </div>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap"><PlateBadge plate={v.patente} /></td>
                  <td class="py-3 px-4 whitespace-nowrap font-mono font-medium text-navy">
                    {v.odometroActual ? `${v.odometroActual.toLocaleString('es-AR')} km` : '0 km'}
                  </td>
                  <td class="py-3 px-4 text-[11px] text-muted">
                    {v.dependenciaNombre || 'Sin asignar'}
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap">
                    <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                      Disponible
                    </span>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECCIÓN 3: VIAJES Y HOJAS DE RUTA                                         -->
  <!-- ========================================================================= -->
  <section id="section-viajes" class="auditor-section hidden space-y-3">
    <div class="flex items-center gap-2">
      <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-orange-100 text-[#ea580c]">
        <Route size={16} />
      </div>
      <h2 class="font-display text-base font-bold text-navy">Viajes y Hojas de Ruta Oficiales</h2>
      <span class="rounded-full bg-paper px-2.5 py-0.5 text-[11px] font-bold text-muted border border-line" id="viajes-count-label">
        {viajes.length} comisiones
      </span>
    </div>

    <div class="rounded-2xl border border-line bg-white shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-line bg-paper/60 text-muted uppercase text-[10px] font-bold tracking-wider">
              <th class="py-3 px-4">Código / Estado</th>
              <th class="py-3 px-4">Destino</th>
              <th class="py-3 px-4">Conductor</th>
              <th class="py-3 px-4">Vehículo</th>
              <th class="py-3 px-4">Fecha Salida</th>
              <th class="py-3 px-4">Área Solicitante</th>
              <th class="py-3 px-4 text-right">Hoja de Ruta</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line" id="auditor-viajes-tbody">
            {viajes.length === 0 ? (
              <tr>
                <td colspan="7" class="py-8 text-center text-muted">No hay comisiones registradas.</td>
              </tr>
            ) : (
              viajes.map((viaje) => {
                const salidaFormatted = viaje.fechaSalidaProgramada
                  ? new Date(viaje.fechaSalidaProgramada).toLocaleString('es-AR', {
                      day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',
                    })
                  : 'S/D'

                // data-date para filtrado por período
                const isoDate = viaje.fechaSalidaProgramada
                  ? new Date(viaje.fechaSalidaProgramada).toISOString()
                  : ''

                return (
                  <tr
                    class="hover:bg-paper/40 transition auditor-row-viaje"
                    data-search={`${viaje.codigo} ${viaje.destino} ${viaje.origen} ${viaje.choferNombreCompleto} ${viaje.vehiculoPatente} ${viaje.vehiculoMarca} ${viaje.dependenciaNombre}`}
                    data-date={isoDate}
                  >
                    <td class="py-3 px-4 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <span class="font-mono font-bold text-navy">{viaje.codigo}</span>
                        <span class:list={[
                          'inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold border',
                          viaje.estado === 'en_curso' ? 'bg-blue/10 text-blue border-blue/20' :
                          viaje.estado === 'programada' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                          viaje.estado === 'finalizada' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                          'bg-gray-100 text-gray-700 border-gray-200'
                        ]}>
                          {viaje.estadoLabel}
                        </span>
                      </div>
                    </td>
                    <td class="py-3 px-4">
                      <div class="flex items-start gap-1.5">
                        <MapPin size={13} class="text-[#ea580c] shrink-0 mt-0.5" />
                        <div>
                          <p class="font-bold text-navy leading-tight">{viaje.destino}</p>
                          <p class="text-[11px] text-muted">Desde: {viaje.origen}</p>
                        </div>
                      </div>
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold">
                          {viaje.choferNombre?.charAt(0)}{viaje.choferApellido?.charAt(0)}
                        </div>
                        <span class="font-medium text-navy">{viaje.choferNombreCompleto}</span>
                      </div>
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <PlateBadge plate={viaje.vehiculoPatente} />
                        <span class="text-[11px] text-muted">{viaje.vehiculoMarca}</span>
                      </div>
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap font-medium text-navy">
                      <div class="flex items-center gap-1.5">
                        <Clock size={12} class="text-muted" />
                        <span>{salidaFormatted}</span>
                      </div>
                    </td>
                    <td class="py-3 px-4 text-muted text-[11px] max-w-[140px] truncate" title={viaje.dependenciaNombre}>
                      {viaje.dependenciaNombre}
                    </td>
                    <td class="py-3 px-4 text-right whitespace-nowrap">
                      <div class="flex items-center justify-end gap-1.5">
                        <button
                          type="button"
                          class="btn-ver-detalle-viaje inline-flex items-center gap-1 rounded-lg border border-line bg-white hover:bg-paper px-2.5 py-1.5 text-xs font-bold text-navy shadow-xs transition cursor-pointer"
                          data-id={viaje.id}
                        >
                          <FileText size={12} class="text-[#ea580c]" />
                          <span>Ver Ficha</span>
                        </button>
                        <a
                          href={`/cronograma/imprimir/${viaje.id}`}
                          target="_blank"
                          class="inline-flex items-center gap-1 rounded-lg bg-navy hover:bg-slate-800 text-white px-2.5 py-1.5 text-xs font-bold shadow-xs transition"
                        >
                          <Printer size={12} />
                          <span>Imprimir A4</span>
                        </a>
                      </div>
                    </td>
                  </tr>
                )
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECCIÓN 4: MANTENIMIENTOS / TALLER                                         -->
  <!-- ========================================================================= -->
  <section id="section-mantenimientos" class="auditor-section hidden space-y-3">
    <div class="flex items-center gap-2">
      <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-100 text-amber-800">
        <Wrench size={16} />
      </div>
      <h2 class="font-display text-base font-bold text-navy">Mantenimientos / Taller</h2>
      <span class="rounded-full bg-paper px-2.5 py-0.5 text-[11px] font-bold text-muted border border-line">
        {mantenimientos.length} servicios
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <div class="lg:col-span-2 rounded-2xl border border-line bg-white shadow-xs overflow-hidden">
        <div class="p-4 border-b border-line bg-paper/40 flex items-center justify-between">
          <h3 class="font-display text-xs font-bold text-navy uppercase tracking-wider">Agenda y Órdenes de Trabajo</h3>
          <span class="text-xs text-muted font-medium">Últimas intervenciones</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-line bg-paper/60 text-muted uppercase text-[10px] font-bold tracking-wider">
                <th class="py-3 px-4">Vehículo</th>
                <th class="py-3 px-4">Tipo / Trabajo</th>
                <th class="py-3 px-4">Proveedor / Taller</th>
                <th class="py-3 px-4">Fecha</th>
                <th class="py-3 px-4">Estado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line" id="auditor-mantenimientos-tbody">
              {mantenimientos.length === 0 ? (
                <tr>
                  <td colspan="5" class="py-6 text-center text-muted">No hay servicios de mantenimiento registrados.</td>
                </tr>
              ) : (
                mantenimientos.slice(0, 8).map((m) => (
                  <tr
                    class="hover:bg-paper/40 transition auditor-row-mantenimiento"
                    data-search={`${m.vehiculoMarca} ${m.vehiculoModelo} ${m.vehiculoPatente} ${m.titulo} ${m.tallerProveedor || ''} ${m.estado}`}
                    data-date={m.fechaProgramada ? new Date(m.fechaProgramada).toISOString() : ''}
                  >
                    <td class="py-3 px-4 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <PlateBadge plate={m.vehiculoPatente} />
                        <span class="font-medium text-navy text-[11px]">{m.vehiculoMarca}</span>
                      </div>
                    </td>
                    <td class="py-3 px-4">
                      <p class="font-bold text-navy leading-tight">{m.titulo}</p>
                      <p class="text-[10px] text-muted capitalize">{m.tipo} · {m.odometroServicio ? `${m.odometroServicio.toLocaleString('es-AR')} km` : ''}</p>
                    </td>
                    <td class="py-3 px-4 text-muted text-[11px] whitespace-nowrap">{m.tallerProveedor || 'Taller Central'}</td>
                    <td class="py-3 px-4 whitespace-nowrap font-medium text-navy">
                      {m.fechaProgramada ? new Date(m.fechaProgramada).toLocaleDateString('es-AR') : 'S/D'}
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap">
                      <span class:list={[
                        'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold',
                        m.estado === 'en_curso' ? 'bg-amber-100 text-amber-900 border border-amber-300' :
                        m.estado === 'completado' ? 'bg-emerald-100 text-emerald-900 border border-emerald-300' :
                        'bg-slate-100 text-slate-800 border border-slate-200'
                      ]}>
                        {m.estado === 'en_curso' ? 'En Reparación' : m.estado === 'completado' ? 'Completado' : 'Programado'}
                      </span>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Resumen lateral -->
      <div class="rounded-2xl border border-line bg-white p-5 shadow-xs">
        <h3 class="font-display text-sm font-bold text-navy mb-3 flex items-center gap-2">
          <Wrench size={16} class="text-[#ea580c]" />
          <span>Resumen Operativo</span>
        </h3>
        <div class="space-y-3 text-xs">
          <div class="flex items-center justify-between p-3 rounded-xl bg-paper">
            <span class="text-muted font-medium">En servicio hoy:</span>
            <span class="font-bold text-navy text-sm">{enTaller}</span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-xl bg-paper">
            <span class="text-muted font-medium">Services programados:</span>
            <span class="font-bold text-navy text-sm">{mantProgramados}</span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-xl bg-paper">
            <span class="text-muted font-medium">Completados:</span>
            <span class="font-bold text-emerald-700 text-sm">
              {mantenimientos.filter((m) => m.estado === 'completado').length}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modales -->
  <VehicleDetailModal />
  <CronogramaDetailModal />
</div>

<script>
  function initAuditorDashboard() {

    // ─── Dropdown exportar ────────────────────────────────────────────────────
    const btnExport = document.getElementById('btn-export-dropdown')
    const menuExport = document.getElementById('export-dropdown-menu')
    const containerExport = document.getElementById('export-dropdown-container')

    btnExport?.addEventListener('click', (e) => {
      e.stopPropagation()
      menuExport?.classList.toggle('hidden')
    })
    document.addEventListener('click', (e) => {
      if (!containerExport?.contains(e.target as Node)) menuExport?.classList.add('hidden')
    })

    // ─── Cards KPI ────────────────────────────────────────────────────────────
    const kpiCards = document.querySelectorAll<HTMLButtonElement>('.kpi-card')

    const kpiSectionMap: Record<string, string> = {
      vehiculos: 'section-vehiculos',
      disponibles: 'section-disponibles',
      viajes: 'section-viajes',
      mantenimientos: 'section-mantenimientos',
    }

    const kpiRingMap: Record<string, string> = {
      vehiculos: 'ring-navy',
      disponibles: 'ring-emerald-400',
      viajes: 'ring-orange-400',
      mantenimientos: 'ring-amber-400',
    }

    function activateKpi(kpiId: string) {
      // Ocultar todas las secciones
      document.querySelectorAll('.auditor-section').forEach((s) => s.classList.add('hidden'))

      // Mostrar sección correspondiente
      const secId = kpiSectionMap[kpiId]
      if (secId) document.getElementById(secId)?.classList.remove('hidden')

      // Estilos cards
      kpiCards.forEach((card) => {
        const isActive = card.dataset.kpi === kpiId
        const indicator = card.querySelector('.kpi-indicator') as HTMLElement | null

        card.classList.remove('ring-2', 'ring-offset-2', 'scale-[1.02]', 'shadow-lg',
          'ring-navy', 'ring-emerald-400', 'ring-orange-400', 'ring-amber-400')
        if (indicator) indicator.style.opacity = '0'

        if (isActive) {
          const ring = kpiRingMap[kpiId] || 'ring-navy'
          card.classList.add('ring-2', 'ring-offset-2', ring, 'scale-[1.02]', 'shadow-lg')
          if (indicator) indicator.style.opacity = '1'
        }
      })

      // Scroll suave
      const sec = document.getElementById(secId)
      if (sec) setTimeout(() => sec.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80)
    }

    // Iniciar con vehículos
    activateKpi('vehiculos')

    kpiCards.forEach((card) => {
      card.addEventListener('click', () => activateKpi(card.dataset.kpi || 'vehiculos'))
    })

    // ─── Filtro período semana / mes ──────────────────────────────────────────
    const periodBtns = document.querySelectorAll<HTMLButtonElement>('.period-btn')

    function getStartDate(period: string): Date {
      const now = new Date()
      if (period === 'week') {
        const day = now.getDay() // 0=Dom, 1=Lun ...
        const diff = now.getDate() - day + (day === 0 ? -6 : 1) // lunes
        return new Date(now.setDate(diff))
      } else {
        return new Date(now.getFullYear(), now.getMonth(), 1)
      }
    }

    function applyPeriodFilter(period: string) {
      const startDate = getStartDate(period)

      // Filas de viajes
      document.querySelectorAll<HTMLElement>('.auditor-row-viaje').forEach((row) => {
        const dateStr = row.dataset.date
        if (!dateStr) { row.style.display = ''; return }
        const d = new Date(dateStr)
        row.style.display = d >= startDate ? '' : 'none'
      })

      // Filas de mantenimientos
      document.querySelectorAll<HTMLElement>('.auditor-row-mantenimiento').forEach((row) => {
        const dateStr = row.dataset.date
        if (!dateStr) { row.style.display = ''; return }
        const d = new Date(dateStr)
        row.style.display = d >= startDate ? '' : 'none'
      })

      // Estilos botones período
      periodBtns.forEach((btn) => {
        const isActive = btn.dataset.period === period
        btn.classList.toggle('bg-white', isActive)
        btn.classList.toggle('text-navy', isActive)
        btn.classList.toggle('shadow-xs', isActive)
        btn.classList.toggle('border', isActive)
        btn.classList.toggle('border-line/50', isActive)
        btn.classList.toggle('text-muted', !isActive)
      })
    }

    periodBtns.forEach((btn) => {
      btn.addEventListener('click', () => applyPeriodFilter(btn.dataset.period || 'month'))
    })

    // Inicio con "este mes"
    applyPeriodFilter('month')

    // ─── Buscador universal ───────────────────────────────────────────────────
    const searchInput = document.getElementById('auditor-search-input') as HTMLInputElement | null
    const clearBtn = document.getElementById('auditor-search-clear')

    const filterRows = () => {
      const q = searchInput?.value.trim().toLowerCase() || ''
      if (clearBtn) clearBtn.classList.toggle('hidden', q === '')

      ;['.auditor-row-vehiculo', '.auditor-row-viaje', '.auditor-row-mantenimiento'].forEach((sel) => {
        document.querySelectorAll<HTMLElement>(sel).forEach((row) => {
          const text = row.dataset.search?.toLowerCase() || ''
          // Solo ocultar si búsqueda activa y no coincide
          if (q !== '' && !text.includes(q)) {
            row.style.display = 'none'
          } else if (q === '') {
            row.style.display = '' // restaurar (el filtro período se aplicará de nuevo)
          }
        })
      })
    }

    searchInput?.addEventListener('input', filterRows)
    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = ''
      filterRows()
      searchInput?.focus()
    })

    // ─── Ficha técnica vehículo ───────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.btn-inspeccionar-vehiculo').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id
        if (id && typeof (window as any).openVehicleDetailModal === 'function') {
          ;(window as any).openVehicleDetailModal(id)
        }
      })
    })

    // ─── Ficha de viaje / comisión ────────────────────────────────────────────
    const modalDetail = document.getElementById('modal-detail')
    const btnCloseDetail = document.getElementById('btn-close-detail-modal')
    const btnCloseDetailFooter = document.getElementById('btn-close-detail-modal-footer')
    const btnImprimirHoja = document.getElementById('btn-imprimir-hoja-ruta')
    let selectedComisionId: number | null = null

    const closeDetailModal = () => {
      modalDetail?.classList.add('opacity-0', 'pointer-events-none')
      selectedComisionId = null
    }

    btnCloseDetail?.addEventListener('click', closeDetailModal)
    btnCloseDetailFooter?.addEventListener('click', closeDetailModal)
    btnImprimirHoja?.addEventListener('click', () => {
      if (selectedComisionId) window.open(`/cronograma/imprimir/${selectedComisionId}`, '_blank')
    })

    document.querySelectorAll<HTMLElement>('.btn-ver-detalle-viaje').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation()
        const id = btn.dataset.id
        if (!id) return
        selectedComisionId = parseInt(id, 10)

        try {
          const res = await fetch(`/api/cronograma/${id}`)
          if (!res.ok) throw new Error('No se pudo cargar la comisión')
          const c = await res.json()

          const set = (elId: string, val: string) => {
            const el = document.getElementById(elId)
            if (el) el.innerText = val
          }

          set('detail-codigo', c.codigoComision || `COM-${id}`)
          set('detail-vehiculo-patente', c.vehiculoPatente || 'S/D')
          set('detail-vehiculo-modelo', `${c.vehiculoMarca || ''} ${c.vehiculoModelo || ''}`)
          set('detail-chofer-nombre', c.choferNombre ? `${c.choferApellido || ''}, ${c.choferNombre}` : 'Sin chofer')
          set('detail-dependencia-nombre', c.dependenciaNombre || 'Ministerio de Educación')
          set('detail-origen', c.origen || 'Capital, San Juan')
          set('detail-destino', c.destino || 'S/D')
          set('detail-motivo', c.motivo || 'Comisión Oficial')
          set('detail-pasajeros', String(c.cantidadPasajeros || 1))

          const elBadge = document.getElementById('detail-badge-estado')
          if (elBadge) {
            elBadge.innerText = c.estado === 'en_curso' ? 'En Viaje' : c.estado === 'programada' ? 'Programada' : 'Finalizada'
            elBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold ' +
              (c.estado === 'en_curso' ? 'bg-blue/20 text-blue border border-blue/40' :
               c.estado === 'programada' ? 'bg-amber-100 text-amber-800 border border-amber-300' :
               'bg-emerald-100 text-emerald-800 border border-emerald-300')
          }

          document.getElementById('section-acciones-operativas')?.classList.add('hidden')
          modalDetail?.classList.remove('opacity-0', 'pointer-events-none')
        } catch (err: any) {
          alert('Error al consultar comisión: ' + err.message)
        }
      })
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuditorDashboard)
  } else {
    initAuditorDashboard()
  }
</script>
