---
import { Route, ShieldCheck, Truck, Wrench } from 'lucide-astro'
import type { DashboardStats } from '../../backend/types'

interface Props {
  stats: DashboardStats
}

const { stats } = Astro.props

const statCards = [
  {
    label: 'Unidades en parque',
    value: String(stats.totalFleet).padStart(2, '0'),
    detail: 'Total de vehículos',
    icon: Truck,
    accent: 'text-orangeGov',
    bg: 'bg-orangeGov/10',
    borderLeft: 'border-l-4 border-orangeGov',
  },
  {
    label: 'Disponibles ahora',
    value: String(stats.availableFleet).padStart(2, '0'),
    detail: `${stats.availablePercent}% de la flota`,
    icon: ShieldCheck,
    accent: 'text-emerald-600',
    bg: 'bg-emerald-50',
    borderLeft: 'border-l-4 border-emerald-500',
  },
  {
    label: 'Comisiones activas',
    value: String(stats.activeTravels).padStart(2, '0'),
    detail: 'En distintos departamentos',
    icon: Route,
    accent: 'text-amber-600',
    bg: 'bg-amber-50',
    borderLeft: 'border-l-4 border-amber-500',
  },
  {
    label: 'Unidades en taller',
    value: String(stats.inRepairFleet).padStart(2, '0'),
    detail: stats.inRepairFleet > 0 ? `${stats.inRepairFleet} en atención mecánica` : 'Sin unidades en taller',
    icon: Wrench,
    accent: 'text-charcoalGov',
    bg: 'bg-slate-100',
    borderLeft: 'border-l-4 border-charcoalGov',
  },
]
---

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  {statCards.map((card) => (
    <div class={`card p-5 transition-all hover:shadow-md hover:-translate-y-0.5 ${card.borderLeft}`}>
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs font-bold text-muted uppercase tracking-wider">{card.label}</p>
          <p class="mt-2 font-display text-3xl font-bold tracking-tight text-navy">{card.value}</p>
          <p class="mt-1 text-xs text-muted">{card.detail}</p>
        </div>
        <div class={`flex h-11 w-11 items-center justify-center rounded-xl ${card.bg} ${card.accent}`}>
          <card.icon size={22} />
        </div>
      </div>
    </div>
  ))}
</div>
