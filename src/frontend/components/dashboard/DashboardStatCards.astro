---
import { Route, ShieldCheck, Truck, Wrench } from 'lucide-astro'
import type { DashboardStats } from '../../backend/types'

interface Props {
  stats: DashboardStats
}

const { stats } = Astro.props

const statCards = [
  {
    label: 'Unidades en parque',
    value: String(stats.totalFleet).padStart(2, '0'),
    detail: 'Total de vehículos',
    icon: Truck,
    accent: 'text-orangeGov',
    bg: 'bg-orangeGov/10',
    borderTop: 'border-t-2 border-orangeGov',
  },
  {
    label: 'Disponibles ahora',
    value: String(stats.availableFleet).padStart(2, '0'),
    detail: `${stats.availablePercent}% de la flota`,
    icon: ShieldCheck,
    accent: 'text-emerald-600',
    bg: 'bg-emerald-50',
    borderTop: 'border-t-2 border-emerald-500',
  },
  {
    label: 'Comisiones activas',
    value: String(stats.activeTravels).padStart(2, '0'),
    detail: 'En distintos departamentos',
    icon: Route,
    accent: 'text-amber-600',
    bg: 'bg-amber-50',
    borderTop: 'border-t-2 border-orangeGov',
  },
  {
    label: 'Unidades en taller',
    value: String(stats.inRepairFleet).padStart(2, '0'),
    detail: stats.inRepairFleet > 0 ? `${stats.inRepairFleet} en atención mecánica` : 'Sin unidades en taller',
    icon: Wrench,
    accent: 'text-charcoalGov',
    bg: 'bg-slate-100',
    borderTop: 'border-t-2 border-red-500',
  },
]
---

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  {statCards.map((card) => (
    <div class={`card flex min-h-[92px] items-center gap-3.5 px-4 py-3 transition-all hover:shadow-md hover:-translate-y-0.5 ${card.borderTop}`}>
      <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ${card.bg} ${card.accent}`}>
        <card.icon size={20} />
      </div>
      <div class="min-w-0">
        <p class="text-[10px] font-bold uppercase tracking-[.12em] text-muted">{card.label}</p>
        <div class="mt-1 flex items-baseline gap-2">
          <p class="font-display text-[25px] font-bold leading-none tracking-tight text-navy">{card.value}</p>
          <p class="truncate text-[10px] font-medium text-muted">{card.detail}</p>
        </div>
      </div>
    </div>
  ))}
</div>
