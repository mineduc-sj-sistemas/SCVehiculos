---
import Sidebar from '../components/layout/Sidebar.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import ToastNotification from '../components/ui/ToastNotification.astro'
import PwaManager from '../components/pwa/PwaManager.astro'
import '../styles/global.css'

interface Props {
  title?: string
  activeNav?: 'panel' | 'flota' | 'choferes' | 'cronograma' | 'viajes' | 'mantenimientos' | 'combustible' | 'usuarios' | 'configuracion' | 'mi-viaje' | 'mi-perfil' | 'viajes-choferes'
}

const {
  title = 'Movilidades · Ministerio de Educación · Gobierno de San Juan',
  activeNav = 'panel',
} = Astro.props
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>

    <!-- Metadatos y Manifiesto PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b2240" />
    <meta name="application-name" content="SCVehículos" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SCVehículos" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />
  </head>
  <body class="bg-paper text-ink antialiased">
    <div class="min-h-screen bg-paper">
      <!-- Overlay móvil para cuando el menú lateral está abierto -->
      <div id="mobile-overlay" class="mobile-overlay fixed inset-0 z-30 bg-navy/30 hidden"></div>
      
      <!-- Barra lateral de navegación -->
      <Sidebar activeNav={activeNav} />

      <!-- Contenedor Principal -->
      <main class="main-shell ml-0 min-h-screen transition-[margin] duration-200 lg:ml-[72px]">
        <!-- Cabecera Superior -->
        <Header>
          <slot name="header-title" slot="header-title" />
        </Header>

        <!-- Contenido de la página -->
        <div class="workspace-canvas p-4 sm:p-6 lg:p-7">
          <slot />

          <!-- Pie de página -->
          <Footer />
        </div>
      </main>
    </div>

    <!-- Modales fuera del flujo principal -->
    <slot name="modals" />

    <!-- Notificaciones flotantes globales -->
    <ToastNotification />

    <!-- Gestor de PWA (Service Worker, estado de red y prompts de instalación) -->
    <PwaManager />

    <script>
      const menuButton = document.querySelector('#menu-button')
      const sidebar = document.querySelector('#sidebar')
      const overlay = document.querySelector('#mobile-overlay')
      
      const closeMenu = () => {
        sidebar?.classList.remove('open')
        overlay?.classList.remove('open')
      }

      // Si el usuario fijó la sidebar previamente en desktop, la mantenemos fija; de lo contrario, se mantiene reactiva al cursor
      if (window.matchMedia('(min-width: 901px)').matches && localStorage.getItem('sc-sidebar-pinned') === 'true') {
        document.body.classList.add('sidebar-pinned')
      }

      menuButton?.addEventListener('click', () => {
        if (window.matchMedia('(min-width: 901px)').matches) {
          const isPinned = document.body.classList.toggle('sidebar-pinned')
          localStorage.setItem('sc-sidebar-pinned', String(isPinned))
        } else {
          sidebar?.classList.toggle('open')
          overlay?.classList.toggle('open')
        }
      })

      overlay?.addEventListener('click', closeMenu)
      sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu))

      // Manejador global de tecla Escape para cerrar cualquier modal activo
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const openModals = document.querySelectorAll<HTMLElement>(
            'div[id$="-modal"], div[id*="modal"]'
          )

          openModals.forEach((modal) => {
            const isVisible =
              modal.style.display !== 'none' &&
              !modal.classList.contains('hidden') &&
              modal.offsetParent !== null

            if (isVisible) {
              // Buscar botón de cierre dentro del modal
              const closeBtn = modal.querySelector<HTMLElement>(
                'button[id^="close-"], button[aria-label="Cerrar modal"], button[aria-label="Cerrar"], .btn-close-modal'
              )
              if (closeBtn) {
                closeBtn.click()
              } else {
                modal.style.display = 'none'
                modal.classList.add('hidden')
              }
              document.body.style.overflow = ''
            }
          })
        }
      })
    </script>
  </body>
</html>
